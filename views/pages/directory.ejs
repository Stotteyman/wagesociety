<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <%- include('../partials/head-pwa') %>
  <title>WAGE Creators — W.A.G.E. Society</title>
  <meta name="description" content="Browse creator profiles on W.A.G.E. Society.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="stylesheet" href="/css/pages.css">
</head>
<body>
  <a href="#" class="skip-link">Skip to main content</a>
  <nav aria-label="Site navigation"><%- include('../partials/nav') %></nav>
  <main id="main-content" role="main">

  <section class="directory-page">
    <div class="directory-inner">

      <!-- Hero header -->
      <div class="directory-hero">
        <div class="directory-hero-text">
          <span class="section-label">Public Directory</span>
          <h1 class="section-title">WAGE Creators</h1>
          <p class="section-sub">Join the network of independent creators owning their audience and income.</p>
        </div>
        <div class="directory-hero-actions">
          <% if (userEmail) { %>
            <a href="/dashboard" class="wage-btn wage-btn-primary">Dashboard</a>
          <% } else { %>
            <a href="/join" class="wage-btn wage-btn-primary">Join W.A.G.E.</a>
          <% } %>
        </div>
      </div>

      <!-- Live creators carousel — shown if any creators are streaming -->
      <% const liveMembers = members.filter(function(m) { return m.is_live; }); %>
      <% if (liveMembers.length > 0) { %>
      <div class="now-live-section">
        <div class="section-heading">
          <span class="live-dot"></span>
          <h2 class="streams-section-title">Now Live <span class="section-count">(<%= liveMembers.length %>)</span></h2>
        </div>
        <div class="now-live-carousel">
          <% liveMembers.forEach(function(entry) { %>
            <% const showName = entry.display_name && entry.display_name.trim().length > 0; %>
            <a href="/creators/<%= entry.username %>" class="now-live-card wage-card">
              <div class="now-live-avatar-wrap">
                <% if (entry.avatar_url) { %>
                  <img src="<%= entry.avatar_url %>" alt="<%= showName ? entry.display_name : entry.username %>" class="now-live-avatar" />
                <% } else { %>
                  <div class="now-live-avatar-placeholder"><%= (showName ? entry.display_name : entry.username).charAt(0).toUpperCase() %></div>
                <% } %>
                <span class="now-live-indicator">● LIVE</span>
              </div>
              <div class="now-live-info">
                <span class="now-live-name"><%= showName ? entry.display_name : '@' + entry.username %></span>
                <% if (entry.primary_platform) { %>
                  <span class="now-live-platform"><%= entry.primary_platform %></span>
                <% } %>
              </div>
            </a>
          <% }) %>
        </div>
      </div>
      <% } %>

      <% if (total > 0) { %>
        <p class="directory-count"><%= total.toLocaleString() %> creator<%= total === 1 ? '' : 's' %></p>
      <% } %>

      <!-- Controls: search + tier filter + sort -->
      <div class="directory-controls">
        <form method="get" action="/creators" class="search-sort-row">
          <div class="search-bar">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input type="text" name="search" value="<%= search %>" placeholder="Search by name or username…" autocomplete="off" />
            <% if (sort !== 'recent') { %><input type="hidden" name="sort" value="<%= sort %>" /><% } %>
            <% if (page > 1) { %><input type="hidden" name="page" value="<%= page %>" /><% } %>
          </div>
          <button type="submit" class="wage-btn wage-btn-primary search-btn">Search</button>
        </form>

        <!-- Tier filter tabs -->
        <div class="tier-filter-tabs">
          <a href="/creators?sort=<%= sort %>&page=1" class="tier-filter-tab<%= !activeTier ? ' active' : '' %>">All</a>
          <a href="/creators?sort=<%= sort %>&tier=creator&page=1" class="tier-filter-tab<%= activeTier === 'creator' ? ' active' : '' %>">Creator</a>
          <a href="/creators?sort=<%= sort %>&tier=pro&page=1" class="tier-filter-tab<%= activeTier === 'pro' ? ' active' : '' %>">Pro</a>
          <a href="/creators?sort=<%= sort %>&tier=elite&page=1" class="tier-filter-tab<%= activeTier === 'elite' ? ' active' : '' %>">Elite</a>
        </div>

        <div class="sort-tabs">
          <a href="/creators?<%= activeTier ? 'tier=' + activeTier + '&' : '' %>sort=recent&search=<%= encodeURIComponent(search) %>&page=1"
             class="sort-tab<%= sort === 'recent' ? ' active' : '' %>">Recent</a>
          <a href="/creators?<%= activeTier ? 'tier=' + activeTier + '&' : '' %>sort=alpha&search=<%= encodeURIComponent(search) %>&page=1"
             class="sort-tab<%= sort === 'alpha' ? ' active' : '' %>">A–Z</a>
          <a href="/creators?<%= activeTier ? 'tier=' + activeTier + '&' : '' %>sort=tier&search=<%= encodeURIComponent(search) %>&page=1"
             class="sort-tab<%= sort === 'tier' ? ' active' : '' %>">By Tier</a>
        </div>
      </div>

      <% if (members.length === 0) { %>
        <% if (search) { %>
          <div class="empty-state">
            <p>No creators match "<%= search %>". <a href="/creators" style="color:var(--wage-gold);">Clear filter →</a></p>
          </div>
        <% } else { %>
          <div class="empty-state">
            <p>No creators found yet. <a href="/join" style="color:var(--wage-gold);">Be the first to join →</a></p>
          </div>
        <% } %>
      <% } else { %>

        <div class="member-cards-grid">
          <% members.forEach(function(entry, idx) { %>
            <% const showName = entry.display_name && entry.display_name.trim().length > 0; %>
            <% const tierColor = { elite: '#ffd700', pro: '#c084fc', creator: '#22d3ee', free: '#94a3b8' }[entry.membership_tier] || '#94a3b8'; %>
            <div class="member-card wage-card scroll-reveal" style="animation-delay: <%= (idx % 12) * 50 %>ms">
              <a href="/creators/<%= entry.username %>" class="member-card-avatar-link" aria-label="View <%= showName ? entry.display_name : entry.username %>'s profile">
                <div class="member-avatar-wrap">
                  <% if (entry.avatar_url) { %>
                    <img src="<%= entry.avatar_url %>" alt="<%= showName ? entry.display_name : entry.username %>" class="member-avatar-img" />
                  <% } else { %>
                    <div class="member-avatar-placeholder avatar-large">
                      <%= (showName ? entry.display_name : entry.username).charAt(0).toUpperCase() %>
                    </div>
                  <% } %>
                  <% if (entry.is_live) { %>
                    <span class="live-badge">LIVE</span>
                  <% } %>
                </div>
              </a>
              <div class="member-card-body">
                <div class="member-card-names">
                  <% if (showName) { %>
                    <span class="member-card-display-name"><%= entry.display_name %></span>
                  <% } %>
                  <span class="member-card-username">@<%= entry.username %></span>
                </div>
                <% if (entry.bio) { %>
                  <p class="member-card-bio"><%= entry.bio.length > 100 ? entry.bio.substring(0, 100) + '…' : entry.bio %></p>
                <% } %>
                <div class="member-card-footer">
                  <div class="member-card-badges">
                    <% if (entry.membership_tier && entry.membership_tier !== 'free') { %>
                      <span class="wage-badge" style="background:rgba(245,158,11,0.1);border-color:rgba(245,158,11,0.25);color:<%= tierColor %>;"><%= entry.membership_tier %></span>
                    <% } else { %>
                      <span class="wage-badge" style="background:rgba(148,163,184,0.1);border-color:rgba(148,163,184,0.2);color:#94a3b8;">free</span>
                    <% } %>
                    <% if (entry.referral_tier && entry.referral_tier !== 'bronze') { %>
                      <span class="tier-badge <%= entry.referral_tier %>"><%= entry.referral_tier %></span>
                    <% } %>
                  </div>
                  <a href="/creators/<%= entry.username %>" class="wage-btn wage-btn-subtle member-card-cta">View Profile</a>
                </div>
              </div>
            </div>
          <% }) %>
        </div>

        <% if (totalPages > 1) { %>
          <div class="pagination">
            <% if (page > 1) { %>
              <a href="/creators?<%= activeTier ? 'tier=' + activeTier + '&' : '' %>search=<%= encodeURIComponent(search) %>&sort=<%= sort %>&page=<%= page - 1 %>"
                 class="pagination-btn">← Previous</a>
            <% } %>

            <% for (let i = 1; i <= totalPages; i++) { %>
              <% if (i === 1 || i === totalPages || (i >= page - 1 && i <= page + 1)) { %>
                <a href="/creators?<%= activeTier ? 'tier=' + activeTier + '&' : '' %>search=<%= encodeURIComponent(search) %>&sort=<%= sort %>&page=<%= i %>"
                   class="pagination-btn<%= i === page ? ' active' : '' %>"><%= i %></a>
              <% } else if (i === page - 2 || i === page + 2) { %>
                <span class="pagination-ellipsis">…</span>
              <% } %>
            <% } %>

            <% if (page < totalPages) { %>
              <a href="/creators?<%= activeTier ? 'tier=' + activeTier + '&' : '' %>search=<%= encodeURIComponent(search) %>&sort=<%= sort %>&page=<%= page + 1 %>"
                 class="pagination-btn">Next →</a>
            <% } %>
          </div>
        <% } %>

      <% } %>

    </div>
  </section>

  <footer role="contentinfo"><%- include('../partials/footer') %></footer>
  </main>

  <style>
    /* Directory hero */
    .directory-hero {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 2rem;
      margin-bottom: 3rem;
    }
    .directory-hero-text { flex: 1; }
    .directory-hero-actions { flex-shrink: 0; }

    /* Now Live section */
    .now-live-section { margin-bottom: 2.5rem; }
    .now-live-carousel {
      display: flex;
      gap: 1rem;
      overflow-x: auto;
      padding-bottom: 0.5rem;
      scrollbar-width: thin;
      scrollbar-color: var(--wage-border) transparent;
    }
    .now-live-carousel::-webkit-scrollbar { height: 4px; }
    .now-live-carousel::-webkit-scrollbar-track { background: transparent; }
    .now-live-carousel::-webkit-scrollbar-thumb { background: var(--wage-border); border-radius: 4px; }
    .now-live-card {
      flex-shrink: 0;
      width: 140px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.75rem;
      padding: 1.25rem 1rem;
      text-decoration: none;
      color: var(--wage-text-primary);
    }
    .now-live-avatar-wrap {
      position: relative;
      width: 64px;
      height: 64px;
    }
    .now-live-avatar {
      width: 64px;
      height: 64px;
      border-radius: 50%;
      object-fit: cover;
      border: 2px solid var(--wage-gold);
    }
    .now-live-avatar-placeholder {
      width: 64px;
      height: 64px;
      border-radius: 50%;
      background: var(--wage-bg-primary);
      border: 2px solid var(--wage-gold);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--wage-gold);
    }
    .now-live-indicator {
      position: absolute;
      bottom: -4px;
      right: -4px;
      background: #dc2626;
      color: #fff;
      font-size: 0.6rem;
      font-weight: 800;
      letter-spacing: 0.05em;
      padding: 0.15rem 0.4rem;
      border-radius: 4px;
      animation: pulse-dot 1.5s ease-in-out infinite;
    }
    .now-live-info { text-align: center; }
    .now-live-name { font-size: 0.8rem; font-weight: 700; display: block; }
    .now-live-platform { font-size: 0.65rem; color: var(--wage-text-muted); text-transform: uppercase; letter-spacing: 0.1em; }

    /* Tier filter tabs */
    .tier-filter-tabs {
      display: flex;
      gap: 0.5rem;
    }
    .tier-filter-tab {
      padding: 0.45rem 1rem;
      border-radius: 100px;
      font-size: 0.8rem;
      font-weight: 600;
      text-decoration: none;
      border: 1px solid var(--wage-border);
      color: var(--wage-text-muted);
      background: transparent;
      transition: all 0.15s;
    }
    .tier-filter-tab:hover { border-color: var(--wage-gold); color: var(--wage-gold); background: rgba(245,158,11,0.08); }
    .tier-filter-tab.active { background: var(--wage-gold); border-color: var(--wage-gold); color: #fff; }

    /* Member card footer layout */
    .member-card-footer {
      margin-top: auto;
      padding-top: 1rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 0.5rem;
    }
    .member-card-badges { display: flex; gap: 0.35rem; flex-wrap: wrap; align-items: center; }
    .member-card-cta { padding: 0.35rem 0.75rem; font-size: 0.75rem; }

    /* Directory count */
    .directory-count { font-size: 0.85rem; color: var(--wage-text-muted); margin-bottom: 1.5rem; }

    /* Responsive */
    @media (max-width: 600px) {
      .directory-hero { flex-direction: column; gap: 1rem; }
      .tier-filter-tabs { flex-wrap: wrap; }
      .member-card-footer { flex-direction: column; align-items: flex-start; }
      .member-card-cta { width: 100%; justify-content: center; }
    }
  </style>

<script>(function(){
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  var els = document.querySelectorAll('.scroll-reveal');
  if (!els.length) return;
  var observer = new IntersectionObserver(function(s) {
    s.forEach(function(entry) {
      if (entry.isIntersecting) {
        var el = entry.target;
        var delay = parseInt(el.style.animationDelay, 10) || 0;
        setTimeout(function() { el.classList.add('revealed'); }, delay);
        observer.unobserve(el);
      }
    });
  }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
  els.forEach(function(el) { observer.observe(el); });
})();</script>
</body>
</html>