<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Creator Directory — W.A.G.E. Society</title>
  <meta name="description" content="Browse creator profiles on W.A.G.E. Society.">
  <meta property="og:title" content="Creator Directory — W.A.G.E. Society">
  <meta property="og:description" content="Browse all creators on W.A.G.E. Society.">
  <meta property="og:type" content="website">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="stylesheet" href="/css/pages.css">
  </head>
<body>
  <%- include('../partials/nav') %>

  <section class="directory-page">
    <div class="directory-inner">
      <div class="directory-header">
        <div>
          <span class="section-label">Public Directory</span>
          <h1 class="section-title">Creator Directory</h1>
          <p class="section-sub">Browse all signed-up members and visit their public profiles.</p>
        </div>
        <div class="directory-actions">
          <% if (userEmail) { %>
            <a href="/dashboard" class="btn-primary">Dashboard</a>
          <% } else { %>
            <a href="/join" class="btn-primary">Join W.A.G.E.</a>
          <% } %>
        </div>
      </div>

      <div class="search-bar">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="text" id="searchInput" placeholder="Search by name, username, bio, or skills..." />
      </div>

      <% if (entries.length === 0) { %>
        <div class="empty-state">
          <p>No members found yet. <a href="/join" style="color:var(--accent);">Be the first to join →</a></p>
        </div>
      <% } else { %>
        <div id="directoryList">
          <% entries.forEach(function(entry) { %>
          <div class="member-list-item" data-search="<%= (entry.username + ' ' + (entry.display_name || '') + ' ' + (entry.bio || '')).toLowerCase() %>">
            <div class="member-list-avatar">
              <% if (entry.avatar_url) { %>
                <img src="<%= entry.avatar_url %>" alt="<%= entry.display_name || entry.username %>" />
              <% } else { %>
                <div class="member-avatar-placeholder"><%= (entry.display_name || entry.username).charAt(0).toUpperCase() %></div>
              <% } %>
            </div>
            <div class="member-list-info">
              <div class="member-list-name"><%= entry.display_name || entry.username %></div>
              <div class="member-list-username">@<%= entry.username %></div>
              <% if (entry.bio) { %>
                <p class="member-list-bio"><%= entry.bio.length > 120 ? entry.bio.substring(0, 120) + '…' : entry.bio %></p>
              <% } else { %>
                <p class="member-list-bio">No bio available yet.</p>
              <% } %>
              <div class="member-list-connected">Connected Accounts: <%= (entry.youtube_url ? 1 : 0) + (entry.twitch_url ? 1 : 0) + (entry.kick_url ? 1 : 0) %></div>
            </div>
            <a href="/creators/<%= entry.username %>" class="btn-view member-list-profile-btn">View Profile</a>
          </div>
          <% }) %>
        </div>
      <% } %>
    </div>
  </section>

  <%- include('../partials/footer') %>
  <script>
    var lastQuery = '';
    var debounceTimer = null;
    function filterEntries() {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(function() {
        var q = document.getElementById('searchInput').value.toLowerCase().trim();
        document.querySelectorAll('.member-card').forEach(function(card) {
          card.style.display = card.dataset.search.includes(q) ? '' : 'none';
        });
        lastQuery = q;
      }, 150);
    }
    document.getElementById('searchInput').addEventListener('input', filterEntries);
    filterEntries();
  </script>
</body>
</html>