<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  

<%- include('../partials/head-pwa') %>
  <title>Welcome to W.A.G.E. Society!</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="stylesheet" href="/css/pages.css">
  <style>
    body { display: flex; align-items: center; justify-content: center; min-height: 100vh; }
    .checkout-success-page { padding: 4rem 2rem; text-align: center; max-width: 560px; margin: 0 auto; }
    .success-icon { font-size: 4rem; margin-bottom: 1.5rem; }
    .success-title { font-size: 2.2rem; font-weight: 800; margin-bottom: 0.75rem; letter-spacing: -0.03em; color: var(--fg); }
    .success-message { color: var(--muted); font-size: 1.05rem; line-height: 1.7; margin-bottom: 2rem; }
    .success-card {
      background: var(--surface);
      border: 1px solid var(--border-strong);
      border-radius: var(--radius-card);
      padding: 1.75rem 2rem;
      margin-bottom: 2rem;
      text-align: left;
    }
    .success-row { display: flex; justify-content: space-between; padding: 0.6rem 0; border-bottom: 1px solid var(--border); }
    .success-row:last-child { border-bottom: none; }
    .success-row-label { color: var(--muted); font-size: 0.875rem; }
    .success-row-value { font-weight: 600; }
    .success-row-value.accent { color: var(--accent); }
    .success-cta { display: flex; flex-direction: column; gap: 0.75rem; align-items: center; }
    .btn-dashboard { display: inline-flex; align-items: center; gap: 0.5rem; background: var(--accent); color: #fff; padding: 0.75rem 1.75rem; border-radius: var(--radius-btn); font-weight: 700; text-decoration: none; font-size: 0.9rem; transition: all 0.2s; }
    .btn-dashboard:hover { background: var(--accent-hover); box-shadow: 0 4px 16px rgba(255,102,0,0.25); }
    .btn-home { color: var(--muted); font-size: 0.85rem; text-decoration: none; margin-top: 0.25rem; }
    .btn-home:hover { color: var(--fg); }
    .login-prompt {
      background: rgba(255,102,0,0.08);
      border: 1px solid rgba(255,102,0,0.25);
      border-radius: var(--radius-card);
      padding: 1.25rem 1.5rem;
      margin-bottom: 1.5rem;
      text-align: left;
    }
    .login-prompt p { color: var(--fg); font-size: 0.9rem; margin-bottom: 0.75rem; }
    .login-prompt .btn-login { display: inline-block; background: var(--accent); color: #fff; padding: 0.6rem 1.25rem; border-radius: 8px; font-weight: 600; font-size: 0.875rem; text-decoration: none; }
    .login-prompt .btn-login:hover { background: var(--accent-hover); }
    .login-prompt .btn-register { display: inline-block; margin-left: 0.75rem; color: var(--muted); font-size: 0.875rem; text-decoration: none; }
    .login-prompt .btn-register:hover { color: var(--fg); }
  </style>
</head>
<body>
  <div class="checkout-success-page">
    <div class="success-icon">🎉</div>
    <h1 class="success-title">Welcome<%= memberName ? ', ' + memberName : ' to W.A.G.E. Society' %>!</h1>
    <% if (showSuccess) { %>
    <p class="success-message">
      <% if (tier) { %>
        Your <strong><%= tierName %></strong> membership is now active. You've joined a movement of creators who refuse to share revenue with platform middlemen.
      <% } else { %>
        Your payment was processed successfully. Welcome to the W.A.G.E. Society community!
      <% } %>
    </p>
    <% } else { %>
    <p class="success-message">
      Your payment was processed. Your membership details are shown below.
    </p>
    <% } %>

    <% if (!userEmail) { %>
      <div class="login-prompt">
        <p><strong>Create your WAGE account</strong> to access your new membership and start building.</p>
        <a href="/login" class="btn-login">Log In</a>
        <a href="/join" class="btn-register">Create Account</a>
      </div>
    <% } %>

    <% if (tier) { %>
    <div class="success-card">
      <div class="success-row">
        <span class="success-row-label">Membership</span>
        <span class="success-row-value accent"><%= tierName %></span>
      </div>
      <% if (billingCycle) { %>
      <div class="success-row">
        <span class="success-row-label">Billing</span>
        <span class="success-row-value"><%= billingCycle === 'annual' ? 'Annual' : 'Monthly' %></span>
      </div>
      <% } %>
      <div class="success-row">
        <span class="success-row-label">Status</span>
        <span class="success-row-value accent">Active ✓</span>
      </div>
    </div>
    <% } %>

    <div class="success-cta">
      <a href="<%= userEmail ? '/dashboard' : '/dashboard' %>" class="btn-dashboard">
        <%= userEmail ? 'Go to Dashboard' : 'Explore WAGE Society' %> →
      </a>
      <a href="/" class="btn-home">← Back to home</a>
    </div>
  </div>
</body>
</html>