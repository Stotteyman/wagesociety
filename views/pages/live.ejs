<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  

<%- include('../partials/head-pwa') %>
  <title>Live Streams — W.A.G.E. Society</title>
  <meta name="description" content="Watch W.A.G.E. Society creators go live. Discover live and recent streams from the community across YouTube, Kick, and Twitch.">
  <meta property="og:type" content="website">
  <meta property="og:title" content="Live Streams — W.A.G.E. Society">
  <meta property="og:description" content="Watch W.A.G.E. Society creators go live. Discover live and recent streams from the community.">
  <meta property="og:image" content="https://pub-629428d185ca4960a0a73c850d32294b.r2.dev/generated-images/company_142957/eb47d638-137a-4907-b6c0-3bf099c5be80.jpg">
  <meta property="og:url" content="https://wagesociety.com/streams">
  <meta property="og:site_name" content="WAGE Society">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Live Streams — W.A.G.E. Society">
  <meta name="twitter:description" content="Watch W.A.G.E. Society creators go live. Discover live and recent streams from the community.">
  <meta name="twitter:image" content="https://pub-629428d185ca4960a0a73c850d32294b.r2.dev/generated-images/company_142957/eb47d638-137a-4907-b6c0-3bf099c5be80.jpg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="stylesheet" href="/css/pages.css">
</head>
<body>
  <%- include('../partials/nav') %>

  <section class="streams-page">
    <div class="streams-inner">

      <!-- ── Page header ── -->
      <div class="page-header">
        <span class="section-label">W.A.G.E. Streams</span>
        <h1 class="section-title">Live Streams</h1>
        <p class="section-sub">
          Creators connected via YouTube, Kick, and Twitch — all in one place.
        </p>
      </div>

      <!-- ── LIVE NOW section ── -->
      <% if (liveStreams && liveStreams.length > 0) { %>
      <div class="streams-section">
        <div class="section-heading">
          <span class="live-dot"></span>
          <h2 class="streams-section-title">Live Now</h2>
        </div>

        <div class="streams-grid streams-grid--live">
          <% liveStreams.forEach(function(stream) { %>
          <a href="<%= stream.stream_url %>" target="_blank" rel="noopener"
             class="stream-card stream-card--live">
            <!-- Thumbnail -->
            <div class="stream-thumb">
              <% if (stream.stream_thumbnail) { %>
                <img src="<%= stream.stream_thumbnail %>" alt="<%= stream.channel_name %> thumbnail"
                     class="stream-thumb-img" loading="lazy">
              <% } else { %>
                <div class="stream-thumb-placeholder">
                  <!-- Platform icon placeholder -->
                  <span class="stream-thumb-platform"><%= stream.platform %></span>
                </div>
              <% } %>
              <!-- Live badge -->
              <div class="stream-live-badge">
                <span class="live-badge-dot"></span>
                LIVE
              </div>
              <!-- Viewer count -->
              <% if (stream.viewer_count > 0) { %>
              <div class="stream-viewer-count">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>
                </svg>
                <%= new Intl.NumberFormat().format(stream.viewer_count) %>
              </div>
              <% } %>
            </div>

            <!-- Card body -->
            <div class="stream-card-body">
              <!-- Platform + creator -->
              <div class="stream-meta-row">
                <span class="stream-platform-badge stream-platform--<%= stream.platform %>">
                  <% if (stream.platform === 'youtube') { %>
                    <svg width="14" height="10" viewBox="0 0 24 18" fill="currentColor"><path d="M23.5 3.8s-.2-1.4-1-2c-.9-.7-1.9-.7-2.4-.7C16.3 1 12 1 12 1s-4.3 0-8.1.1c-.5 0-1.5 0-2.4.7-.8.6-1 2-1 2S0 5.4 0 7.6v3.8c0 2.1.5 3.8.5 3.8s.2 1.4 1 2c.9.7 2.1.7 2.6.8C7.7 18 12 18 12 18s4.3 0 8.1-.1c.5 0 1.5 0 2.4-.7.8-.6 1-2 1-2s.5-2.3.5-4.4V7.6c0-2.2-.5-3.8-.5-3.8zM9.6 11.5V6.5l6.2 2.5-6.2 2.5z"/></svg>
                  <% } else if (stream.platform === 'kick') { %>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M9.32 2.18L7.6 4.94c-.43.69-.65 1.48-.65 2.31V11c0 1.93.33 3.81.96 5.54l.51 1.42c.12.34.44.58.8.58h2.66c.36 0 .68-.24.8-.58l.51-1.42c.63-1.73.96-3.61.96-5.54V7.25c0-.83-.22-1.62-.65-2.31L13.36 2.18c-.17-.26-.5-.43-.86-.43H10.2c-.36 0-.69.17-.86.43H9.32z"/></svg>
                  <% } else if (stream.platform === 'twitch') { %>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M11.57 3.14L6.24 8.45v13.11h3.33V11.8h2.22l3.33-3.11h3.33l4.44-4.44V3.14H11.57zm-3.33 7.78v8.33h-2.5V10.92h2.5zm5.55 0v8.33h-2.22V10.92h2.22z"/></svg>
                  <% } %>
                  <%= stream.platform.charAt(0).toUpperCase() + stream.platform.slice(1) %>
                </span>
                <% if (stream.creator_name) { %>
                <div class="stream-creator">
                  <% if (stream.creator_avatar) { %>
                  <img src="<%= stream.creator_avatar %>" alt="<%= stream.creator_name %>"
                       class="stream-creator-avatar">
                  <% } %>
                  <span class="stream-creator-name"><%= stream.creator_name %></span>
                </div>
                <% } %>
              </div>

              <!-- Title -->
              <h3 class="stream-title"><%= stream.stream_title || stream.channel_name || 'Untitled Stream' %></h3>

              <!-- Channel name if no title -->
              <% if (stream.stream_title && stream.channel_name && stream.channel_name !== stream.stream_title) { %>
              <p class="stream-channel-name"><%= stream.channel_name %></p>
              <% } %>

              <!-- Watch button -->
              <span class="stream-watch-btn">
                Watch Now
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <polygon points="5 3 19 12 5 21 5 3"/>
                </svg>
              </span>
            </div>
          </a>
          <% }) %>
        </div>
      </div>
      <% } %>

      <!-- ── RECENT STREAMS section ── -->
      <% if (recentStreams && recentStreams.length > 0) { %>
      <div class="streams-section">
        <div class="section-heading">
          <h2 class="streams-section-title">Recent Streams</h2>
          <span class="section-count">Last 7 days</span>
        </div>

        <div class="streams-grid">
          <% recentStreams.forEach(function(stream) { %>
          <a href="<%= stream.stream_url %>" target="_blank" rel="noopener"
             class="stream-card stream-card--recent">
            <!-- Thumbnail -->
            <div class="stream-thumb">
              <% if (stream.stream_thumbnail) { %>
                <img src="<%= stream.stream_thumbnail %>" alt="<%= stream.channel_name %> thumbnail"
                     class="stream-thumb-img" loading="lazy">
              <% } else { %>
                <div class="stream-thumb-placeholder">
                  <span class="stream-thumb-platform"><%= stream.platform %></span>
                </div>
              <% } %>
              <!-- Recent badge -->
              <% if (stream.ended_at) { %>
              <div class="stream-ended-label">Ended <%= new Date(stream.ended_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %></div>
              <% } %>
            </div>

            <!-- Card body -->
            <div class="stream-card-body">
              <!-- Platform + creator -->
              <div class="stream-meta-row">
                <span class="stream-platform-badge stream-platform--<%= stream.platform %>">
                  <% if (stream.platform === 'youtube') { %>
                    <svg width="14" height="10" viewBox="0 0 24 18" fill="currentColor"><path d="M23.5 3.8s-.2-1.4-1-2c-.9-.7-1.9-.7-2.4-.7C16.3 1 12 1 12 1s-4.3 0-8.1.1c-.5 0-1.5 0-2.4.7-.8.6-1 2-1 2S0 5.4 0 7.6v3.8c0 2.1.5 3.8.5 3.8s.2 1.4 1 2c.9.7 2.1.7 2.6.8C7.7 18 12 18 12 18s4.3 0 8.1-.1c.5 0 1.5 0 2.4-.7.8-.6 1-2 1-2s.5-2.3.5-4.4V7.6c0-2.2-.5-3.8-.5-3.8zM9.6 11.5V6.5l6.2 2.5-6.2 2.5z"/></svg>
                  <% } else if (stream.platform === 'kick') { %>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M9.32 2.18L7.6 4.94c-.43.69-.65 1.48-.65 2.31V11c0 1.93.33 3.81.96 5.54l.51 1.42c.12.34.44.58.8.58h2.66c.36 0 .68-.24.8-.58l.51-1.42c.63-1.73.96-3.61.96-5.54V7.25c0-.83-.22-1.62-.65-2.31L13.36 2.18c-.17-.26-.5-.43-.86-.43H10.2c-.36 0-.69.17-.86.43H9.32z"/></svg>
                  <% } else if (stream.platform === 'twitch') { %>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M11.57 3.14L6.24 8.45v13.11h3.33V11.8h2.22l3.33-3.11h3.33l4.44-4.44V3.14H11.57zm-3.33 7.78v8.33h-2.5V10.92h2.5zm5.55 0v8.33h-2.22V10.92h2.22z"/></svg>
                  <% } %>
                  <%= stream.platform.charAt(0).toUpperCase() + stream.platform.slice(1) %>
                </span>
                <% if (stream.creator_name) { %>
                <div class="stream-creator">
                  <% if (stream.creator_avatar) { %>
                  <img src="<%= stream.creator_avatar %>" alt="<%= stream.creator_name %>"
                       class="stream-creator-avatar">
                  <% } %>
                  <span class="stream-creator-name"><%= stream.creator_name %></span>
                </div>
                <% } %>
              </div>

              <h3 class="stream-title"><%= stream.stream_title || stream.channel_name || 'Untitled Stream' %></h3>

              <!-- VOD / replay -->
              <span class="stream-watch-btn stream-watch-btn--replay">
                View VOD
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/>
                  <polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/>
                </svg>
              </span>
            </div>
          </a>
          <% }) %>
        </div>
      </div>
      <% } %>

      <!-- ── Empty state ── -->
      <% if ((!liveStreams || liveStreams.length === 0) && (!recentStreams || recentStreams.length === 0)) { %>
      <div class="streams-empty-state">
        <div class="streams-empty-icon">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <rect x="2" y="7" width="20" height="15" rx="2"/><polygon points="10 12 16 14.5 10 17"/><line x1="8" y1="12" x2="8" y2="12.01" stroke-width="2.5"/>
          </svg>
        </div>
        <h3 class="streams-empty-title">No streams yet</h3>
        <p class="streams-empty-body">
          Connect your YouTube, Kick, or Twitch account in
          <a href="/settings" class="streams-empty-link">Settings</a>
          to get featured here.
        </p>
      </div>
      <% } %>

    </div>
  </section>

  <%- include('../partials/footer') %>
</body>
</html>