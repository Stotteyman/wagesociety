<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  

<%- include('../partials/head-pwa') %>
  <title>Security — W.A.G.E. Society</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="stylesheet" href="/css/pages.css">
</head>
<body>
<%- include('../partials/nav') %>

<section class="dashboard-page">
  <div class="dashboard-inner" style="max-width:580px;">

    <% if (forceChange) { %>
    <div style="background:#7c2d12;border:1px solid #ea580c;border-radius:8px;padding:1rem 1.25rem;margin-bottom:1.5rem;font-size:0.9rem;color:#fed7aa;">
      You must change your password before continuing.
    </div>
    <% } %>

    <% if (error) { %>
    <div class="error-msg" style="margin-bottom:1.25rem;"><%= error %></div>
    <% } %>

    <% if (success) { %>
    <div style="background:#14532d;border:1px solid #22c55e;border-radius:8px;padding:0.875rem 1.25rem;margin-bottom:1.25rem;font-size:0.9rem;color:#bbf7d0;">
      Password updated successfully.
    </div>
    <% } %>

    <div class="dash-card">
      <h2 class="dash-card-title" style="margin-bottom:0.5rem;">&#x1F511; Change Password</h2>
      <p style="color:var(--muted);font-size:0.88rem;margin-bottom:1.5rem;">Use at least 8 characters. Your current password is required to set a new one.</p>

      <form method="POST" action="/settings/security" onsubmit="return validateForm()">
        <% if (hasPassword) { %>
        <div style="margin-bottom:1rem;">
          <label style="font-size:0.85rem;font-weight:600;display:block;margin-bottom:0.4rem;">Current Password</label>
          <input type="password" name="currentPassword" id="currentPassword" class="auth-input"
            placeholder="Enter your current password" required style="width:100%;">
        </div>
        <% } else { %>
        <input type="hidden" name="currentPassword" value="">
        <div style="background:#1c1917;border:1px solid #292524;border-radius:6px;padding:0.75rem 1rem;margin-bottom:1rem;font-size:0.85rem;color:#a8a29e;">
          No password set yet — you are creating one from scratch.
        </div>
        <% } %>

        <div style="margin-bottom:1rem;">
          <label style="font-size:0.85rem;font-weight:600;display:block;margin-bottom:0.4rem;">New Password</label>
          <input type="password" name="newPassword" id="newPassword" class="auth-input"
            placeholder="At least 8 characters" required minlength="8" style="width:100%;">
        </div>

        <div style="margin-bottom:1.5rem;">
          <label style="font-size:0.85rem;font-weight:600;display:block;margin-bottom:0.4rem;">Confirm New Password</label>
          <input type="password" name="confirmPassword" id="confirmPassword" class="auth-input"
            placeholder="Repeat new password" required style="width:100%;">
          <div id="matchWarn" style="font-size:0.8rem;color:#ef4444;margin-top:0.3rem;display:none;">
            Passwords do not match
          </div>
        </div>

        <button type="submit" class="btn-primary" style="width:100%;">Update Password</button>
      </form>
    </div>

    <div class="dash-card" style="margin-top:1.25rem;">
      <h3 class="dash-card-title" style="margin-bottom:0.75rem;">Active Sessions</h3>
      <p style="color:var(--muted);font-size:0.88rem;margin-bottom:1rem;">Your session is managed server-side. Signing out will end your current session immediately.</p>
      <form method="POST" action="/logout" onsubmit="return confirm('End your current session?');">
        <button type="submit" class="btn-secondary" style="background:transparent;border:1px solid #52525b;color:#a1a1aa;padding:0.5rem 1.25rem;border-radius:6px;cursor:pointer;">Sign Out</button>
      </form>
    </div>

  </div>
</section>

<script>
function validateForm() {
  var np = document.getElementById('newPassword');
  var cp = document.getElementById('confirmPassword');
  var warn = document.getElementById('matchWarn');
  if (np && cp && warn && np.value !== cp.value) {
    warn.style.display = 'block';
    cp.focus();
    return false;
  }
  if (warn) warn.style.display = 'none';
  return true;
}
var cpEl = document.getElementById('confirmPassword');
var npEl = document.getElementById('newPassword');
var warnEl = document.getElementById('matchWarn');
if (cpEl && npEl && warnEl) {
  cpEl.addEventListener('input', function() {
    warnEl.style.display = (this.value && this.value !== npEl.value) ? 'block' : 'none';
  });
}
</script>
</body>
</html>
