<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit Profile — W.A.G.E. Society</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400;1,700&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="stylesheet" href="/css/pages.css">
  <style>
    .edit-page { max-width: 680px; margin: 0 auto; padding: 3rem 1.5rem; }
    .edit-header { margin-bottom: 2.5rem; }
    .edit-header h1 { font-family: 'Playfair Display', serif; font-size: 2rem; font-weight: 900; color: var(--fg); }
    .edit-header p { color: var(--muted); font-size: 0.95rem; margin-top: 0.5rem; }
    .edit-avatar-preview {
      width: 80px; height: 80px; border-radius: 50%; overflow: hidden;
      background: var(--surface); border: 2px solid var(--border);
      display: flex; align-items: center; justify-content: center;
      margin-bottom: 0.75rem;
    }
    .edit-avatar-preview img { width: 100%; height: 100%; object-fit: cover; }
    .edit-avatar-preview .initials { font-size: 1.75rem; font-weight: 700; color: var(--accent); }
    .form-group { margin-bottom: 1.5rem; }
    .form-label { display: block; font-size: 0.8rem; font-weight: 600; color: var(--muted); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.5rem; }
    .form-input, .form-textarea { width: 100%; background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 0.75rem 1rem; font-family: 'DM Sans', sans-serif; font-size: 0.95rem; color: var(--fg); box-sizing: border-box; }
    .form-input:focus, .form-textarea:focus { outline: none; border-color: var(--accent); }
    .form-textarea { resize: vertical; min-height: 100px; }
    .form-hint { font-size: 0.75rem; color: var(--muted); margin-top: 0.4rem; }
    .form-actions { display: flex; gap: 1rem; align-items: center; margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--border); }
    .btn-save { background: var(--accent); color: #fff; border: none; padding: 0.75rem 2rem; border-radius: 8px; font-family: 'DM Sans', sans-serif; font-size: 0.9rem; font-weight: 600; cursor: pointer; transition: opacity 0.2s; }
    .btn-save:hover { opacity: 0.85; }
    .btn-save:disabled { opacity: 0.5; cursor: not-allowed; }
    .btn-cancel { color: var(--muted); text-decoration: none; font-size: 0.9rem; }
    .btn-cancel:hover { color: var(--fg); }
    .form-error { color: #dc2626; font-size: 0.85rem; margin-top: 0.5rem; display: none; }
    .form-success { color: #16a34a; font-size: 0.85rem; margin-top: 0.5rem; display: none; }
    .social-row { display: grid; grid-template-columns: 120px 1fr; gap: 0.75rem; align-items: center; margin-bottom: 0.75rem; }
    .social-platform { font-size: 0.85rem; font-weight: 600; color: var(--muted); }
    .social-hint { font-size: 0.7rem; color: var(--muted); margin-top: 0.25rem; }

    /* Discord connect card */
    .discord-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 1.25rem 1.5rem;
      margin-bottom: 2rem;
    }
    .discord-card-header {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      margin-bottom: 1rem;
    }
    .discord-card-header .discord-icon {
      width: 24px; height: 24px;
      fill: #5865F2;
      flex-shrink: 0;
    }
    .discord-card-header h3 {
      font-size: 0.95rem;
      font-weight: 700;
      color: var(--fg);
      margin: 0;
    }
    .discord-linked-info {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }
    .discord-avatar {
      width: 40px; height: 40px;
      border-radius: 50%;
      object-fit: cover;
      background: var(--border);
    }
    .discord-avatar-placeholder {
      width: 40px; height: 40px;
      border-radius: 50%;
      background: #5865F2;
      display: flex; align-items: center; justify-content: center;
      font-weight: 700; font-size: 1rem; color: #fff;
      flex-shrink: 0;
    }
    .discord-linked-text .discord-username {
      font-weight: 600;
      color: var(--fg);
      font-size: 0.9rem;
    }
    .discord-linked-text .discord-date {
      font-size: 0.75rem;
      color: var(--muted);
      margin-top: 0.1rem;
    }
    .discord-actions { margin-top: 0.9rem; }
    .btn-discord-connect {
      display: inline-flex; align-items: center; gap: 0.5rem;
      background: #5865F2; color: #fff; border: none;
      padding: 0.65rem 1.4rem; border-radius: 8px;
      font-family: 'DM Sans', sans-serif; font-size: 0.875rem;
      font-weight: 600; cursor: pointer; text-decoration: none;
      transition: opacity 0.2s;
    }
    .btn-discord-connect:hover { opacity: 0.85; }
    .btn-discord-unlink {
      background: none; border: 1px solid var(--border);
      color: var(--muted); padding: 0.45rem 1rem;
      border-radius: 6px; font-size: 0.8rem; cursor: pointer;
      font-family: 'DM Sans', sans-serif; transition: color 0.15s, border-color 0.15s;
    }
    .btn-discord-unlink:hover { color: #dc2626; border-color: #dc2626; }

    /* Flash banners */
    .flash-banner {
      padding: 0.8rem 1.2rem;
      border-radius: 8px;
      font-size: 0.875rem;
      font-weight: 500;
      margin-bottom: 1.5rem;
    }
    .flash-success { background: #dcfce7; color: #166534; border: 1px solid #bbf7d0; }
    .flash-info    { background: #fef3c7; color: #92400e; border: 1px solid #fde68a; }
  </style>
</head>
<body>
  <%- include('../partials/nav') %>

  <main class="edit-page">
    <div class="edit-header">
      <h1>Edit Profile</h1>
      <p>Update your public creator profile. Changes appear on your public page immediately.</p>
    </div>

    <%# Flash banners for Discord link/unlink results %>
    <% if (discordFlash === 'linked') { %>
      <div class="flash-banner flash-success">✓ Discord account connected successfully.</div>
    <% } else if (discordFlash === 'unlinked') { %>
      <div class="flash-banner flash-info">Discord account unlinked.</div>
    <% } else if (discordFlash === 'denied') { %>
      <div class="flash-banner flash-info">Discord authorization was cancelled.</div>
    <% } else if (discordFlash === 'error') { %>
      <div class="flash-banner" style="background:#fee2e2;color:#991b1b;border:1px solid #fecaca;">Something went wrong connecting Discord. Try again.</div>
    <% } %>

    <%# Discord connect card %>
    <div class="discord-card">
      <div class="discord-card-header">
        <svg class="discord-icon" viewBox="0 0 127.14 96.36" xmlns="http://www.w3.org/2000/svg">
          <path d="M107.7 8.07A105.15 105.15 0 0 0 81.47 0a72.06 72.06 0 0 0-3.36 6.83 97.68 97.68 0 0 0-29.11 0A72.37 72.37 0 0 0 45.64 0a105.89 105.89 0 0 0-26.25 8.09C2.79 32.65-1.71 56.6.54 80.21a105.73 105.73 0 0 0 32.17 16.15 77.7 77.7 0 0 0 6.89-11.11 68.42 68.42 0 0 1-10.85-5.18c.91-.66 1.8-1.34 2.66-2a75.57 75.57 0 0 0 64.32 0c.87.71 1.76 1.39 2.66 2a68.68 68.68 0 0 1-10.87 5.19 77 77 0 0 0 6.89 11.1 105.25 105.25 0 0 0 32.19-16.14c2.64-27.38-4.51-51.11-18.9-72.14zM42.45 65.69C36.18 65.69 31 60 31 53s5-12.74 11.43-12.74S54 46 53.89 53s-5.12 12.69-11.44 12.69zm42.24 0C78.41 65.69 73.25 60 73.25 53s5-12.74 11.44-12.74S96.23 46 96.12 53s-5.12 12.69-11.43 12.69z"/>
        </svg>
        <h3>Discord</h3>
      </div>

      <% if (discordLink) { %>
        <div class="discord-linked-info">
          <% if (discordLink.discord_avatar) { %>
            <img class="discord-avatar" src="<%= discordLink.discord_avatar %>" alt="Discord avatar" />
          <% } else { %>
            <div class="discord-avatar-placeholder"><%= discordLink.discord_username.charAt(0).toUpperCase() %></div>
          <% } %>
          <div class="discord-linked-text">
            <div class="discord-username">@<%= discordLink.discord_username %></div>
            <div class="discord-date">Linked on <%= new Date(discordLink.linked_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></div>
          </div>
        </div>
        <%# Role sync status badge %>
        <% if (discordLink.last_synced_at) { %>
          <div style="margin-top:0.75rem;display:flex;align-items:center;gap:0.5rem;">
            <span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:#22c55e;flex-shrink:0;"></span>
            <span style="font-size:0.8rem;color:var(--muted);">
              <strong style="color:var(--fg);text-transform:uppercase;font-size:0.75rem;letter-spacing:0.04em;"><%= currentTier %></strong>
              role active in WAGE Society server &nbsp;·&nbsp;
              Synced <%= new Date(discordLink.last_synced_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %>
            </span>
          </div>
        <% } else { %>
          <div style="margin-top:0.75rem;display:flex;align-items:center;gap:0.5rem;">
            <span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:#f97316;flex-shrink:0;"></span>
            <span style="font-size:0.8rem;color:var(--muted);">Role sync pending — could not assign role. Try unlinking and reconnecting.</span>
          </div>
        <% } %>
        <div class="discord-actions">
          <form method="POST" action="/auth/discord/unlink" style="display:inline;">
            <button type="submit" class="btn-discord-unlink">Unlink</button>
          </form>
        </div>
      <% } else { %>
        <p style="color:var(--muted);font-size:0.875rem;margin:0 0 1rem;">Connect your Discord account to verify your membership and get roles in the server.</p>
        <a href="/auth/discord/link" class="btn-discord-connect">
          <svg width="18" height="18" viewBox="0 0 127.14 96.36" xmlns="http://www.w3.org/2000/svg" style="fill:#fff;flex-shrink:0;">
            <path d="M107.7 8.07A105.15 105.15 0 0 0 81.47 0a72.06 72.06 0 0 0-3.36 6.83 97.68 97.68 0 0 0-29.11 0A72.37 72.37 0 0 0 45.64 0a105.89 105.89 0 0 0-26.25 8.09C2.79 32.65-1.71 56.6.54 80.21a105.73 105.73 0 0 0 32.17 16.15 77.7 77.7 0 0 0 6.89-11.11 68.42 68.42 0 0 1-10.85-5.18c.91-.66 1.8-1.34 2.66-2a75.57 75.57 0 0 0 64.32 0c.87.71 1.76 1.39 2.66 2a68.68 68.68 0 0 1-10.87 5.19 77 77 0 0 0 6.89 11.1 105.25 105.25 0 0 0 32.19-16.14c2.64-27.38-4.51-51.11-18.9-72.14zM42.45 65.69C36.18 65.69 31 60 31 53s5-12.74 11.43-12.74S54 46 53.89 53s-5.12 12.69-11.44 12.69zm42.24 0C78.41 65.69 73.25 60 73.25 53s5-12.74 11.44-12.74S96.23 46 96.12 53s-5.12 12.69-11.43 12.69z"/>
          </svg>
          Connect Discord
        </a>
      <% } %>
    </div>

    <form id="profileForm" onsubmit="return false;">
      <div class="form-group">
        <label class="form-label">Avatar URL</label>
        <input type="url" class="form-input" id="avatar_url" value="<%= profile.avatar_url || '' %>" placeholder="https://..." />
        <p class="form-hint">Paste a direct image URL. Square images look best.</p>
        <div class="edit-avatar-preview" id="avatarPreview">
          <% if (profile.avatar_url) { %>
            <img src="<%= profile.avatar_url %>" alt="Avatar preview" />
          <% } else { %>
            <span class="initials"><%= (profile.display_name || profile.username || 'U').charAt(0).toUpperCase() %></span>
          <% } %>
        </div>
      </div>

      <div class="form-group">
        <label class="form-label">Display Name</label>
        <input type="text" class="form-input" id="display_name" value="<%= profile.display_name || '' %>" placeholder="Your public name" maxlength="80" />
      </div>

      <div class="form-group">
        <label class="form-label">Bio</label>
        <textarea class="form-textarea" id="bio" placeholder="Tell the community who you are and what you create..." maxlength="500"><%= profile.bio || '' %></textarea>
        <p class="form-hint"><span id="bioCount">0</span>/500 characters</p>
      </div>

      <div class="form-group">
        <label class="form-label">Skills / Specialties</label>
        <input type="text" class="form-input" id="skills" value="<%= profile.skills || '' %>" placeholder="e.g. Video Editing, Content Strategy, Podcasting" />
        <p class="form-hint">Comma-separated list of your skills and specialties.</p>
      </div>

      <div class="form-group">
        <label class="form-label">Social Links</label>
        <div class="social-row">
          <span class="social-platform">YouTube</span>
          <input type="url" class="form-input" id="social_youtube" placeholder="https://youtube.com/@yourchannel" />
        </div>
        <div class="social-row">
          <span class="social-platform">Twitch</span>
          <input type="url" class="form-input" id="social_twitch" placeholder="https://twitch.tv/yourchannel" />
        </div>
        <div class="social-row">
          <span class="social-platform">Kick</span>
          <input type="url" class="form-input" id="social_kick" placeholder="https://kick.com/yourchannel" />
        </div>
        <div class="social-row">
          <span class="social-platform">Website</span>
          <input type="url" class="form-input" id="social_website" placeholder="https://yoursite.com" />
        </div>
        <p class="form-hint">Social links are managed via the <a href="/live" style="color:var(--accent);">Live page</a> — connect YouTube, Twitch, or Kick there.</p>
      </div>

      <div class="form-actions">
        <button type="button" class="btn-save" id="saveBtn" onclick="saveProfile()">Save Changes</button>
        <a href="/creators/<%= profile.username || '' %>" class="btn-cancel">Cancel</a>
        <span class="form-success" id="successMsg">✓ Saved!</span>
        <span class="form-error" id="errorMsg"></span>
      </div>
    </form>
  </main>

  <%- include('../partials/footer') %>

  <script>
    // Bio character counter
    const bioEl = document.getElementById('bio');
    const bioCount = document.getElementById('bioCount');
    bioEl.addEventListener('input', () => { bioCount.textContent = bioEl.value.length; });
    bioCount.textContent = bioEl.value.length;

    // Avatar URL preview
    const avatarUrlEl = document.getElementById('avatar_url');
    const avatarPreview = document.getElementById('avatarPreview');
    avatarUrlEl.addEventListener('input', () => {
      const url = avatarUrlEl.value.trim();
      if (url) {
        avatarPreview.innerHTML = '<img src="' + url + '" alt="Avatar preview" onerror="this.parentElement.innerHTML=\\\\'<span class=\\\"initials\\\">?</span>\\\\'"/>';
      } else {
        avatarPreview.innerHTML = '<span class="initials"><%= (profile.display_name || profile.username || "U").charAt(0).toUpperCase() %></span>';
      }
    });

    async function saveProfile() {
      const btn = document.getElementById('saveBtn');
      const errEl = document.getElementById('errorMsg');
      const okEl = document.getElementById('successMsg');
      errEl.style.display = 'none';
      okEl.style.display = 'none';
      btn.disabled = true;
      btn.textContent = 'Saving...';

      try {
        const res = await fetch('/api/me/profile', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            username: '<%= profile.username || "" %>',
            display_name: document.getElementById('display_name').value,
            bio: document.getElementById('bio').value,
            avatar_url: document.getElementById('avatar_url').value,
            skills: document.getElementById('skills').value,
          })
        });

        if (!res.ok) {
          const data = await res.json();
          throw new Error(data.error || 'Save failed');
        }

        okEl.style.display = 'inline';
        setTimeout(() => { okEl.style.display = 'none'; }, 4000);
      } catch (e) {
        errEl.textContent = e.message;
        errEl.style.display = 'inline';
      } finally {
        btn.disabled = false;
        btn.textContent = 'Save Changes';
      }
    }
  </script>
</body>
</html>