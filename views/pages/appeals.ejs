  <meta property="og:url" content="https://wagesociety.com/appeals">
  <meta property="og:site_name" content="WAGE Society">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Appeals — W.A.G.E. Society">
