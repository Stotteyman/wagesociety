  <title>Appeals — W.A.G.E. Society</title>
  <meta name="description" content="Submit an appeal if your W.A.G.E. Society account has been restricted. We review all cases within 3–5 business days.">
  <meta property="og:type" content="website">
  <meta property="og:title" content="Appeals — W.A.G.E. Society">
  <meta property="og:description" content="Submit an appeal if your W.A.G.E. Society account has been restricted. We review all cases within 3–5 business days.">
