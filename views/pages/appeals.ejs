</head>
<body>
<%- include('../partials/nav') %>

<div class="faq-inner">
  <div class="faq-label">Support</div>
  <h1 class="faq-title">Submit an Appeal</h1>
  <p class="faq-sub">If your account has been restricted and you believe this is an error, submit your case below.</p>

  <div style="background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:2.5rem;margin-top:2rem;">
    <div id="appealError" class="error-msg" style="display:none;margin-bottom:1rem;"></div>
    <div id="appealSuccess" style="color:#16a34a;font-size:0.95rem;margin-bottom:1rem;display:none;"></div>

    <div style="display:flex;flex-direction:column;gap:1rem;">
      <div>
        <label style="font-size:0.85rem;font-weight:600;display:block;margin-bottom:0.4rem;">Your Email</label>
        <input type="email" id="appealEmail" class="form-input" placeholder="you@email.com" style="width:100%;" <% if (userEmail) { %>value="<%= userEmail %>"<% } %>>
      </div>
      <div>
        <label style="font-size:0.85rem;font-weight:600;display:block;margin-bottom:0.4rem;">Reason for Appeal</label>
        <textarea id="appealMessage" class="form-textarea" placeholder="Explain why your account should be restored..." style="min-height:150px;width:100%;"></textarea>
      </div>
      <button class="btn-primary" id="appealBtn" onclick="submitAppeal()">Submit Appeal</button>
    </div>
  </div>

  <p style="margin-top:2rem;font-size:0.9rem;color:var(--muted);">We review appeals within 3–5 business days. You'll receive a response at the email provided.</p>
</div>

<script>
async function submitAppeal() {
  const email = document.getElementById('appealEmail').value.trim();
  const message = document.getElementById('appealMessage').value.trim();
  if (!email || !message) { alert('Please fill in all fields.'); return; }
  const btn = document.getElementById('appealBtn');
  btn.disabled = true; btn.textContent = 'Submitting...';
  // This would normally POST to an appeals endpoint — for now log it
  document.getElementById('appealSuccess').textContent = 'Appeal submitted! We will review and respond within 3–5 business days.';
  document.getElementById('appealSuccess').style.display = 'block';
  btn.textContent = 'Submitted';
}
</script>

<%- include('../partials/footer') %>
</body>
</html>