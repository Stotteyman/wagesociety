<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Donate — W.A.G.E. Society</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="stylesheet" href="/css/pages.css">
  <style>
    .donate-page { padding: 5rem 3rem; }
    .donate-inner { max-width: 800px; margin: 0 auto; }

    /* Progress bar */
    .progress-card {
      background: var(--surface);
      border: 1px solid var(--border-strong);
      border-radius: var(--radius-card);
      padding: 2rem 2.5rem;
      margin-bottom: 2.5rem;
      text-align: center;
    }
    .progress-goal {
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: 0.5rem;
    }
    .progress-bar-wrap {
      background: var(--surface-2);
      border-radius: 999px;
      height: 20px;
      overflow: hidden;
      margin-bottom: 0.75rem;
    }
    .progress-bar-fill {
      height: 100%;
      background: linear-gradient(90deg, var(--accent), #fb923c);
      border-radius: 999px;
      transition: width 0.6s ease;
      min-width: 4px;
    }
    .progress-stats {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .progress-raised { font-size: 1.5rem; font-weight: 700; }
    .progress-amounts { font-size: 0.9rem; color: var(--muted); }
    .progress-pct { font-size: 1.1rem; font-weight: 600; color: var(--accent); }
    .progress-caption { font-size: 0.8rem; color: var(--muted-2); margin-top: 0.5rem; }

    /* Form card */
    .donate-form-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-card);
      padding: 2.5rem;
      margin-bottom: 2.5rem;
    }
    .form-title { font-size: 1.5rem; font-weight: 700; margin-bottom: 0.25rem; }
    .form-sub { color: var(--muted); font-size: 0.9rem; margin-bottom: 2rem; }

    .form-group { margin-bottom: 1.25rem; }
    .form-label { display: block; font-size: 0.8rem; font-weight: 600; color: var(--muted); margin-bottom: 0.5rem; text-transform: uppercase; letter-spacing: 0.08em; }
    .form-input, .form-textarea {
      width: 100%;
      background: var(--bg-2);
      border: 1px solid var(--border-strong);
      border-radius: var(--radius-sm);
      padding: 0.75rem 1rem;
      color: var(--fg);
      font-size: 1rem;
      font-family: inherit;
      transition: border-color 0.2s;
      outline: none;
    }
    .form-input:focus, .form-textarea:focus { border-color: var(--accent); }
    .form-textarea { resize: vertical; min-height: 80px; }
    .form-amount-wrap { position: relative; }
    .form-amount-prefix { position: absolute; left: 1rem; top: 50%; transform: translateY(-50%); color: var(--muted-2); font-size: 1rem; pointer-events: none; }
    .form-amount-input { padding-left: 2rem; font-size: 1.25rem; font-weight: 600; }

    .quick-amounts { display: flex; gap: 0.75rem; margin-bottom: 0.75rem; }
    .quick-btn {
      flex: 1;
      padding: 0.5rem;
      background: var(--bg-2);
      border: 1px solid var(--border-strong);
      border-radius: var(--radius-sm);
      color: var(--muted);
      font-size: 0.875rem;
      font-family: inherit;
      cursor: pointer;
      transition: all 0.2s;
      text-decoration: none;
      display: block;
      text-align: center;
    }
    .quick-btn:hover, .quick-btn.selected { background: var(--accent-dim); border-color: var(--accent); color: var(--accent); }

    .btn-donate {
      display: block;
      width: 100%;
      padding: 1rem;
      background: var(--accent);
      color: #fff;
      border: none;
      border-radius: var(--radius-btn);
      font-size: 1.1rem;
      font-weight: 700;
      font-family: inherit;
      cursor: pointer;
      transition: all 0.2s;
    }
    .btn-donate:hover { background: var(--accent-hover); box-shadow: 0 4px 20px rgba(249,115,22,0.35); }
    .btn-donate:disabled { opacity: 0.5; cursor: not-allowed; }

    .error-msg { background: rgba(239,68,68,0.15); border: 1px solid rgba(239,68,68,0.3); border-radius: var(--radius-sm); padding: 0.75rem 1rem; color: #fca5a5; font-size: 0.875rem; margin-bottom: 1rem; display: none; }

    /* Donor wall */
    .donor-wall { margin-top: 0.5rem; }
    .donor-wall-title { font-size: 1rem; font-weight: 700; margin-bottom: 1rem; color: var(--muted); }
    .donor-list { display: flex; flex-direction: column; gap: 0.75rem; }
    .donor-item { display: flex; align-items: flex-start; gap: 0.75rem; padding: 0.875rem 1rem; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-sm); }
    .donor-icon { width: 32px; height: 32px; border-radius: 50%; background: var(--accent-dim); display: flex; align-items: center; justify-content: center; flex-shrink: 0; color: var(--accent); font-size: 0.9rem; }
    .donor-info { flex: 1; min-width: 0; }
    .donor-name { font-weight: 600; font-size: 0.9rem; }
    .donor-amount { color: var(--accent); font-weight: 700; font-size: 0.9rem; }
    .donor-message { color: var(--muted); font-size: 0.8rem; margin-top: 0.2rem; font-style: italic; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .donor-date { color: var(--muted-2); font-size: 0.75rem; flex-shrink: 0; }

    .empty-donors { text-align: center; color: var(--muted-2); padding: 2rem; font-size: 0.9rem; }

    .canceled-banner { background: rgba(251,191,36,0.1); border: 1px solid rgba(251,191,36,0.3); border-radius: var(--radius-sm); padding: 0.75rem 1rem; color: #fde68a; font-size: 0.875rem; margin-bottom: 1.5rem; text-align: center; }

    .payment-note { font-size: 0.75rem; color: var(--muted-2); text-align: center; margin-top: 0.75rem; }

    @media (max-width: 600px) {
      .donate-page { padding: 4rem 1.5rem; }
      .donate-form-card { padding: 1.5rem; }
      .quick-amounts { flex-wrap: wrap; }
    }
  </style>
</head>
<body>
  <%- include('../partials/nav') %>

  <section class="donate-page">
    <div class="donate-inner">

      <div class="page-header" style="text-align:center; margin-bottom:2.5rem;">
        <span class="section-label">Support the Mission</span>
        <h1 class="section-title">Donate to W.A.G.E. Society</h1>
        <p class="section-sub" style="margin:0 auto;">Every dollar funds tools, infrastructure, and community growth — for creators who refuse to share their revenue with platform middlemen.</p>
      </div>

      <% if (canceled) { %>
        <div class="canceled-banner">Your donation was cancelled — no charge was made. Give it another shot below.</div>
      <% } %>

      <!-- Progress bar -->
      <div class="progress-card">
        <div class="progress-goal">🎯 Goal: $<%= (totals.goal_cents / 100).toFixed(0) %></div>
        <div class="progress-bar-wrap">
          <div class="progress-bar-fill" id="progressFill" style="width:<%= totals.percentage %>%"></div>
        </div>
        <div class="progress-stats">
          <div>
            <span class="progress-raised" id="progressRaised">$<%= (totals.total_cents / 100).toFixed(0) %></span>
            <span class="progress-amounts"> / $<%= (totals.goal_cents / 100).toFixed(0) %></span>
          </div>
          <div class="progress-pct" id="progressPct"><%= totals.percentage %>%</div>
        </div>
        <div class="progress-caption"><%= totals.count %> donation<%= totals.count !== 1 ? 's' : '' %> from the community</div>
      </div>

      <!-- Donation form -->
      <div class="donate-form-card">
        <h2 class="form-title">Make a Donation</h2>
        <p class="form-sub">One-time payment via Stripe. Secure and instant.</p>

        <div id="formError" class="error-msg"></div>

        <div class="quick-amounts">
          <a href="#" class="quick-btn" id="quick10" onclick="return handleQuickDonate(10, this)">$10</a>
          <a href="#" class="quick-btn" id="quick25" onclick="return handleQuickDonate(25, this)">$25</a>
          <a href="#" class="quick-btn" id="quick50" onclick="return handleQuickDonate(50, this)">$50</a>
          <a href="#" class="quick-btn" id="quick100" onclick="return handleQuickDonate(100, this)">$100</a>
        </div>

        <form id="donateForm" onsubmit="return handleDonate(event)">
          <div class="form-group">
            <label class="form-label" for="amount">Custom Amount</label>
            <div class="form-amount-wrap">
              <span class="form-amount-prefix">$</span>
              <input type="number" id="amount" name="amount" class="form-input form-amount-input"
                     placeholder="25" min="1" step="1" required>
            </div>
          </div>

          <div class="form-group">
            <label class="form-label" for="name">Your Name</label>
            <input type="text" id="name" name="name" class="form-input" placeholder="Sarah K." required>
          </div>

          <div class="form-group">
            <label class="form-label" for="message">Message <span style="color:var(--muted-2);text-transform:none;font-weight:400;letter-spacing:0;">(optional)</span></label>
            <textarea id="message" name="message" class="form-textarea" placeholder="Love the mission — keep building."></textarea>
          </div>

          <button type="submit" class="btn-donate" id="donateBtn">Donate Now</button>
          <p class="payment-note">🔒 Payments processed securely by Stripe</p>
        </form>
      </div>

      <!-- Recent donors -->
      <div class="donor-wall">
        <div class="donor-wall-title">💛 Recent Supporters</div>
        <div id="donorList" class="donor-list">
          <div style="text-align:center;padding:1.5rem;color:var(--muted-2);">Loading recent donors…</div>
        </div>
      </div>

    </div>
  </section>

  <%- include('../partials/footer') %>

  <script>
    // Load quick-amount links from server
    async function loadQuickAmounts() {
      try {
        const res = await fetch('/api/donate/quick-amounts');
        const data = await res.json();
        if (data[10])  document.getElementById('quick10').href   = data[10];
        if (data[25])  document.getElementById('quick25').href   = data[25];
        if (data[50])  document.getElementById('quick50').href   = data[50];
        if (data[100]) document.getElementById('quick100').href  = data[100];
      } catch (_) {
        // Links will remain as # href — user sees error on click
      }
    }

    function setAmount(val) {
      document.getElementById('amount').value = val;
      document.querySelectorAll('.quick-btn').forEach(b => b.classList.remove('selected'));
      event.target.classList.add('selected');
    }

    // Quick amount: direct redirect to Stripe payment link
    function handleQuickDonate(amount, el) {
      const href = el.getAttribute('href');
      if (href && href !== '#') {
        window.location.href = href;
        return false;
      }
      // Fallback: prompt for name and use custom flow
      const name = prompt('Enter your name for the donation:');
      if (!name) return false;
      document.getElementById('name').value = name;
      document.getElementById('amount').value = amount;
      document.getElementById('donateForm').scrollIntoView({ behavior: 'smooth' });
      return false;
    }

    async function handleDonate(e) {
      e.preventDefault();
      const btn = document.getElementById('donateBtn');
      const err = document.getElementById('formError');
      err.style.display = 'none';

      const amount = parseFloat(document.getElementById('amount').value);
      const name   = document.getElementById('name').value.trim();
      const message = document.getElementById('message').value.trim();

      if (!amount || amount < 1) {
        err.textContent = 'Minimum donation is $1.';
        err.style.display = 'block';
        return;
      }
      if (!name) {
        err.textContent = 'Please enter your name.';
        err.style.display = 'block';
        return;
      }

      btn.disabled = true;
      btn.textContent = 'Redirecting to secure payment…';

      try {
        const res = await fetch('/api/donate/create-link', {
          method:  'POST',
          headers: { 'Content-Type': 'application/json' },
          body:    JSON.stringify({ amount, name, message }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Something went wrong');
        if (!data.url) throw new Error('No payment link returned');
        window.location.href = data.url;
      } catch (err) {
        err.textContent = err.message || 'Failed to create payment link.';
        err.style.display = 'block';
        btn.disabled = false;
        btn.textContent = 'Donate Now';
      }
    }

    // Load recent donors
    async function loadDonors() {
      try {
        const res  = await fetch('/api/donate/recent');
        const data = await res.json();
        const list = document.getElementById('donorList');
        if (!data.donations || data.donations.length === 0) {
          list.innerHTML = '<div class="empty-donors">Be the first to donate!</div>';
          return;
        }
        list.innerHTML = data.donations.map(d => `
          <div class="donor-item">
            <div class="donor-icon">💛</div>
            <div class="donor-info">
              <div class="donor-name">${escapeHtml(d.donor_name)} <span class="donor-amount">— $${(d.amount_cents / 100).toFixed(0)}</span></div>
              ${d.donor_message ? `<div class="donor-message">"${escapeHtml(d.donor_message)}"</div>` : ''}
            </div>
            <div class="donor-date">${formatDate(d.created_at)}</div>
          </div>
        `).join('');
      } catch (_) {
        document.getElementById('donorList').innerHTML = '<div class="empty-donors">Could not load donors.</div>';
      }
    }

    function escapeHtml(str) {
      const div = document.createElement('div');
      div.textContent = str || '';
      return div.innerHTML;
    }

    function formatDate(iso) {
      const d = new Date(iso);
      return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
    }

    loadQuickAmounts();
    loadDonors();
  </script>
</body>
</html>