<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  

<%- include('../partials/head-pwa') %>
  <title>FAQ — W.A.G.E. Society</title>
  <meta name="description" content="Answers to common questions about W.A.G.E. Society membership tiers, authentication, growth channels, and creator business tools.">
  <meta property="og:type" content="website">
  <meta property="og:title" content="FAQ — W.A.G.E. Society">
  <meta property="og:description" content="Answers to common questions about W.A.G.E. Society membership tiers, authentication, growth channels, and creator tools.">
  <meta property="og:image" content="https://pub-629428d185ca4960a0a73c850d32294b.r2.dev/generated-images/company_142957/eb47d638-137a-4907-b6c0-3bf099c5be80.jpg">
  <meta property="og:url" content="https://wagesociety.com/faq">
  <meta property="og:site_name" content="WAGE Society">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="FAQ — W.A.G.E. Society">
  <meta name="twitter:description" content="Answers to common questions about W.A.G.E. Society membership tiers, authentication, and creator tools.">
  <meta name="twitter:image" content="https://pub-629428d185ca4960a0a73c850d32294b.r2.dev/generated-images/company_142957/eb47d638-137a-4907-b6c0-3bf099c5be80.jpg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="stylesheet" href="/css/pages.css">
</head>
<body>
  <%- include('../partials/nav') %>

  <section class="faq-page">
    <div class="faq-inner">
      <span class="faq-label">FAQ</span>
      <h1 class="faq-title">Organization FAQ</h1>
      <p class="faq-sub">Answers about membership tracks, authentication, growth channels, live training, and creator business tools.</p>

      <div class="faq-list">
        <% faqs.forEach(function(faq) { %>
        <div class="faq-item">
          <button class="faq-question" onclick="this.classList.toggle('open'); this.nextElementSibling.classList.toggle('open')">
            <span><%= faq.question %></span>
            <svg class="faq-chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div class="faq-answer"><%= faq.answer %></div>
        </div>
        <% }) %>
      </div>
    </div>
  </section>

  <%- include('../partials/footer') %>
  <script>
    document.querySelectorAll('.faq-question').forEach(function(btn) {
      btn.addEventListener('click', function() {
        btn.classList.toggle('open');
        btn.nextElementSibling.classList.toggle('open');
      });
    });
  </script>
</body>
</html>