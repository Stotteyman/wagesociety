<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin: Shop — W.A.G.E. Society</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="stylesheet" href="/css/pages.css">
</head>
<body>
<%- include('../partials/nav') %>

<section class="dashboard-page">
  <div class="dashboard-inner">
    <div style="margin-bottom:2rem;">
      <a href="/dashboard" style="color:var(--muted);text-decoration:none;font-size:0.875rem;">← Back to Dashboard</a>
    </div>
    <div class="page-header">
      <span class="section-label" style="color:var(--accent);">Admin</span>
      <h1 class="section-title">Manage Shop</h1>
    </div>

    <div class="dash-card">
      <h3 class="dash-card-title">Merch Items</h3>
      <div id="shopItems"></div>
    </div>
  </div>
</section>

<script>
fetch('/api/auth/me').then(r=>r.json()).then(data => {
  if (!data.user || !['superadmin','admin'].includes(data.access?.role)) {
    document.querySelector('.dash-card').innerHTML = '<p style="color:#dc2626;">Access denied. Admin only.</p>';
    return;
  }
  fetch('/api/shop').then(r=>r.json()).then(shop => {
    const items = shop.merchItems || [];
    if (!items.length) {
      document.getElementById('shopItems').innerHTML = '<p style="color:var(--muted);">No merch items yet.</p>';
      return;
    }
    document.getElementById('shopItems').innerHTML = items.map(item => `
      <div style="display:flex;justify-content:space-between;align-items:center;padding:1rem 0;border-bottom:1px solid var(--border);">
        <div>
          <div style="font-weight:700;">${item.name}</div>
          <div style="font-size:0.85rem;color:var(--muted);">${item.price}</div>
        </div>
        <span style="font-size:0.75rem;background:var(--surface);border:1px solid var(--border);padding:0.2rem 0.75rem;border-radius:20px;">${item.is_active ? 'Active' : 'Inactive'}</span>
      </div>
    `).join('');
  });
});
</script>
<%- include('../partials/footer') %>
</body>
</html>