<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  

<%- include('../partials/head-pwa') %>
  <title>Signing in — W.A.G.E. Society</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/theme.css">
  <style>
    .cb-wrap { display:flex; align-items:center; justify-content:center; min-height:100vh; }
    .cb-card { text-align:center; max-width:360px; padding:40px 32px; }
    .cb-spinner { width:32px; height:32px; border:3px solid rgba(255,102,0,0.2); border-top-color:#ff6600; border-radius:50%; animation:spin 0.8s linear infinite; margin:0 auto 16px; }
    @keyframes spin { to { transform:rotate(360deg); } }
    .cb-msg { font-size:1rem; color:var(--text,#f5f5f5); font-family:'Space Grotesk',sans-serif; }
    .cb-error { color:#ef4444; font-size:0.9rem; margin-top:12px; }
  </style>
</head>
<body>
  <div class="cb-wrap">
    <div class="cb-card">
      <div class="cb-spinner"></div>
      <p class="cb-msg">Signing you in&hellip;</p>
    </div>
  </div>

  <script>
  (function() {
    var params = new URLSearchParams(window.location.search);
    var token = params.get('token');

    // Magic link: redirect to server-side /auth/verify
    if (token) {
      window.location.href = '/auth/verify?token=' + encodeURIComponent(token);
      return;
    }

    // OAuth flow no longer supported — redirect to login
    window.location.href = '/login?error=oauth_not_supported';
  })();
  </script>
</body>
</html>