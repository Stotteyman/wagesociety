<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Supabase Diagnostic — W.A.G.E. Society</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/theme.css">
  <style>
    body { font-family: 'Space Grotesk', sans-serif; background: #09090b; color: #e4e4e7; min-height: 100vh; }
    .diag-wrap { max-width: 860px; margin: 0 auto; padding: 3rem 1.5rem 5rem; }
    h1 { font-size: 2rem; font-weight: 800; margin-bottom: 0.4rem; }
    .sub { color: #71717a; font-size: 0.9rem; margin-bottom: 2rem; }
    .toolbar { display: flex; gap: 1rem; align-items: center; margin-bottom: 2rem; }
    .btn { background: #f97316; color: #09090b; font-weight: 700; padding: 0.55rem 1.25rem;
           border: none; border-radius: 8px; cursor: pointer; font-size: 0.9rem; font-family: inherit; }
    .btn:disabled { opacity: 0.5; cursor: not-allowed; }
    .status-bar { font-size: 0.85rem; color: #a1a1aa; }
    table { width: 100%; border-collapse: collapse; }
    th { text-align: left; font-size: 0.75rem; font-weight: 600; color: #71717a;
         text-transform: uppercase; letter-spacing: 0.05em; padding: 0.5rem 0.75rem;
         border-bottom: 1px solid #27272a; }
    td { padding: 0.75rem; border-bottom: 1px solid #18181b; vertical-align: top; }
    tr:last-child td { border-bottom: none; }
    .pill { display: inline-block; padding: 0.2rem 0.65rem; border-radius: 999px;
            font-size: 0.75rem; font-weight: 700; letter-spacing: 0.04em; }
    .pill-pass { background: #14532d; color: #4ade80; }
    .pill-fail { background: #450a0a; color: #f87171; }
    .pill-warn { background: #422006; color: #fb923c; }
    .pill-pending { background: #1c1c22; color: #a1a1aa; }
    .latency { font-size: 0.78rem; color: #71717a; }
    .name { font-weight: 600; font-size: 0.9rem; }
    .detail-btn { background: none; border: 1px solid #3f3f46; color: #a1a1aa; padding: 0.2rem 0.6rem;
                  border-radius: 6px; cursor: pointer; font-size: 0.75rem; font-family: inherit; }
    .detail-btn:hover { border-color: #71717a; color: #e4e4e7; }
    .detail-block { display: none; margin-top: 0.5rem; background: #18181b; border-radius: 8px;
                    padding: 0.75rem 1rem; font-size: 0.78rem; font-family: monospace;
                    white-space: pre-wrap; word-break: break-all; color: #a1a1aa; }
    .detail-block.open { display: block; }
    .all-pass { background: #14532d; border: 1px solid #166534; border-radius: 10px;
                padding: 1rem 1.25rem; margin-bottom: 1.5rem; color: #4ade80; font-weight: 700; }
    .has-warn { background: #2c1503; border: 1px solid #7c2d12; border-radius: 10px;
                padding: 1rem 1.25rem; margin-bottom: 1.5rem; color: #fb923c; font-weight: 700; }
    .has-fail { background: #450a0a; border: 1px solid #7f1d1d; border-radius: 10px;
                padding: 1rem 1.25rem; margin-bottom: 1.5rem; color: #f87171; font-weight: 700; }
    .summary-hidden { display: none; }
    #spinner { display: none; }
    .spin { animation: spin 0.8s linear infinite; display: inline-block; }
    @keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
  </style>
</head>
<body>
<div class="diag-wrap">
  <h1>🔬 Supabase Diagnostic</h1>
  <p class="sub">Runs 9 live checks against Supabase + Postgres. No auth required.</p>

  <div class="toolbar">
    <button class="btn" id="runBtn" onclick="runDiagnostic()">▶ Run</button>
    <span class="status-bar" id="statusBar">Loading…</span>
    <span id="spinner" class="spin">⟳</span>
  </div>

  <div id="summary" class="summary-hidden"></div>

  <table>
    <thead>
      <tr>
        <th>Check</th>
        <th>Status</th>
        <th>Latency</th>
        <th>Detail</th>
      </tr>
    </thead>
    <tbody id="resultsBody">
      <tr><td colspan="4" style="color:#52525b;text-align:center;padding:2rem;">Waiting for run…</td></tr>
    </tbody>
  </table>
</div>

<script>
async function runDiagnostic() {
  const btn     = document.getElementById('runBtn');
  const spinner = document.getElementById('spinner');
  const statusBar = document.getElementById('statusBar');
  const summary   = document.getElementById('summary');
  const tbody     = document.getElementById('resultsBody');

  btn.disabled = true;
  spinner.style.display = 'inline-block';
  statusBar.textContent = 'Running…';
  summary.className = 'summary-hidden';
  tbody.innerHTML = '<tr><td colspan="4" style="color:#52525b;text-align:center;padding:2rem;">Running checks…</td></tr>';

  let data;
  try {
    const res = await fetch('/api/test-supabase');
    data = await res.json();
  } catch (err) {
    statusBar.textContent = 'Fetch failed: ' + err.message;
    btn.disabled = false;
    spinner.style.display = 'none';
    return;
  }

  const checks = data.checks || [];
  const allPass = data.all_pass;
  const ranAt   = data.ran_at ? new Date(data.ran_at).toLocaleString() : '—';

  const hasWarn = checks.some(c => c.status === 'warn');
  const hasFail = checks.some(c => c.status === 'fail');
  summary.className = hasFail ? 'has-fail' : hasWarn ? 'has-warn' : 'all-pass';
  summary.textContent = hasFail
    ? `❌ Some checks failed — ${ranAt}`
    : hasWarn
    ? `⚠️ All connectivity checks passed — ${checks.filter(c=>c.status==='warn').length} warning(s) — ${ranAt}`
    : `✅ All ${checks.length} checks passed — ${ranAt}`;

  tbody.innerHTML = checks.map((c, i) => {
    const pillClass  = c.status === 'pass' ? 'pill-pass' : c.status === 'warn' ? 'pill-warn' : 'pill-fail';
    const pillLabel  = c.status === 'pass' ? 'PASS' : c.status === 'warn' ? 'WARN' : 'FAIL';
    const detailJson = JSON.stringify({ detail: c.detail, error: c.error }, null, 2);
    return `
      <tr>
        <td class="name">${escHtml(c.name)}</td>
        <td><span class="pill ${pillClass}">${pillLabel}</span></td>
        <td class="latency">${c.latency_ms}ms</td>
        <td>
          <button class="detail-btn" onclick="toggleDetail(${i})">detail ▾</button>
          <div class="detail-block" id="detail-${i}">${escHtml(detailJson)}</div>
        </td>
      </tr>`;
  }).join('');

  statusBar.textContent = `Done — ${ranAt}`;
  btn.disabled = false;
  spinner.style.display = 'none';
}

function toggleDetail(i) {
  const el = document.getElementById('detail-' + i);
  el.classList.toggle('open');
}

function escHtml(str) {
  return String(str)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;');
}

// Auto-run on page load
runDiagnostic();
</script>
</body>
</html>
