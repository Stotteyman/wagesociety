<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Checkout — W.A.G.E. Society</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="stylesheet" href="/css/pages.css">
  <style>
    .checkout-container {
      max-width: 540px;
      margin: 0 auto;
      padding: 2rem 1rem;
    }

    .checkout-header {
      text-align: center;
      margin-bottom: 2rem;
    }

    .checkout-header h1 {
      font-family: 'Space Grotesk', sans-serif;
      font-size: clamp(1.75rem, 4vw, 2.5rem);
      font-weight: 900;
      letter-spacing: -0.03em;
      margin-bottom: 0.5rem;
    }

    .checkout-header p {
      color: var(--muted);
      font-size: 1rem;
    }

    .checkout-summary {
      background: var(--surface);
      border: 1px solid var(--border-strong);
      border-radius: 12px;
      padding: 1.5rem;
      margin-bottom: 2rem;
    }

    .summary-plan-name {
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--accent);
      margin-bottom: 0.5rem;
    }

    .summary-price-row {
      display: flex;
      align-items: baseline;
      gap: 0.5rem;
      margin-bottom: 0.25rem;
    }

    .summary-price-amount {
      font-family: 'Space Grotesk', sans-serif;
      font-size: clamp(2rem, 5vw, 2.5rem);
      font-weight: 900;
      line-height: 1;
    }

    .summary-price-period {
      color: var(--muted);
      font-size: 1rem;
    }

    .summary-billing-cycle {
      font-size: 0.8rem;
      color: var(--accent-warm);
      margin-bottom: 1rem;
    }

    .summary-features {
      list-style: none;
      padding: 0;
      margin: 0 0 1rem;
      border-top: 1px solid var(--border);
      padding-top: 1rem;
    }

    .summary-features li {
      padding: 0.35rem 0;
      font-size: 0.9rem;
      color: var(--fg);
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .summary-features li .check { color: var(--accent); font-weight: 700; }

    .checkout-form {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }

    .btn-primary {
      min-height: 52px;
      font-size: max(15px, 1rem);
      font-weight: 700;
    }

    .btn-primary:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }

    .checkout-secure-note {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.4rem;
      color: var(--muted-2);
      font-size: 0.8rem;
      margin-top: 0.75rem;
    }

    .checkout-secure-note svg { flex-shrink: 0; }

    .trial-note {
      text-align: center;
      color: var(--muted);
      font-size: 0.85rem;
      line-height: 1.5;
      margin-top: 1rem;
    }

    .back-link {
      display: block;
      text-align: center;
      color: var(--muted);
      font-size: 0.875rem;
      text-decoration: none;
      margin-top: 1rem;
    }

    .back-link:hover { color: var(--fg); }
  </style>
</head>
<body>
<%- include('../partials/nav') %>

<div class="checkout-container">
  <div class="checkout-header">
    <h1>Complete Your Order</h1>
    <p>7-day free trial — no charge until Day 8</p>
  </div>

  <div class="checkout-summary">
    <div class="summary-plan-name"><%= planName || 'Membership' %></div>
    <div class="summary-price-row">
      <div class="summary-price-amount">$<%= planPrice || '0' %></div>
      <div class="summary-price-period"><%= billingCycle === 'annual' ? '/yr' : '/mo' %></div>
    </div>
    <div class="summary-billing-cycle">
      <% if (billingCycle === 'annual') { %>
        Billed annually — 2 months free
      <% } else { %>
        Billed monthly
      <% } %>
    </div>
    <% if (features && features.length) { %>
    <ul class="summary-features">
      <% features.forEach(function(f) { %>
        <li><span class="check">✓</span> <%= f %></li>
      <% }); %>
    </ul>
    <% } %>
  </div>

  <form class="checkout-form" id="checkout-form">
    <button type="submit" class="btn-primary" id="checkout-btn" style="display:block;width:100%;background:var(--accent);color:#fff;border:none;border-radius:10px;font-family:'Space Grotesk',sans-serif;font-size:1rem;font-weight:700;padding:1rem;cursor:pointer;">
      Continue to Payment →
    </button>
  </form>

  <div class="checkout-secure-note">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
    Secured by Stripe — cancel anytime
  </div>

  <p class="trial-note">
    You won't be charged during your 7-day free trial. Cancel any time before Day 8.
  </p>

  <a href="/memberships" class="back-link">← Back to membership plans</a>
</div>

<%- include('../partials/footer') %>

<script>
  document.getElementById('checkout-form').addEventListener('submit', async function(e) {
    e.preventDefault();
    var btn = document.getElementById('checkout-btn');
    btn.disabled = true;
    btn.textContent = 'Redirecting…';

    var planSlug = '<%= planSlug || "" %>';
    var cycle = '<%= billingCycle || "monthly" %>';

    try {
      var res = await fetch('/api/checkout/redirect', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ planSlug: planSlug, cycle: cycle })
      });
      var data = await res.json();
      if (data.redirectUrl) {
        window.location.href = data.redirectUrl;
      } else {
        alert('Could not start checkout. Please try again.');
        btn.disabled = false;
        btn.textContent = 'Continue to Payment →';
      }
    } catch (err) {
      alert('Checkout error. Please try again.');
      btn.disabled = false;
      btn.textContent = 'Continue to Payment →';
    }
  });
</script>
</body>
</html>