<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  

<%- include('../../partials/head-pwa') %>
  <title>Discord — W.A.G.E. Society</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="stylesheet" href="/css/pages.css">
  <style>
    :root { --discord-accent: #5865F2; --discord-dim: rgba(88,101,242,0.12); }
    body { font-family: 'Space Grotesk', sans-serif; }
    .discord-label {
      display: inline-flex; align-items: center; gap: 0.5rem;
      font-size: 0.7rem; font-weight: 700; letter-spacing: 0.18em;
      text-transform: uppercase; color: var(--discord-accent);
      margin-bottom: 1rem; background: var(--discord-dim);
      border: 1px solid rgba(88,101,242,0.25);
      padding: 0.35rem 0.9rem; border-radius: 100px;
    }
    .dashboard-page { padding: 5rem 3rem; }
    .dashboard-inner { max-width: 1100px; margin: 0 auto; }
    .section-title {
      font-size: clamp(2rem, 4vw, 3.25rem); font-weight: 700;
      line-height: 1.1; letter-spacing: -0.03em; margin-bottom: 0.75rem;
    }
    .section-sub { font-size: 1rem; color: var(--muted); max-width: 55ch; line-height: 1.7; margin-bottom: 2.5rem; }
    .dash-card {
      background: var(--bg-2); border: 1px solid var(--border);
      border-radius: 12px; padding: 1.5rem;
    }
    .dash-card-title { font-weight: 700; font-size: 1rem; margin-bottom: 0.5rem; }
    .server-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.25rem; }
    .server-card { background: var(--bg-2); border: 1px solid var(--border); border-radius: 12px; padding: 1.5rem; transition: border-color 0.2s; }
    .server-card:hover { border-color: var(--discord-accent); }
    .server-card-header { display: flex; align-items: center; gap: 1rem; margin-bottom: 1rem; }
    .server-icon { width: 56px; height: 56px; border-radius: 10px; object-fit: cover; flex-shrink: 0; background: var(--surface); }
    .server-icon-placeholder { width: 56px; height: 56px; border-radius: 10px; background: var(--discord-dim); display: flex; align-items: center; justify-content: center; font-size: 1.5rem; flex-shrink: 0; }
    .server-name { font-weight: 700; font-size: 1.05rem; margin-bottom: 0.2rem; }
    .server-meta { font-size: 0.78rem; color: var(--muted); }
    .server-status { display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.75rem; font-weight: 600; padding: 0.2rem 0.6rem; border-radius: 100px; }
    .status-connected { background: rgba(34,197,94,0.15); color: #4ade80; }
    .status-disconnected { background: rgba(239,68,68,0.12); color: #f87171; }
    .status-pending { background: rgba(234,179,8,0.12); color: #fbbf24; }
    .status-dot { width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
    .server-stats { display: flex; gap: 1rem; margin: 1rem 0; flex-wrap: wrap; }
    .stat-item { text-align: center; flex: 1; min-width: 60px; }
    .stat-value { font-size: 1.25rem; font-weight: 700; color: var(--text); }
    .stat-label { font-size: 0.7rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.08em; }
    .server-actions { display: flex; gap: 0.5rem; margin-top: 1rem; flex-wrap: wrap; }
    .btn-discord {
      display: inline-flex; align-items: center; gap: 0.4rem;
      background: var(--discord-accent); color: #fff;
      padding: 0.5rem 1rem; border-radius: 6px;
      font-size: 0.8rem; font-weight: 600; text-decoration: none; border: none; cursor: pointer;
      transition: background 0.2s; font-family: inherit;
    }
    .btn-discord:hover { background: #4752C4; }
    .btn-outline {
      display: inline-flex; align-items: center; gap: 0.4rem;
      background: transparent; color: var(--discord-accent);
      padding: 0.5rem 1rem; border-radius: 6px; border: 1px solid rgba(88,101,242,0.4);
      font-size: 0.8rem; font-weight: 600; text-decoration: none; cursor: pointer;
      transition: all 0.2s; font-family: inherit;
    }
    .btn-outline:hover { background: var(--discord-dim); }
    .btn-ghost {
      display: inline-flex; align-items: center; gap: 0.4rem;
      background: var(--surface); color: var(--muted);
      padding: 0.5rem 1rem; border-radius: 6px; border: 1px solid var(--border);
      font-size: 0.8rem; font-weight: 600; text-decoration: none; cursor: pointer;
      transition: all 0.2s; font-family: inherit;
    }
    .btn-ghost:hover { color: var(--text); border-color: var(--border-hover); }
    .empty-state { text-align: center; padding: 4rem 2rem; background: var(--surface); border: 1px dashed var(--border); border-radius: 12px; color: var(--muted); }
    .empty-state-icon { font-size: 3rem; margin-bottom: 1rem; }
    .page-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 2rem; gap: 1rem; flex-wrap: wrap; }
    .top-bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; gap: 1rem; flex-wrap: wrap; }
    .refresh-btn { font-size: 0.8rem; padding: 0.5rem 1rem; }
    #loading-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 100; align-items: center; justify-content: center; }
    #loading-overlay.active { display: flex; }
    .spinner { width: 40px; height: 40px; border: 3px solid var(--border); border-top-color: var(--discord-accent); border-radius: 50%; animation: spin 0.8s linear infinite; }
    @keyframes spin { to { transform: rotate(360deg); } }
  </style>
</head>
<body>
<%- include('../../partials/nav') %>

<section class="dashboard-page">
  <div class="dashboard-inner">

    <div class="page-header">
      <div>
        <div class="discord-label">Discord Integration</div>
        <h1 class="section-title">Your Discord Servers</h1>
        <p class="section-sub">Manage your connected Discord servers. Link your Discord account and install the W.A.G.E. Society bot to unlock membership sync and auto-roles.</p>
      </div>
      <div style="display:flex;gap:0.75rem;flex-wrap:wrap;align-items:center;margin-top:auto;">
        <button class="btn-ghost refresh-btn" onclick="refreshServers()">↻ Refresh</button>
        <a href="/dashboard/discord/connect" class="btn-discord">+ Connect Server</a>
      </div>
    </div>

    <% if (connected && connected.length > 0) { %>
    <div style="margin-bottom:1.5rem;">
      <h2 style="font-size:1rem;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:var(--muted);margin-bottom:1rem;">Active Servers</h2>
      <div class="server-grid">
        <% for (const server of connected) { %>
        <div class="server-card" id="server-<%= server.guild_id %>">
          <div class="server-card-header">
            <% if (server.icon_url) { %>
              <img src="<%= server.icon_url %>" alt="<%= server.name %>" class="server-icon">
            <% } else { %>
              <div class="server-icon-placeholder">🤖</div>
            <% } %>
            <div>
              <div class="server-name"><%= server.name || 'Unnamed Server' %></div>
              <div class="server-meta">
                <span class="server-status status-connected"><span class="status-dot"></span>Connected</span>
              </div>
            </div>
          </div>

          <div class="server-stats">
            <div class="stat-item">
              <div class="stat-value" id="members-<%= server.guild_id %>">—</div>
              <div class="stat-label">Members</div>
            </div>
            <div class="stat-item">
              <div class="stat-value" id="channels-<%= server.guild_id %>">—</div>
              <div class="stat-label">Channels</div>
            </div>
            <div class="stat-item">
              <div class="stat-value" id="roles-<%= server.guild_id %>">—</div>
              <div class="stat-label">Roles</div>
            </div>
          </div>

          <div class="server-actions">
            <button class="btn-discord" onclick="syncServer('<%= server.guild_id %>')">↻ Sync</button>
            <a href="/dashboard/discord/<%= server.guild_id %>" class="btn-outline">Manage</a>
            <button class="btn-ghost" onclick="generateInvite('<%= server.guild_id %>')">🔗 Invite</button>
          </div>
        </div>
        <% } %>
      </div>
    </div>
    <% } %>

    <% const unclaimed = servers.filter(s => s.connected_at && !s.owner_wageos_user_id); %>
    <% if (unclaimed.length > 0) { %>
    <div style="margin-bottom:1.5rem;">
      <h2 style="font-size:1rem;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:var(--muted);margin-bottom:1rem;">Pending — Claim Required</h2>
      <div class="server-grid">
        <% for (const server of unclaimed) { %>
        <div class="server-card" style="border-color: rgba(251,191,36,0.3);">
          <div class="server-card-header">
            <% if (server.icon_url) { %>
              <img src="<%= server.icon_url %>" alt="<%= server.name %>" class="server-icon">
            <% } else { %>
              <div class="server-icon-placeholder">🤖</div>
            <% } %>
            <div>
              <div class="server-name"><%= server.name || 'Unnamed Server' %></div>
              <div class="server-meta">
                <span class="server-status status-pending"><span class="status-dot"></span>Needs claim</span>
              </div>
            </div>
          </div>
          <div style="margin-top:1rem;">
            <p style="font-size:0.8rem;color:var(--muted);margin-bottom:0.75rem;">The bot is installed but this server isn't claimed. Click below to claim it and become the admin.</p>
            <button class="btn-discord" onclick="claimServer('<%= server.guild_id %>')">Claim Server</button>
          </div>
        </div>
        <% } %>
      </div>
    </div>
    <% } %>

    <% if (servers.filter(s => !s.connected_at).length > 0) { %>
    <div>
      <h2 style="font-size:1rem;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:var(--muted);margin-bottom:1rem;">Not Installed</h2>
      <div class="server-grid">
        <% for (const server of servers.filter(s => !s.connected_at)) { %>
        <div class="server-card" style="opacity:0.6;">
          <div class="server-card-header">
            <div class="server-icon-placeholder">🤖</div>
            <div>
              <div class="server-name"><%= server.name || 'Unnamed Server' %></div>
              <div class="server-meta">
                <span class="server-status status-disconnected"><span class="status-dot"></span>Bot not installed</span>
              </div>
            </div>
          </div>
          <div class="server-actions">
            <button class="btn-outline" onclick="regenerateInstall('<%= server.guild_id %>')">Get Install Link</button>
          </div>
        </div>
        <% } %>
      </div>
    </div>
    <% } %>

    <% if (!servers || servers.length === 0) { %>
    <div class="empty-state">
      <div class="empty-state-icon">🤖</div>
      <p style="font-size:1rem;font-weight:600;margin-bottom:0.5rem;">No servers connected</p>
      <p style="font-size:0.85rem;margin-bottom:1.5rem;">Connect a Discord server to enable membership sync and auto-roles.</p>
      <a href="/dashboard/discord/connect" class="btn-discord">Connect a Server</a>
    </div>
    <% } %>

  </div>
</section>

<!-- Loading overlay -->
<div id="loading-overlay">
  <div style="text-align:center;color:var(--text);">
    <div class="spinner" style="margin:0 auto 1rem;"></div>
    <p style="font-size:0.9rem;" id="loading-msg">Syncing...</p>
  </div>
</div>

<%- include('../../partials/footer') %>

<script>
async function refreshServers() {
  window.location.reload();
}

async function syncServer(guildId) {
  const overlay = document.getElementById('loading-overlay');
  const msg = document.getElementById('loading-msg');
  overlay.classList.add('active');
  msg.textContent = 'Syncing with Discord API...';

  try {
    const res = await fetch(`/api/discord/servers/${guildId}/sync`, { method: 'POST' });
    const data = await res.json();

    if (!res.ok) throw new Error(data.error || 'Sync failed');

    if (data.stats) {
      document.getElementById(`members-${guildId}`).textContent = data.stats.memberCount ?? '?';
      document.getElementById(`channels-${guildId}`).textContent = data.stats.channelCount ?? '?';
    }
    msg.textContent = '✓ Synced!';
    setTimeout(() => overlay.classList.remove('active'), 800);
  } catch (err) {
    alert('Sync failed: ' + err.message);
    overlay.classList.remove('active');
  }
}

async function generateInvite(guildId) {
  try {
    const res = await fetch(`/api/discord/servers/${guildId}/generate-invite`, { method: 'POST' });
    const data = await res.json();
    if (!res.ok) throw new Error(data.error || 'Failed');
    window.open(data.installUrl, '_blank');
  } catch (err) {
    alert('Failed: ' + err.message);
  }
}

async function claimServer(guildId) {
  if (!confirm('Claim this Discord server? You must be the server owner.')) return;
  try {
    const res = await fetch('/api/discord-servers/claim', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ guildId }),
    });
    const data = await res.json();
    if (!res.ok) throw new Error(data.error || 'Failed');
    window.location.reload();
  } catch (err) {
    alert('Failed: ' + err.message);
  }
}

async function regenerateInstall(guildId) {
  try {
    const res = await fetch('/api/discord-servers/generate-install-url', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ guildId }),
    });
    const data = await res.json();
    if (!res.ok) throw new Error(data.error || 'Failed');
    window.open(data.installUrl, '_blank');
  } catch (err) {
    alert('Failed: ' + err.message);
  }
}

// On load, fetch stats for all connected servers
document.addEventListener('DOMContentLoaded', async () => {
  const connectedCards = document.querySelectorAll('.status-connected');
  for (const card of connectedCards) {
    const cardEl = card.closest('.server-card');
    const guildId = cardEl?.id?.replace('server-', '');
    if (guildId) {
      try {
        const res = await fetch(`/api/discord/servers/${guildId}`);
        if (res.ok) {
          const data = await res.json();
          if (data.stats) {
            if (data.stats.memberCount != null) document.getElementById(`members-${guildId}`).textContent = data.stats.memberCount;
            if (data.stats.channelCount != null) document.getElementById(`channels-${guildId}`).textContent = data.stats.channelCount;
            if (data.stats.roleCount != null) document.getElementById(`roles-${guildId}`).textContent = data.stats.roleCount;
          }
        }
      } catch (_) {}
    }
  }
});
</script>
</body>
</html>