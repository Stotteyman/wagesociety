<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  

<%- include('../../partials/head-pwa') %>
  <title><%= server.name || 'Server' %> — W.A.G.E. Society</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="stylesheet" href="/css/pages.css">
  <style>
    :root { --discord-accent: #5865F2; --discord-dim: rgba(88,101,242,0.12); }
    body { font-family: 'Space Grotesk', sans-serif; }
    .discord-label { display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.7rem; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--discord-accent); margin-bottom: 1rem; background: var(--discord-dim); border: 1px solid rgba(88,101,242,0.25); padding: 0.35rem 0.9rem; border-radius: 100px; }
    .dashboard-page { padding: 3rem 3rem 5rem; }
    .dashboard-inner { max-width: 1100px; margin: 0 auto; }
    .server-hero { display: flex; align-items: center; gap: 1.25rem; margin-bottom: 2rem; flex-wrap: wrap; }
    .server-hero-icon { width: 80px; height: 80px; border-radius: 14px; object-fit: cover; background: var(--discord-dim); flex-shrink: 0; }
    .server-hero-icon-placeholder { width: 80px; height: 80px; border-radius: 14px; background: var(--discord-dim); display: flex; align-items: center; justify-content: center; font-size: 2rem; flex-shrink: 0; }
    .server-hero-name { font-size: clamp(1.5rem, 3vw, 2.25rem); font-weight: 700; line-height: 1.1; letter-spacing: -0.02em; }
    .server-hero-meta { font-size: 0.85rem; color: var(--muted); margin-top: 0.25rem; display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; }
    .server-status { display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.75rem; font-weight: 600; padding: 0.2rem 0.65rem; border-radius: 100px; background: rgba(34,197,94,0.15); color: #4ade80; }
    .stat-row { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 1rem; margin: 1.5rem 0; }
    .stat-card { background: var(--bg-2); border: 1px solid var(--border); border-radius: 10px; padding: 1.25rem; text-align: center; }
    .stat-value { font-size: 1.75rem; font-weight: 700; color: var(--text); }
    .stat-label { font-size: 0.72rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.1em; margin-top: 0.2rem; }
    /* Tabs */
    .tab-bar { display: flex; gap: 0.25rem; border-bottom: 1px solid var(--border); margin-bottom: 2rem; flex-wrap: wrap; }
    .tab-btn { padding: 0.75rem 1.25rem; font-size: 0.85rem; font-weight: 600; color: var(--muted); background: none; border: none; cursor: pointer; border-bottom: 2px solid transparent; margin-bottom: -1px; transition: all 0.2s; border-radius: 6px 6px 0 0; font-family: inherit; }
    .tab-btn:hover { color: var(--text); }
    .tab-btn.active { color: var(--discord-accent); border-bottom-color: var(--discord-accent); }
    .tab-panel { display: none; }
    .tab-panel.active { display: block; }
    /* Config rows */
    .config-section { margin-bottom: 2rem; }
    .config-section-title { font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em; color: var(--discord-accent); margin-bottom: 1rem; padding-bottom: 0.5rem; border-bottom: 1px solid var(--border); }
    .config-row { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.875rem 0; border-bottom: 1px solid var(--border); flex-wrap: wrap; }
    .config-row:last-child { border-bottom: none; }
    .config-info { flex: 1; min-width: 200px; }
    .config-label { font-weight: 600; font-size: 0.9rem; margin-bottom: 0.15rem; }
    .config-desc { font-size: 0.78rem; color: var(--muted); line-height: 1.5; }
    /* Toggle switch */
    .toggle { position: relative; width: 44px; height: 24px; flex-shrink: 0; }
    .toggle input { opacity: 0; width: 0; height: 0; }
    .toggle-slider { position: absolute; inset: 0; background: var(--surface); border: 1px solid var(--border); border-radius: 100px; cursor: pointer; transition: all 0.2s; }
    .toggle-slider::before { content: ''; position: absolute; width: 18px; height: 18px; left: 2px; top: 2px; background: var(--muted); border-radius: 50%; transition: all 0.2s; }
    .toggle input:checked + .toggle-slider { background: var(--discord-accent); border-color: var(--discord-accent); }
    .toggle input:checked + .toggle-slider::before { transform: translateX(20px); background: #fff; }
    /* Number inputs */
    .num-input { width: 80px; padding: 0.4rem 0.75rem; background: var(--surface); border: 1px solid var(--border); border-radius: 6px; color: var(--text); font-size: 0.85rem; font-family: inherit; text-align: center; }
    .num-input:focus { outline: none; border-color: var(--discord-accent); }
    /* Buttons */
    .btn-discord { display: inline-flex; align-items: center; gap: 0.4rem; background: var(--discord-accent); color: #fff; padding: 0.5rem 1rem; border-radius: 6px; font-size: 0.8rem; font-weight: 600; text-decoration: none; border: none; cursor: pointer; transition: background 0.2s; font-family: inherit; }
    .btn-discord:hover { background: #4752C4; }
    .btn-discord:disabled { opacity: 0.5; cursor: not-allowed; }
    .btn-ghost { display: inline-flex; align-items: center; gap: 0.4rem; background: var(--surface); color: var(--muted); padding: 0.5rem 1rem; border-radius: 6px; border: 1px solid var(--border); font-size: 0.8rem; font-weight: 600; text-decoration: none; cursor: pointer; transition: all 0.2s; font-family: inherit; }
    .btn-ghost:hover { color: var(--text); border-color: var(--border-hover); }
    /* Quick actions */
    .quick-actions { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-top: 1.5rem; }
    /* Roles list */
    .role-item { display: flex; align-items: center; gap: 0.875rem; padding: 0.75rem 1rem; background: var(--surface); border: 1px solid var(--border); border-radius: 8px; margin-bottom: 0.625rem; transition: border-color 0.2s; }
    .role-item:hover { border-color: var(--discord-accent); }
    .role-color { width: 14px; height: 14px; border-radius: 3px; flex-shrink: 0; }
    .role-name { flex: 1; font-weight: 600; font-size: 0.9rem; }
    .role-count { font-size: 0.78rem; color: var(--muted); }
    /* Logs table */
    .log-table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
    .log-table th { text-align: left; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--muted); padding: 0.5rem 0.75rem; border-bottom: 1px solid var(--border); }
    .log-table td { padding: 0.75rem; border-bottom: 1px solid var(--border); vertical-align: top; }
    .log-table tr:last-child td { border-bottom: none; }
    .log-table tr:hover td { background: var(--surface); }
    .log-type { font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; padding: 0.2rem 0.5rem; border-radius: 4px; }
    .log-type.join { background: rgba(34,197,94,0.12); color: #4ade80; }
    .log-type.leave { background: rgba(239,68,68,0.12); color: #f87171; }
    .log-type.mod { background: rgba(88,101,242,0.15); color: #818cf8; }
    .log-type.warn { background: rgba(251,191,36,0.12); color: #fbbf24; }
    .log-type.ban { background: rgba(239,68,68,0.2); color: #f87171; }
    .log-empty { text-align: center; padding: 3rem; color: var(--muted); }
    .nav-back { display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.85rem; color: var(--muted); text-decoration: none; margin-bottom: 1.5rem; transition: color 0.2s; }
    .nav-back:hover { color: var(--text); }
    .save-status { font-size: 0.8rem; color: var(--muted); margin-left: auto; }
    .save-status.ok { color: #4ade80; }
    /* Filter bar */
    .filter-bar { display: flex; gap: 0.5rem; margin-bottom: 1.5rem; flex-wrap: wrap; }
    .filter-chip { padding: 0.35rem 0.875rem; border-radius: 100px; font-size: 0.78rem; font-weight: 600; cursor: pointer; border: 1px solid var(--border); background: var(--surface); color: var(--muted); transition: all 0.2s; font-family: inherit; }
    .filter-chip.active { background: var(--discord-dim); border-color: rgba(88,101,242,0.4); color: var(--discord-accent); }
    .save-btn { padding: 0.625rem 1.5rem; background: var(--discord-accent); color: #fff; border: none; border-radius: 6px; font-weight: 700; font-size: 0.875rem; cursor: pointer; font-family: inherit; transition: background 0.2s; }
    .save-btn:hover { background: #4752C4; }
    .save-btn:disabled { opacity: 0.5; cursor: not-allowed; }
    .inline-save { display: flex; align-items: center; gap: 0.75rem; margin-top: 1rem; }
  </style>
</head>
<body>
<%- include('../../partials/nav') %>

<section class="dashboard-page">
  <div class="dashboard-inner">

    <a href="/dashboard/discord" class="nav-back">← Discord Servers</a>

    <!-- Server hero -->
    <div class="server-hero">
      <% if (server.icon_url) { %>
        <img src="<%= server.icon_url %>" alt="<%= server.name %>" class="server-hero-icon">
      <% } else { %>
        <div class="server-hero-icon-placeholder">🤖</div>
      <% } %>
      <div>
        <h1 class="server-hero-name"><%= server.name || 'Unnamed Server' %></h1>
        <div class="server-hero-meta">
          <span class="server-status"><span style="width:6px;height:6px;border-radius:50%;background:#4ade80;"></span>Connected</span>
          <span>ID: <%= server.guild_id %></span>
          <% if (server.connected_at) { %>
          <span>Since <%= new Date(server.connected_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></span>
          <% } %>
        </div>
      </div>
      <div style="margin-left:auto;display:flex;gap:0.5rem;flex-wrap:wrap;">
        <button class="btn-ghost" onclick="syncNow()">↻ Sync</button>
        <button class="btn-ghost" onclick="generateInviteLink()">🔗 Invite</button>
        <a href="https://discord.com/channels/<%= server.guild_id %>" target="_blank" class="btn-ghost">View on Discord ↗</a>
      </div>
    </div>

    <!-- Stats row -->
    <div class="stat-row" id="stats-row">
      <div class="stat-card">
        <div class="stat-value" id="stat-members">—</div>
        <div class="stat-label">Members</div>
      </div>
      <div class="stat-card">
        <div class="stat-value" id="stat-online">—</div>
        <div class="stat-label">Online</div>
      </div>
      <div class="stat-card">
        <div class="stat-value" id="stat-channels">—</div>
        <div class="stat-label">Channels</div>
      </div>
      <div class="stat-card">
        <div class="stat-value" id="stat-roles">—</div>
        <div class="stat-label">Roles</div>
      </div>
    </div>

    <!-- Tabs -->
    <div class="tab-bar" id="tab-bar">
      <button class="tab-btn <%= tab === 'overview' ? 'active' : '' %>" data-tab="overview">Overview</button>
      <button class="tab-btn <%= tab === 'role-mappings' ? 'active' : '' %>" data-tab="role-mappings">Role Mappings</button>
      <button class="tab-btn <%= tab === 'members' ? 'active' : '' %>" data-tab="members">Members</button>
      <button class="tab-btn <%= tab === 'roles' ? 'active' : '' %>" data-tab="roles">Auto-Roles</button>
      <button class="tab-btn <%= tab === 'channels' ? 'active' : '' %>" data-tab="channels">Channels</button>
      <button class="tab-btn <%= tab === 'security' ? 'active' : '' %>" data-tab="security">Security</button>
      <button class="tab-btn <%= tab === 'logs' ? 'active' : '' %>" data-tab="logs">Logs</button>
    </div>

    <!-- ══ OVERVIEW TAB ══════════════════════════════════════════════════════════ -->
    <div class="tab-panel <%= tab === 'overview' ? 'active' : '' %>" id="panel-overview">
      <div class="config-section">
        <div class="config-section-title">Server Information</div>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:1rem;">
          <div style="background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:1rem;">
            <div style="font-size:0.72rem;text-transform:uppercase;letter-spacing:0.1em;color:var(--muted);margin-bottom:0.3rem;">Server ID</div>
            <div style="font-family:monospace;font-size:0.85rem;font-weight:600;"><%= server.guild_id %></div>
          </div>
          <div style="background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:1rem;">
            <div style="font-size:0.72rem;text-transform:uppercase;letter-spacing:0.1em;color:var(--muted);margin-bottom:0.3rem;">Connection</div>
            <div style="font-size:0.85rem;font-weight:600;color:#4ade80;">✓ Bot installed</div>
          </div>
          <div style="background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:1rem;">
            <div style="font-size:0.72rem;text-transform:uppercase;letter-spacing:0.1em;color:var(--muted);margin-bottom:0.3rem;">Last Updated</div>
            <div style="font-size:0.85rem;"><%= server.updated_at ? new Date(server.updated_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) : 'Never' %></div>
          </div>
        </div>
      </div>

      <div class="config-section">
        <div class="config-section-title">Quick Actions</div>
        <div class="quick-actions">
          <button class="btn-discord" onclick="syncNow()">↻ Refresh Stats</button>
          <button class="btn-ghost" onclick="generateInviteLink()">🔗 Regenerate Invite Link</button>
          <a href="https://discord.com/invite/<%= server.invite_code || '' %>" target="_blank" class="btn-ghost">Copy Invite Link</a>
          <button class="btn-ghost" onclick="refreshAll()">↻ Refresh All</button>
        </div>
      </div>

      <div class="config-section">
        <div class="config-section-title">Active Configuration</div>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:0.75rem;">
          <div style="display:flex;align-items:center;justify-content:space-between;padding:0.75rem 1rem;background:var(--surface);border:1px solid var(--border);border-radius:8px;">
            <span style="font-size:0.85rem;">Auto-role Free</span>
            <span id="cfg-overview-free" style="font-size:0.78rem;font-weight:700;color:var(--discord-accent);">—</span>
          </div>
          <div style="display:flex;align-items:center;justify-content:space-between;padding:0.75rem 1rem;background:var(--surface);border:1px solid var(--border);border-radius:8px;">
            <span style="font-size:0.85rem;">Auto-role Creator</span>
            <span id="cfg-overview-creator" style="font-size:0.78rem;font-weight:700;color:var(--discord-accent);">—</span>
          </div>
          <div style="display:flex;align-items:center;justify-content:space-between;padding:0.75rem 1rem;background:var(--surface);border:1px solid var(--border);border-radius:8px;">
            <span style="font-size:0.85rem;">Auto-role Pro</span>
            <span id="cfg-overview-pro" style="font-size:0.78rem;font-weight:700;color:var(--discord-accent);">—</span>
          </div>
          <div style="display:flex;align-items:center;justify-content:space-between;padding:0.75rem 1rem;background:var(--surface);border:1px solid var(--border);border-radius:8px;">
            <span style="font-size:0.85rem;">Greetings</span>
            <span id="cfg-overview-greetings" style="font-size:0.78rem;font-weight:700;color:var(--discord-accent);">—</span>
          </div>
          <div style="display:flex;align-items:center;justify-content:space-between;padding:0.75rem 1rem;background:var(--surface);border:1px solid var(--border);border-radius:8px;">
            <span style="font-size:0.85rem;">Mod Commands</span>
            <span id="cfg-overview-mod" style="font-size:0.78rem;font-weight:700;color:var(--discord-accent);">—</span>
          </div>
        </div>
        <div style="margin-top:0.75rem;">
          <a href="/dashboard/discord/<%= server.guild_id %>?tab=roles" class="btn-ghost" style="font-size:0.78rem;">Edit configuration →</a>
        </div>
      </div>
    </div>

    <!-- ══ ROLE MAPPINGS TAB ══════════════════════════════════════════════════════ -->
    <div class="tab-panel <%= tab === 'role-mappings' ? 'active' : '' %>" id="panel-role-mappings">
      <div class="config-section">
        <div class="config-section-title">Tier → Discord Role Mapping</div>
        <p style="font-size:0.875rem;color:var(--muted);margin-bottom:1.5rem;line-height:1.6;">
          Set which Discord role corresponds to each membership tier. When a member's WAGEOS tier changes, the bot updates their Discord role automatically. Roles are looked up by name — they must exist in your Discord server.
        </p>

        <div id="role-mappings-loading" style="text-align:center;padding:2rem;color:var(--muted);">Loading Discord roles…</div>

        <div id="role-mappings-form" style="display:none;">
          <div class="config-row">
            <div class="config-info">
              <div class="config-label">Free Tier Role</div>
              <div class="config-desc">Role assigned to members on the free plan</div>
            </div>
            <select id="mapping-free" class="role-select" style="padding:0.4rem 0.75rem;background:var(--surface);border:1px solid var(--border);border-radius:6px;color:var(--text);font-family:inherit;font-size:0.85rem;min-width:160px;">
              <option value="">— Not set —</option>
            </select>
          </div>
          <div class="config-row">
            <div class="config-info">
              <div class="config-label">Creator Tier Role</div>
              <div class="config-desc">Role assigned to members with an active Creator membership</div>
            </div>
            <select id="mapping-creator" class="role-select" style="padding:0.4rem 0.75rem;background:var(--surface);border:1px solid var(--border);border-radius:6px;color:var(--text);font-family:inherit;font-size:0.85rem;min-width:160px;">
              <option value="">— Not set —</option>
            </select>
          </div>
          <div class="config-row">
            <div class="config-info">
              <div class="config-label">Pro Tier Role</div>
              <div class="config-desc">Role assigned to members with an active Pro membership</div>
            </div>
            <select id="mapping-pro" class="role-select" style="padding:0.4rem 0.75rem;background:var(--surface);border:1px solid var(--border);border-radius:6px;color:var(--text);font-family:inherit;font-size:0.85rem;min-width:160px;">
              <option value="">— Not set —</option>
            </select>
          </div>
          <div class="inline-save">
            <button class="save-btn" id="mapping-save-btn" onclick="saveRoleMappings()">Save Mappings</button>
            <span class="save-status" id="mapping-save-status"></span>
          </div>
        </div>

        <div id="role-mappings-error" style="display:none;padding:1rem;background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.3);border-radius:8px;color:#f87171;font-size:0.875rem;margin-top:1rem;">
          Could not load Discord roles. Make sure the bot is in this server.
        </div>
      </div>

      <div class="config-section" style="margin-top:2.5rem;">
        <div class="config-section-title">Current Mappings Summary</div>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:0.75rem;">
          <div style="display:flex;align-items:center;justify-content:space-between;padding:0.75rem 1rem;background:var(--surface);border:1px solid var(--border);border-radius:8px;">
            <div>
              <div style="font-size:0.72rem;text-transform:uppercase;letter-spacing:0.1em;color:var(--muted);">Free</div>
              <div id="summary-free" style="font-weight:700;font-size:0.9rem;margin-top:0.2rem;">—</div>
            </div>
          </div>
          <div style="display:flex;align-items:center;justify-content:space-between;padding:0.75rem 1rem;background:var(--surface);border:1px solid var(--border);border-radius:8px;">
            <div>
              <div style="font-size:0.72rem;text-transform:uppercase;letter-spacing:0.1em;color:var(--muted);">Creator</div>
              <div id="summary-creator" style="font-weight:700;font-size:0.9rem;margin-top:0.2rem;">—</div>
            </div>
          </div>
          <div style="display:flex;align-items:center;justify-content:space-between;padding:0.75rem 1rem;background:var(--surface);border:1px solid var(--border);border-radius:8px;">
            <div>
              <div style="font-size:0.72rem;text-transform:uppercase;letter-spacing:0.1em;color:var(--muted);">Pro</div>
              <div id="summary-pro" style="font-weight:700;font-size:0.9rem;margin-top:0.2rem;">—</div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ══ MEMBERS TAB ═══════════════════════════════════════════════════════════ -->
    <div class="tab-panel <%= tab === 'members' ? 'active' : '' %>" id="panel-members">
      <div class="config-section">
        <div class="config-section-title">Guild Members</div>
        <p style="font-size:0.875rem;color:var(--muted);margin-bottom:1.5rem;line-height:1.6;">
          Members in this Discord server with their linked WAGEOS account and current tier. Admins can manually add or remove Discord roles.
        </p>

        <div style="display:flex;gap:0.75rem;margin-bottom:1.5rem;flex-wrap:wrap;align-items:center;">
          <input type="text" id="member-search" placeholder="Search by username…" style="flex:1;min-width:180px;padding:0.5rem 0.875rem;background:var(--surface);border:1px solid var(--border);border-radius:6px;color:var(--text);font-family:inherit;font-size:0.875rem;" oninput="debouncedSearch()">
          <select id="member-tier-filter" style="padding:0.5rem 0.75rem;background:var(--surface);border:1px solid var(--border);border-radius:6px;color:var(--text);font-family:inherit;font-size:0.85rem;" onchange="loadMembers()">
            <option value="">All tiers</option>
            <option value="pro">Pro</option>
            <option value="creator">Creator</option>
            <option value="free">Free</option>
            <option value="unlinked">Unlinked</option>
          </select>
          <span id="member-count" style="font-size:0.8rem;color:var(--muted);"></span>
        </div>

        <div id="members-loading" style="text-align:center;padding:2rem;color:var(--muted);">Loading members…</div>
        <div id="members-error" style="display:none;padding:1rem;background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.3);border-radius:8px;color:#f87171;font-size:0.875rem;">
          Could not load members. Make sure the bot has permission to view the member list.
        </div>

        <div id="members-list" style="display:none;"></div>
        <div id="members-empty" style="display:none;text-align:center;padding:2rem;color:var(--muted);">No members found matching your search.</div>
      </div>
    </div>

    <!-- ══ ROLES TAB ═════════════════════════════════════════════════════════════ -->
    <div class="tab-panel <%= tab === 'roles' ? 'active' : '' %>" id="panel-roles">
