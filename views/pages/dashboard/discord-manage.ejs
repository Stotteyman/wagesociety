<script>
// ── Tab switching ───────────────────────────────────────────────────────────
document.querySelectorAll('.tab-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
    btn.classList.add('active');
    const tab = btn.dataset.tab;
    document.getElementById('panel-' + tab)?.classList.add('active');
    history.replaceState({}, '', `?tab=${tab}`);
  });
});

// ── Load server data on init ─────────────────────────────────────────────────
const guildId = '<%= server.guild_id %>';
let isDirty = false;

async function loadServerData() {
  try {
    const res = await fetch(`/api/discord/servers/${guildId}`);
    if (!res.ok) return;

    const data = await res.json();

    // Update stats
    if (data.stats) {
      if (data.stats.memberCount != null) document.getElementById('stat-members').textContent = data.stats.memberCount;
      if (data.stats.onlineCount != null) document.getElementById('stat-online').textContent = data.stats.onlineCount;
      if (data.stats.channelCount != null) document.getElementById('stat-channels').textContent = data.stats.channelCount;
      if (data.stats.roleCount != null) document.getElementById('stat-roles').textContent = data.stats.roleCount;
    }

    const s = data.server;
    if (s) {
      // Roles tab
      if ('auto_role_free' in s) document.getElementById('role-free').checked = s.auto_role_free !== false;
      if ('auto_role_creator' in s) document.getElementById('role-creator').checked = s.auto_role_creator !== false;
      if ('auto_role_pro' in s) document.getElementById('role-pro').checked = s.auto_role_pro !== false;
      if ('greetings_enabled' in s) document.getElementById('role-greetings').checked = s.greetings_enabled;
      if ('mod_commands_enabled' in s) document.getElementById('role-mod').checked = s.mod_commands_enabled !== false;

      // Overview config
      if ('auto_role_free' in s) document.getElementById('cfg-overview-free').textContent = (s.auto_role_free !== false) ? 'ON' : 'OFF';
      if ('auto_role_creator' in s) document.getElementById('cfg-overview-creator').textContent = (s.auto_role_creator !== false) ? 'ON' : 'OFF';
      if ('auto_role_pro' in s) document.getElementById('cfg-overview-pro').textContent = (s.auto_role_pro !== false) ? 'ON' : 'OFF';
      if ('greetings_enabled' in s) document.getElementById('cfg-overview-greetings').textContent = s.greetings_enabled ? 'ON' : 'OFF';
      if ('mod_commands_enabled' in s) document.getElementById('cfg-overview-mod').textContent = (s.mod_commands_enabled !== false) ? 'ON' : 'OFF';

      // Channels
      if (s.welcome_channel_id) document.getElementById('ch-welcome').value = s.welcome_channel_id;
      if (s.log_channel_id) document.getElementById('ch-log').value = s.log_channel_id;
    }
  } catch (err) {
    console.error('[loadServerData]', err);
  }
}

function markDirty() { isDirty = true; }

// ── Save: Roles ───────────────────────────────────────────────────────────────
async function saveRoles() {
  const btn = document.getElementById('role-save-btn');
  const status = document.getElementById('role-save-status');
  const btn2 = document.getElementById('role-save-btn-2');
  const status2 = document.getElementById('role-save-status-2');

  btn.disabled = true;
  btn2 && (btn2.disabled = true);
  status.textContent = 'Saving...';
  status2 && (status2.textContent = 'Saving...');

  try {
    const res = await fetch(`/api/discord/servers/${guildId}/config`, {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        auto_role_free: document.getElementById('role-free').checked,
        auto_role_creator: document.getElementById('role-creator').checked,
        auto_role_pro: document.getElementById('role-pro').checked,
        greetings_enabled: document.getElementById('role-greetings').checked,
        mod_commands_enabled: document.getElementById('role-mod').checked,
      }),
    });
    const data = await res.json();
    if (!res.ok) throw new Error(data.error || 'Save failed');

    status.textContent = '✓ Saved';
    status.className = 'save-status ok';
    status2 && (status2.textContent = '✓ Saved');
    status2 && (status2.className = 'save-status ok');
    isDirty = false;
    loadServerData(); // refresh overview
  } catch (err) {
    status.textContent = '✗ ' + (err.message || 'Error');
    status.className = 'save-status';
    status2 && (status2.textContent = '✗ Error');
    status2 && (status2.className = 'save-status');
    btn.disabled = false;
    btn2 && (btn2.disabled = false);
  }
}

// ── Save: Channels ────────────────────────────────────────────────────────────
async function saveChannels() {
  const btn = document.querySelector('#panel-channels .save-btn');
  const status = document.getElementById('ch-save-status');
  btn.disabled = true;
  status.textContent = 'Saving...';

  try {
    const res = await fetch(`/api/discord/servers/${guildId}/config`, {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        welcome_channel_id: document.getElementById('ch-welcome').value || null,
        log_channel_id: document.getElementById('ch-log').value || null,
      }),
    });
    const data = await res.json();
    if (!res.ok) throw new Error(data.error || 'Save failed');
    status.textContent = '✓ Saved';
    status.className = 'save-status ok';
    isDirty = false;
  } catch (err) {
    status.textContent = '✗ ' + (err.message || 'Error');
    status.className = 'save-status';
    btn.disabled = false;
  }
}

// ── Save: Security ────────────────────────────────────────────────────────────
async function saveSecurity(section) {
  let statusId = 'sec-' + section + '-status';
  const status = document.getElementById(statusId);
  const btn = event?.target || document.querySelector('#panel-security .save-btn');
  btn.disabled = true;
  status.textContent = 'Saving...';

  try {
    const res = await fetch(`/api/discord/servers/${guildId}/config`, {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        anti_spam_enabled: document.getElementById('sec-anti-spam').checked,
        anti_spam_threshold: parseInt(document.getElementById('sec-spam-threshold').value) || 10,
        anti_raid_enabled: document.getElementById('sec-anti-raid').checked,
        anti_raid_threshold: parseInt(document.getElementById('sec-raid-threshold').value) || 10,
        anti_raid_window: parseInt(document.getElementById('sec-raid-window').value) || 30,
        invite_age_limit: parseInt(document.getElementById('sec-invite-age').value) || 0,
        verification_gate: document.getElementById('sec-verification-gate').checked,
      }),
    });
    const data = await res.json();
    if (!res.ok) throw new Error(data.error || 'Save failed');
    status.textContent = '✓ Saved';
    status.className = 'save-status ok';
    isDirty = false;
  } catch (err) {
    status.textContent = '✗ ' + (err.message || 'Error');
    status.className = 'save-status';
    btn.disabled = false;
  }
}

// ── Sync ──────────────────────────────────────────────────────────────────────
async function syncNow() {
  try {
    const res = await fetch(`/api/discord/servers/${guildId}/sync`, { method: 'POST' });
    const data = await res.json();
    if (!res.ok) throw new Error(data.error || 'Sync failed');
    if (data.stats) {
      if (data.stats.memberCount != null) document.getElementById('stat-members').textContent = data.stats.memberCount;
      if (data.stats.onlineCount != null) document.getElementById('stat-online').textContent = data.stats.onlineCount;
      if (data.stats.channelCount != null) document.getElementById('stat-channels').textContent = data.stats.channelCount;
    }
  } catch (err) {
    alert('Sync failed: ' + err.message);
  }
}

async function refreshAll() {
  await syncNow();
  await loadServerData();
}

// ── Invite ────────────────────────────────────────────────────────────────────
async function generateInviteLink() {
  try {
    const res = await fetch(`/api/discord/servers/${guildId}/generate-invite`, { method: 'POST' });
    const data = await res.json();
    if (!res.ok) throw new Error(data.error || 'Failed');
    window.open(data.installUrl, '_blank');
  } catch (err) {
    alert('Failed: ' + err.message);
  }
}

// ── Logs ──────────────────────────────────────────────────────────────────────
let currentFilter = 'all';
const mockLogs = [
  { type: 'join', user: 'User#1234', actor: 'WAGE Bot', time: '2 min ago', detail: 'Joined the server (member #420)' },
  { type: 'mod', user: 'SpamBot#9999', actor: 'WAGE Bot', time: '8 min ago', detail: 'Kicked: spam in #general' },
  { type: 'join', user: 'CreatorJane#001', actor: 'WAGE Bot', time: '15 min ago', detail: 'Joined — auto-role assigned (Creator)' },
  { type: 'leave', user: 'RandomUser#554', actor: '—', time: '1 hour ago', detail: 'Left the server' },
  { type: 'warn', user: 'User#7890', actor: 'Admin', time: '2 hours ago', detail: 'Warned: harassment in #chat' },
  { type: 'join', user: 'ProMember#2024', actor: 'WAGE Bot', time: '3 hours ago', detail: 'Joined — auto-role assigned (Pro)' },
];

function renderLogs(filter) {
  const container = document.getElementById('log-container');
  const filtered = filter === 'all' ? mockLogs : mockLogs.filter(l => l.type === filter);

  if (filtered.length === 0) {
    container.innerHTML = '<div class="log-empty">No events of this type yet.</div>';
    return;
  }

  container.innerHTML = `<table class="log-table">
    <thead>
      <tr>
        <th>Type</th><th>User</th><th>Action</th><th>When</th><th>Detail</th>
      </tr>
    </thead>
    <tbody>
      ${filtered.map(log => `
        <tr>
          <td><span class="log-type ${log.type}">${log.type}</span></td>
          <td style="font-weight:600;font-size:0.85rem;">${log.user}</td>
          <td style="color:var(--muted);font-size:0.8rem;">${log.actor}</td>
          <td style="color:var(--muted);font-size:0.78rem;">${log.time}</td>
          <td style="font-size:0.85rem;">${log.detail}</td>
        </tr>
      `).join('')}
    </tbody>
  </table>`;
}

function filterLogs(filter, btn) {
  currentFilter = filter;
  document.querySelectorAll('.filter-chip').forEach(c => c.classList.remove('active'));
  btn?.classList.add('active');
  renderLogs(filter);
}

function refreshLogs() {
  renderLogs(currentFilter);
}

// ── Role Mappings Tab ─────────────────────────────────────────────────────────
let mappingData = null;

function populateRoleSelects(roles, currentMappings) {
  const tiers = ['free', 'creator', 'pro'];
  for (const tier of tiers) {
    const sel = document.getElementById('mapping-' + tier);
    if (!sel) continue;
    sel.innerHTML = '<option value="">— Not set —</option>';
    for (const role of roles) {
      const opt = document.createElement('option');
      opt.value = role.name;
      opt.textContent = role.name;
      sel.appendChild(opt);
    }
    const current = currentMappings?.[tier] || '';
    if (current) sel.value = current;
    else sel.selectedIndex = 0;
  }
  document.getElementById('summary-free').textContent    = currentMappings?.free    || '—';
  document.getElementById('summary-creator').textContent = currentMappings?.creator || '—';
  document.getElementById('summary-pro').textContent     = currentMappings?.pro     || '—';
}

async function loadRoleMappings() {
  const panel = document.getElementById('panel-role-mappings');
  if (!panel?.classList.contains('active')) return;

  try {
    const res = await fetch(`/api/discord/role-mappings/${guildId}`);
    if (!res.ok) throw new Error(res.status);
    const data = await res.json();
    mappingData = data;

    document.getElementById('role-mappings-loading').style.display = 'none';
    document.getElementById('role-mappings-form').style.display = 'block';

    populateRoleSelects(data.availableRoles || [], data.mappings);
  } catch (err) {
    document.getElementById('role-mappings-loading').style.display = 'none';
    document.getElementById('role-mappings-error').style.display = 'block';
  }
}

async function saveRoleMappings() {
  const btn = document.getElementById('mapping-save-btn');
  const status = document.getElementById('mapping-save-status');
  btn.disabled = true;
  status.textContent = 'Saving…';

  try {
    const res = await fetch(`/api/discord/role-mappings/${guildId}`, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        tier_role_free:    document.getElementById('mapping-free').value || null,
        tier_role_creator: document.getElementById('mapping-creator').value || null,
        tier_role_pro:     document.getElementById('mapping-pro').value || null,
      }),
    });
    const data = await res.json();
    if (!res.ok) throw new Error(data.error || 'Save failed');

    status.textContent = '✓ Saved';
    status.className = 'save-status ok';

    // Update summary
    document.getElementById('summary-free').textContent    = data.mappings?.tier_role_free    || '—';
    document.getElementById('summary-creator').textContent = data.mappings?.tier_role_creator || '—';
    document.getElementById('summary-pro').textContent     = data.mappings?.tier_role_pro     || '—';

    // Reload role data
    await loadRoleMappings();
  } catch (err) {
    status.textContent = '✗ ' + (err.message || 'Error');
    status.className = 'save-status';
    btn.disabled = false;
  }
}

// ── Members Tab ────────────────────────────────────────────────────────────────
let membersData = null;
let debounceTimer = null;

function tierBadge(tier) {
  const map = { pro: 'Pro', creator: 'Creator', free: 'Free', unlinked: 'Unlinked' };
  const colors = { pro: '#a855f7', creator: '#3b82f6', free: '#6b7280', unlinked: '#9ca3af' };
  const label = map[tier] || 'Unknown';
  const color = colors[tier] || '#6b7280';
  return `<span style="display:inline-block;padding:0.15rem 0.6rem;border-radius:100px;font-size:0.72rem;font-weight:700;background:${color}22;color:${color};border:1px solid ${color}44;">${label}</span>`;
}

function renderMembers(members) {
  const container = document.getElementById('members-list');
  const empty = document.getElementById('members-empty');

  if (!members || members.length === 0) {
    container.style.display = 'none';
    empty.style.display = 'block';
    return;
  }
  empty.style.display = 'none';
  container.style.display = 'block';

  container.innerHTML = `<div style="overflow-x:auto;">
    <table class="log-table">
      <thead>
        <tr>
          <th>User</th>
          <th>WAGEOS Status</th>
          <th>Tier</th>
          <th>Roles</th>
          <th style="text-align:right;">Actions</th>
        </tr>
      </thead>
      <tbody>
        ${members.map(m => `
        <tr data-discord-id="${m.discordId}">
          <td>
            <div style="display:flex;align-items:center;gap:0.5rem;">
              ${m.avatar ? `<img src="${m.avatar}" style="width:28px;height:28px;border-radius:50%;object-fit:cover;">` : '<div style="width:28px;height:28px;border-radius:50%;background:var(--bg-2);display:flex;align-items:center;justify-content:center;font-size:0.75rem;">👤</div>'}
              <div>
                <div style="font-weight:600;font-size:0.875rem;">${m.username}</div>
                ${m.wageosEmail ? `<div style="font-size:0.72rem;color:var(--muted);">${m.wageosEmail}</div>` : ''}
              </div>
            </div>
          </td>
          <td>${m.wageosLinked ? '<span style="color:#4ade80;font-size:0.8rem;font-weight:600;">✓ Linked</span>' : '<span style="color:var(--muted);font-size:0.8rem;">Not linked</span>'}</td>
          <td>${tierBadge(m.wageosTier)}</td>
          <td style="font-size:0.78rem;color:var(--muted);">${m.roles.length} roles</td>
          <td style="text-align:right;">
            ${m.wageosLinked ? `<button class="btn-ghost" style="font-size:0.75rem;padding:0.3rem 0.6rem;" onclick="openMemberRolesModal('${m.discordId}', '${m.username.replace(/'/g, "\\'")}')">Manage roles</button>` : ''}
          </td>
        </tr>`).join('')}
      </tbody>
    </table>
  </div>`;

  document.getElementById('member-count').textContent = `${members.length} member${members.length !== 1 ? 's' : ''}`;
}

function applyMemberTierFilter(members) {
  const filter = document.getElementById('member-tier-filter')?.value || '';
  if (!filter) return members;
  return members.filter(m => m.wageosTier === filter || (filter === 'unlinked' && !m.wageosLinked));
}

async function loadMembers() {
  const panel = document.getElementById('panel-members');
  if (!panel?.classList.contains('active')) return;

  const search = document.getElementById('member-search')?.value || '';

  try {
    const params = new URLSearchParams({ search });
    const res = await fetch(`/api/discord/guild-members/${guildId}?${params}`);
    if (!res.ok) throw new Error(res.status);
    const data = await res.json();
    membersData = data.members || [];

    const filtered = applyMemberTierFilter(membersData);
    renderMembers(filtered);

    document.getElementById('members-loading').style.display = 'none';
  } catch (err) {
    document.getElementById('members-loading').style.display = 'none';
    document.getElementById('members-error').style.display = 'block';
  }
}

function debouncedSearch() {
  clearTimeout(debounceTimer);
  debounceTimer = setTimeout(loadMembers, 300);
}

// ── Member Roles Modal ─────────────────────────────────────────────────────────
function openMemberRolesModal(discordId, username) {
  const member = membersData?.find(m => m.discordId === discordId);
  if (!member) return;

  const allRoles = mappingData?.availableRoles || [];

  const overlay = document.createElement('div');
  overlay.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,0.6);z-index:999;display:flex;align-items:center;justify-content:center;';
  overlay.onclick = (e) => { if (e.target === overlay) overlay.remove(); };

  const currentRoleIds = new Set(member.roles || []);

  overlay.innerHTML = `
  <div style="background:var(--bg);border:1px solid var(--border);border-radius:12px;padding:1.5rem;max-width:480px;width:90%;max-height:80vh;overflow-y:auto;">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1.25rem;">
      <h3 style="font-size:1rem;font-weight:700;">Manage Roles — ${username}</h3>
      <button onclick="this.closest('[style*=&quot;position:fixed&quot;]').remove()" style="background:none;border:none;color:var(--muted);font-size:1.25rem;cursor:pointer;">✕</button>
    </div>
    <p style="font-size:0.8rem;color:var(--muted);margin-bottom:1rem;">Toggle Discord roles for this member. Changes apply immediately.</p>
    <div id="modal-roles-list">
      ${allRoles.length === 0 ? '<p style="color:var(--muted);font-size:0.85rem;">No roles found in this server.</p>' : allRoles.map(role => {
        const has = currentRoleIds.has(role.id);
        return `<div style="display:flex;align-items:center;justify-content:space-between;padding:0.625rem 0.75rem;background:var(--surface);border:1px solid var(--border);border-radius:8px;margin-bottom:0.5rem;">
          <span style="font-weight:600;font-size:0.875rem;">${role.name}</span>
          <button onclick="toggleMemberRole('${discordId}', '${role.id}', ${!has})" class="${has ? 'btn-discord' : 'btn-ghost'}" style="font-size:0.78rem;">
            ${has ? 'Remove' : 'Add'}
          </button>
        </div>`;
      }).join('')}
    </div>
  </div>`;

  document.body.appendChild(overlay);
}

async function toggleMemberRole(discordId, roleId, shouldAdd) {
  try {
    const res = await fetch(`/api/discord/guild-members/${guildId}/roles`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ discordId, action: shouldAdd ? 'add' : 'remove', roleId }),
    });
    if (!res.ok) throw new Error('Failed to update role');

    // Update local member data
    if (membersData) {
      const m = membersData.find(m => m.discordId === discordId);
      if (m) {
        if (shouldAdd) m.roles = [...new Set([...m.roles, roleId])];
        else m.roles = m.roles.filter(r => r !== roleId);
      }
    }

    // Re-open modal with updated roles
    const modal = document.querySelector('[style*="position:fixed"]');
    const username = membersData?.find(m => m.discordId === discordId)?.username || 'Member';
    modal?.remove();
    openMemberRolesModal(discordId, username);
  } catch (err) {
    alert('Failed to update role: ' + err.message);
  }
}

document.addEventListener('DOMContentLoaded', () => {
  loadServerData();
  renderLogs('all');

  // Load role mappings when tab becomes active
  const mappingObserver = new MutationObserver(() => {
    const panel = document.getElementById('panel-role-mappings');
    if (panel?.classList.contains('active') && !mappingData) loadRoleMappings();
  });
  const tabBar = document.getElementById('tab-bar');
  if (tabBar) mappingObserver.observe(tabBar, { childList: true, subtree: true });

  // Load members when tab becomes active
  const membersObserver = new MutationObserver(() => {
    const panel = document.getElementById('panel-members');
    if (panel?.classList.contains('active') && !membersData) loadMembers();
  });
  if (tabBar) membersObserver.observe(tabBar, { childList: true, subtree: true });
});
</script>
</body>
</html>