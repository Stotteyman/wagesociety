<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  

<%- include('../../partials/head-pwa') %>
  <title>Connect Discord — W.A.G.E. Society</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="stylesheet" href="/css/pages.css">
  <style>
    :root { --discord-accent: #5865F2; --discord-dim: rgba(88,101,242,0.12); }
    body { font-family: 'Space Grotesk', sans-serif; }
    .discord-label {
      display: inline-flex; align-items: center; gap: 0.5rem;
      font-size: 0.7rem; font-weight: 700; letter-spacing: 0.18em;
      text-transform: uppercase; color: var(--discord-accent);
      margin-bottom: 1rem; background: var(--discord-dim);
      border: 1px solid rgba(88,101,242,0.25);
      padding: 0.35rem 0.9rem; border-radius: 100px;
    }
    .dashboard-page { padding: 5rem 3rem; }
    .dashboard-inner { max-width: 900px; margin: 0 auto; }
    .section-title {
      font-size: clamp(2rem, 4vw, 3.25rem); font-weight: 700;
      line-height: 1.1; letter-spacing: -0.03em; margin-bottom: 0.75rem;
    }
    .section-sub { font-size: 1rem; color: var(--muted); max-width: 55ch; line-height: 1.7; margin-bottom: 2.5rem; }
    .dash-card { background: var(--bg-2); border: 1px solid var(--border); border-radius: 12px; padding: 2rem; }
    .step-indicator { display: flex; gap: 0.75rem; margin-bottom: 2rem; }
    .step { display: flex; align-items: center; gap: 0.5rem; font-size: 0.8rem; color: var(--muted); }
    .step.active { color: var(--discord-accent); font-weight: 700; }
    .step.done { color: #4ade80; }
    .step-num { width: 24px; height: 24px; border-radius: 50%; background: var(--surface); border: 1px solid var(--border); display: flex; align-items: center; justify-content: center; font-size: 0.7rem; font-weight: 700; }
    .step.active .step-num { background: var(--discord-accent); border-color: var(--discord-accent); color: #fff; }
    .step.done .step-num { background: #4ade80; border-color: #4ade80; color: #fff; }
    .btn-discord {
      display: inline-flex; align-items: center; gap: 0.5rem;
      background: var(--discord-accent); color: #fff;
      padding: 0.875rem 1.75rem; border-radius: 8px;
      font-size: 1rem; font-weight: 700; text-decoration: none; border: none; cursor: pointer;
      transition: background 0.2s, box-shadow 0.2s; font-family: inherit;
      box-shadow: 0 4px 12px rgba(88,101,242,0.3);
    }
    .btn-discord:hover { background: #4752C4; box-shadow: 0 6px 20px rgba(88,101,242,0.4); }
    .btn-discord:disabled { opacity: 0.5; cursor: not-allowed; }
    .btn-ghost {
      display: inline-flex; align-items: center; gap: 0.4rem;
      background: var(--surface); color: var(--muted);
      padding: 0.5rem 1rem; border-radius: 6px; border: 1px solid var(--border);
      font-size: 0.8rem; font-weight: 600; text-decoration: none; cursor: pointer;
      transition: all 0.2s; font-family: inherit;
    }
    .btn-ghost:hover { color: var(--text); border-color: var(--border-hover); }
    .discord-account-card {
      display: flex; align-items: center; gap: 1rem;
      background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 1rem;
      margin-bottom: 1.5rem;
    }
    .discord-avatar { width: 52px; height: 52px; border-radius: 50%; border: 2px solid var(--discord-accent); }
    .discord-avatar-placeholder { width: 52px; height: 52px; border-radius: 50%; background: var(--discord-dim); display: flex; align-items: center; justify-content: center; font-size: 1.5rem; }
    .discord-account-info { flex: 1; }
    .discord-account-name { font-weight: 700; font-size: 1rem; }
    .discord-account-tag { font-size: 0.8rem; color: var(--muted); }
    .discord-linked-badge { background: rgba(34,197,94,0.15); color: #4ade80; font-size: 0.75rem; font-weight: 700; padding: 0.25rem 0.75rem; border-radius: 100px; }
    .server-list { display: flex; flex-direction: column; gap: 0.75rem; margin-top: 1rem; }
    .server-select-item {
      display: flex; align-items: center; gap: 1rem;
      background: var(--surface); border: 1px solid var(--border);
      border-radius: 10px; padding: 1rem 1.25rem; cursor: pointer;
      transition: border-color 0.2s, background 0.2s;
    }
    .server-select-item:hover { border-color: var(--discord-accent); background: var(--discord-dim); }
    .server-select-item input[type="radio"] { accent-color: var(--discord-accent); width: 18px; height: 18px; }
    .server-select-icon { width: 44px; height: 44px; border-radius: 8px; object-fit: cover; background: var(--bg-2); flex-shrink: 0; }
    .server-select-info { flex: 1; min-width: 0; }
    .server-select-name { font-weight: 600; font-size: 0.95rem; }
    .server-select-role { font-size: 0.75rem; color: var(--muted); margin-top: 0.15rem; }
    .admin-badge { background: rgba(88,101,242,0.15); color: var(--discord-accent); font-size: 0.7rem; font-weight: 700; padding: 0.1rem 0.5rem; border-radius: 4px; margin-left: 0.5rem; }
    .error-msg { padding: 0.875rem 1rem; background: #2d1111; border: 1px solid #7f1d1d; border-radius: 6px; font-size: 0.85rem; color: #fca5a5; margin-top: 1rem; display: none; }
    .info-box { background: rgba(88,101,242,0.08); border: 1px solid rgba(88,101,242,0.2); border-radius: 8px; padding: 1rem 1.25rem; font-size: 0.875rem; color: var(--text); line-height: 1.6; margin-bottom: 1.5rem; }
    .info-box strong { color: var(--discord-accent); }
    .nav-back { display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.85rem; color: var(--muted); text-decoration: none; margin-bottom: 1.5rem; transition: color 0.2s; }
    .nav-back:hover { color: var(--text); }
  </style>
</head>
<body>
<%- include('../../partials/nav') %>

<section class="dashboard-page">
  <div class="dashboard-inner">

    <a href="/dashboard/discord" class="nav-back">← Back to Discord</a>

    <div class="discord-label">Setup</div>
    <h1 class="section-title">Connect Your Discord</h1>
    <p class="section-sub">Link your Discord account and select a server to manage. You must be the server owner or have admin permissions.</p>

    <!-- Step indicator -->
    <div class="step-indicator">
      <div class="step <%= step === 'oauth' ? 'active' : (step === 'select' || step === 'done' ? 'done' : '') %>">
        <div class="step-num">1</div>
        <span>Link Discord</span>
      </div>
      <div style="color:var(--border);">—</div>
      <div class="step <%= step === 'select' ? 'active' : (step === 'done' ? 'done' : '') %>">
        <div class="step-num">2</div>
        <span>Select Server</span>
      </div>
      <div style="color:var(--border);">—</div>
      <div class="step <%= step === 'done' ? 'done' : '' %>">
        <div class="step-num">3</div>
        <span>Install Bot</span>
      </div>
    </div>

    <% if (step === 'oauth') { %>
    <!-- Step 1: Link Discord account -->
    <div class="dash-card">
      <h2 class="dash-card-title" style="font-size:1.2rem;margin-bottom:1rem;">Step 1: Connect Your Discord Account</h2>

      <% if (discordLink) { %>
      <div class="discord-account-card">
        <% if (discordLink.discord_avatar) { %>
          <img src="https://cdn.discordapp.com/avatars/<%= discordLink.discord_id %>/<%= discordLink.discord_avatar %>.png" class="discord-avatar" alt="Discord avatar">
        <% } else { %>
          <div class="discord-avatar-placeholder">👤</div>
        <% } %>
        <div class="discord-account-info">
          <div class="discord-account-name"><%= discordLink.discord_username || 'Connected Account' %></div>
          <div class="discord-account-tag">Discord ID: <%= discordLink.discord_id %></div>
        </div>
        <span class="discord-linked-badge">✓ Linked</span>
      </div>
      <a href="/dashboard/discord/connect?step=select" class="btn-discord" style="margin-top:0.5rem;">Continue to Server Selection →</a>

      <% } else { %>
      <div class="info-box">
        <strong>What this does:</strong> Authorizing W.A.G.E. Society to read your Discord profile (username, avatar, guild list). We store only your Discord user ID — we never post messages or read server content without explicit server ownership.
      </div>
      <button class="btn-discord" id="oauth-btn" onclick="startOAuth()">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057.1 18.08.112 18.1.13 18.11a19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03z"/></svg>
        Authorize with Discord
      </button>
      <div id="oauth-loading" style="display:none;margin-top:1rem;font-size:0.85rem;color:var(--muted);">Redirecting to Discord…</div>
      <div id="oauth-error" class="error-msg"></div>
      <% } %>
    </div>

    <% } else if (step === 'select') { %>
    <!-- Step 2: Select server to manage -->
    <div class="dash-card">
      <h2 class="dash-card-title" style="font-size:1.2rem;margin-bottom:0.5rem;">Step 2: Select a Server to Manage</h2>
      <p style="font-size:0.875rem;color:var(--muted);margin-bottom:1.5rem;">Only servers where you have <strong>Administrator</strong> or <strong>Owner</strong> permissions are shown.</p>

      <% if (servers && servers.length > 0) { %>
      <div id="server-list" class="server-list">
        <% for (const server of servers) { %>
        <label class="server-select-item">
          <input type="radio" name="selected-server" value="<%= server.guild_id %>" data-name="<%= server.name %>">
          <% if (server.icon_url) { %>
            <img src="<%= server.icon_url %>" class="server-select-icon" alt="<%= server.name %>">
          <% } else { %>
            <div class="server-select-icon" style="display:flex;align-items:center;justify-content:center;font-size:1.2rem;">🤖</div>
          <% } %>
          <div class="server-select-info">
            <div class="server-select-name"><%= server.name || 'Unnamed Server' %><span class="admin-badge">OWNER</span></div>
            <div class="server-select-role">
              <% if (server.connected_at) { %>
                Bot installed · Connected
              <% } else { %>
                Bot not yet installed
              <% } %>
            </div>
          </div>
        </label>
        <% } %>
      </div>

      <div style="margin-top:1.5rem;display:flex;gap:0.75rem;flex-wrap:wrap;align-items:center;">
        <button class="btn-discord" id="install-btn" onclick="installBot()" disabled>Install Bot →</button>
        <span id="selection-hint" style="font-size:0.8rem;color:var(--muted);">Select a server above</span>
      </div>
      <div id="install-result" style="margin-top:1rem;display:none;">
        <div class="info-box" id="install-note" style="margin-bottom:0;"></div>
        <a href="#" id="install-link" target="_blank" class="btn-discord">Open Discord to Add Bot →</a>
      </div>
      <div id="install-error" class="error-msg"></div>

      <% } else { %>
      <div style="text-align:center;padding:3rem 2rem;color:var(--muted);">
        <div style="font-size:2.5rem;margin-bottom:1rem;">🤖</div>
        <p style="font-size:1rem;font-weight:600;margin-bottom:0.5rem;">No eligible servers found</p>
        <p style="font-size:0.85rem;">You must be the Owner or have Administrator permissions in a Discord server to use W.A.G.E. Society's bot features.</p>
        <div style="margin-top:1.5rem;">
          <a href="/dashboard/discord" class="btn-ghost">← Back</a>
        </div>
      </div>
      <% } %>
    </div>

    <div class="dash-card" style="margin-top:1.5rem;background:var(--surface);border-color:rgba(88,101,242,0.15);">
      <p style="font-size:0.85rem;color:var(--muted);line-height:1.6;">
        <strong style="color:var(--discord-accent);">Privacy note:</strong> W.A.G.E. Society only reads your Discord username, avatar, and server membership list. We do not read messages, channels, or member data beyond what's needed for membership role sync. Your Discord OAuth token is encrypted at rest and never shared.
      </p>
    </div>

    <% } else if (step === 'done') { %>
    <!-- Step 3: Done / success -->
    <div class="dash-card" style="text-align:center;padding:3rem 2rem;">
      <div style="font-size:4rem;margin-bottom:1rem;">🎉</div>
      <h2 style="font-size:1.5rem;font-weight:700;margin-bottom:0.75rem;">Discord Connected!</h2>
      <p style="color:var(--muted);margin-bottom:2rem;">Your Discord account is linked and the bot is installed on your server.</p>
      <div style="display:flex;gap:0.75rem;justify-content:center;flex-wrap:wrap;">
        <a href="/dashboard/discord" class="btn-discord">Go to Dashboard</a>
        <a href="/dashboard/discord/<%= servers && servers[0] ? servers[0].guild_id : '' %>" class="btn-ghost">Manage Server</a>
      </div>
    </div>
    <% } %>

  </div>
</section>

<%- include('../../partials/footer') %>

<script>
const serverRadios = document.querySelectorAll('input[name="selected-server"]');
const installBtn = document.getElementById('install-btn');
const selectionHint = document.getElementById('selection-hint');

if (serverRadios.length) {
  serverRadios.forEach(radio => {
    radio.addEventListener('change', () => {
      installBtn.disabled = false;
      selectionHint.textContent = `Selected: ${radio.dataset.name}`;
    });
  });
}

async function startOAuth() {
  const btn = document.getElementById('oauth-btn');
  const loading = document.getElementById('oauth-loading');
  const err = document.getElementById('oauth-error');
  btn.disabled = true;
  loading.style.display = 'block';
  err.style.display = 'none';

  try {
    const res = await fetch('/auth/discord');
    if (res.redirected) {
      window.location.href = res.url;
    } else {
      const data = await res.json();
      if (data.url) window.location.href = data.url;
      else throw new Error(data.error || 'OAuth failed');
    }
  } catch (e) {
    err.textContent = e.message || 'Failed to start OAuth';
    err.style.display = 'block';
    btn.disabled = false;
    loading.style.display = 'none';
  }
}

async function installBot() {
  const selected = document.querySelector('input[name="selected-server"]:checked');
  if (!selected) return;

  const guildId = selected.value;
  const guildName = selected.dataset.name;
  const btn = document.getElementById('install-btn');
  const err = document.getElementById('install-error');
  btn.disabled = true;
  err.style.display = 'none';

  try {
    const res = await fetch('/api/discord-servers/generate-install-url', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ guildId, guildName }),
    });
    const data = await res.json();
    if (!res.ok) throw new Error(data.error || 'Failed');

    document.getElementById('install-note').textContent = data.note || 'Add the W.A.G.E. Society bot to your server with ADMINISTRATOR permissions.';
    document.getElementById('install-link').href = data.installUrl;
    document.getElementById('install-result').style.display = 'block';
    btn.textContent = '✓ Link Generated';
  } catch (e) {
    err.textContent = e.message || 'Failed to generate install link';
    err.style.display = 'block';
    btn.disabled = false;
  }
}
</script>
</body>
</html>