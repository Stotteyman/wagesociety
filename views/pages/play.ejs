<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <%- include('../partials/head-pwa') %>
  <title>WAGE World - Playable Creator Village</title>
  <meta name="description" content="Explore WAGE World as a playable 3D creator village with a controllable character.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700;800;900&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="stylesheet" href="/vendor/lil-gui/dist/lil-gui.min.css">
  <style>
    :root {
      color-scheme: dark;
      --ww-bg: #07080b;
      --ww-panel: rgba(9, 11, 16, 0.72);
      --ww-line: rgba(255, 255, 255, 0.12);
      --ww-text: #f8fafc;
      --ww-muted: #98a2b3;
      --ww-gold: #f59e0b;
      --ww-cyan: #18c7d5;
      --ww-green: #22c55e;
      --ww-violet: #8b5cf6;
    }

    * { box-sizing: border-box; }
    html, body { width: 100%; min-height: 100%; margin: 0; }
    body {
      overflow: hidden;
      background: var(--ww-bg);
      color: var(--ww-text);
      font-family: Inter, system-ui, sans-serif;
    }

    .wageworld {
      position: fixed;
      inset: 0;
      min-width: 320px;
      background: #07080b;
    }

    #wageworld-canvas {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      display: block;
      touch-action: none;
    }

    .ww-topbar {
      position: absolute;
      z-index: 5;
      top: max(16px, env(safe-area-inset-top));
      left: max(16px, env(safe-area-inset-left));
      right: max(16px, env(safe-area-inset-right));
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      pointer-events: none;
    }

    .ww-brand,
    .ww-stat,
    .ww-panel,
    .ww-loading {
      background: var(--ww-panel);
      border: 1px solid var(--ww-line);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      box-shadow: 0 18px 60px rgba(0, 0, 0, 0.28);
    }

    .ww-brand {
      display: flex;
      align-items: center;
      gap: 12px;
      min-width: 0;
      padding: 10px 12px;
      border-radius: 8px;
    }

    .ww-mark {
      width: 40px;
      height: 40px;
      display: grid;
      place-items: center;
      flex: 0 0 auto;
      border-radius: 8px;
      background: #111318;
      border: 1px solid rgba(245, 158, 11, 0.35);
      color: var(--ww-gold);
      font-family: "Space Grotesk", system-ui, sans-serif;
      font-size: 20px;
      font-weight: 900;
    }

    .ww-brand-title {
      margin: 0;
      font-family: "Space Grotesk", system-ui, sans-serif;
      font-size: 18px;
      line-height: 1;
      letter-spacing: 0;
    }

    .ww-brand-sub {
      margin: 5px 0 0;
      color: var(--ww-muted);
      font-size: 12px;
      line-height: 1.2;
      white-space: nowrap;
    }

    .ww-stats {
      display: flex;
      align-items: center;
      gap: 10px;
      pointer-events: auto;
    }

    .ww-stat {
      min-width: 132px;
      padding: 10px 12px;
      border-radius: 8px;
    }

    .ww-stat-label {
      display: block;
      color: var(--ww-muted);
      font-size: 11px;
      font-weight: 700;
      line-height: 1.2;
      text-transform: uppercase;
    }

    .ww-stat-value {
      display: block;
      margin-top: 4px;
      font-family: "Space Grotesk", system-ui, sans-serif;
      font-size: 17px;
      font-weight: 800;
      line-height: 1.1;
      color: var(--ww-text);
    }

    .ww-panel {
      position: absolute;
      z-index: 5;
      left: max(16px, env(safe-area-inset-left));
      bottom: max(16px, env(safe-area-inset-bottom));
      width: min(520px, calc(100vw - 32px));
      padding: 14px;
      border-radius: 8px;
      pointer-events: auto;
    }

    .ww-controls {
      position: absolute;
      z-index: 6;
      right: max(16px, env(safe-area-inset-right));
      bottom: max(72px, calc(env(safe-area-inset-bottom) + 72px));
      display: none;
      grid-template-columns: repeat(3, 52px);
      grid-template-rows: repeat(3, 52px);
      gap: 8px;
      pointer-events: auto;
    }

    .ww-move {
      width: 52px;
      height: 52px;
      border: 1px solid rgba(255, 255, 255, 0.14);
      border-radius: 8px;
      background: rgba(9, 11, 16, 0.72);
      color: var(--ww-text);
      font: 900 22px/1 Inter, system-ui, sans-serif;
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      touch-action: none;
    }

    .ww-move:active {
      border-color: rgba(245, 158, 11, 0.7);
      background: rgba(245, 158, 11, 0.18);
      color: var(--ww-gold);
    }

    .ww-move[data-move="up"] { grid-column: 2; grid-row: 1; }
    .ww-move[data-move="left"] { grid-column: 1; grid-row: 2; }
    .ww-move[data-move="right"] { grid-column: 3; grid-row: 2; }
    .ww-move[data-move="down"] { grid-column: 2; grid-row: 3; }

    .ww-panel h2 {
      margin: 0 0 8px;
      font-family: "Space Grotesk", system-ui, sans-serif;
      font-size: 22px;
      line-height: 1;
      letter-spacing: 0;
    }

    .ww-panel p {
      margin: 0 0 14px;
      max-width: 58ch;
      color: var(--ww-muted);
      font-size: 13px;
      line-height: 1.55;
    }

    .ww-districts {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 8px;
    }

    .ww-district {
      min-width: 0;
      min-height: 42px;
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 8px;
      background: rgba(255, 255, 255, 0.045);
      color: var(--ww-text);
      cursor: pointer;
      font: 700 12px/1.15 Inter, system-ui, sans-serif;
      transition: border-color 160ms ease, background 160ms ease, color 160ms ease;
    }

    .ww-district:hover,
    .ww-district.is-active {
      border-color: rgba(245, 158, 11, 0.65);
      background: rgba(245, 158, 11, 0.12);
      color: #fff7ed;
    }

    .ww-link {
      position: absolute;
      z-index: 6;
      right: max(16px, env(safe-area-inset-right));
      bottom: max(16px, env(safe-area-inset-bottom));
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 42px;
      padding: 0 14px;
      border-radius: 8px;
      border: 1px solid rgba(255, 255, 255, 0.12);
      background: rgba(9, 11, 16, 0.72);
      color: var(--ww-text);
      font-size: 13px;
      font-weight: 800;
      text-decoration: none;
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
    }

    .ww-link:hover {
      border-color: rgba(245, 158, 11, 0.7);
      color: var(--ww-gold);
    }

    .ww-loading {
      position: absolute;
      z-index: 8;
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%);
      display: grid;
      place-items: center;
      width: min(300px, calc(100vw - 32px));
      padding: 22px;
      border-radius: 8px;
      text-align: center;
      transition: opacity 240ms ease, visibility 240ms ease;
    }

    .ww-loading.is-hidden {
      opacity: 0;
      visibility: hidden;
    }

    .ww-login-prompt {
      position: absolute;
      z-index: 7;
      left: 50%;
      top: max(92px, calc(env(safe-area-inset-top) + 92px));
      transform: translateX(-50%);
      width: min(440px, calc(100vw - 32px));
      padding: 14px;
      border-radius: 8px;
      background: var(--ww-panel);
      border: 1px solid rgba(245, 158, 11, 0.38);
      color: var(--ww-text);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      box-shadow: 0 18px 60px rgba(0, 0, 0, 0.32);
      pointer-events: auto;
    }

    .ww-login-prompt[hidden] {
      display: none;
    }

    .ww-login-prompt h2 {
      margin: 0 0 6px;
      font-family: "Space Grotesk", system-ui, sans-serif;
      font-size: 20px;
      line-height: 1.05;
    }

    .ww-login-prompt p {
      margin: 0 0 12px;
      color: var(--ww-muted);
      font-size: 13px;
      line-height: 1.45;
    }

    .ww-login-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 40px;
      padding: 0 14px;
      border-radius: 8px;
      background: var(--ww-gold);
      color: #111318;
      font: 900 13px/1 Inter, system-ui, sans-serif;
      text-decoration: none;
    }

    .ww-interact-prompt {
      position: absolute;
      z-index: 7;
      left: 50%;
      bottom: max(172px, calc(env(safe-area-inset-bottom) + 172px));
      transform: translateX(-50%);
      min-height: 40px;
      max-width: min(520px, calc(100vw - 32px));
      padding: 10px 14px;
      border-radius: 8px;
      background: rgba(9, 11, 16, 0.82);
      border: 1px solid rgba(245, 158, 11, 0.45);
      color: var(--ww-text);
      font: 800 13px/1.35 Inter, system-ui, sans-serif;
      text-align: center;
      pointer-events: none;
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
    }

    .ww-interact-prompt[hidden] {
      display: none;
    }

    .ww-comms {
      position: absolute;
      z-index: 6;
      right: max(16px, env(safe-area-inset-right));
      bottom: max(16px, env(safe-area-inset-bottom));
      width: min(360px, calc(100vw - 32px));
      padding: 12px;
      border-radius: 8px;
      background: var(--ww-panel);
      border: 1px solid var(--ww-line);
      color: var(--ww-text);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      box-shadow: 0 18px 60px rgba(0, 0, 0, 0.28);
      pointer-events: auto;
    }

    .ww-comms-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      margin-bottom: 8px;
    }

    .ww-comms-title {
      margin: 0;
      font-family: "Space Grotesk", system-ui, sans-serif;
      font-size: 16px;
      line-height: 1;
    }

    .ww-voice-btn {
      min-height: 34px;
      border: 1px solid rgba(255, 255, 255, 0.14);
      border-radius: 8px;
      background: rgba(255, 255, 255, 0.055);
      color: var(--ww-text);
      cursor: pointer;
      padding: 0 10px;
      font: 900 12px/1 Inter, system-ui, sans-serif;
    }

    .ww-voice-btn.is-on {
      border-color: rgba(34, 197, 94, 0.8);
      background: rgba(34, 197, 94, 0.18);
      color: #bbf7d0;
    }

    .ww-chat-log {
      height: 118px;
      overflow-y: auto;
      display: grid;
      align-content: end;
      gap: 6px;
      padding: 8px;
      border-radius: 8px;
      background: rgba(0, 0, 0, 0.18);
      color: var(--ww-muted);
      font-size: 12px;
      line-height: 1.35;
    }

    .ww-chat-message strong {
      color: var(--ww-text);
    }

    .ww-chat-form {
      display: flex;
      gap: 8px;
      margin-top: 8px;
    }

    .ww-chat-form input {
      flex: 1;
      min-width: 0;
      min-height: 38px;
      border: 1px solid rgba(255, 255, 255, 0.14);
      border-radius: 8px;
      background: rgba(255, 255, 255, 0.055);
      color: var(--ww-text);
      padding: 0 10px;
      font: 700 13px/1 Inter, system-ui, sans-serif;
    }

    .ww-chat-form button {
      min-width: 58px;
      border: 1px solid rgba(245, 158, 11, 0.55);
      border-radius: 8px;
      background: rgba(245, 158, 11, 0.16);
      color: var(--ww-gold);
      cursor: pointer;
      font: 900 12px/1 Inter, system-ui, sans-serif;
    }

    .ww-comms-status {
      margin-top: 8px;
      color: var(--ww-muted);
      font-size: 11px;
      line-height: 1.35;
    }

    .ww-loader-ring {
      width: 56px;
      height: 56px;
      margin-bottom: 14px;
      border: 3px solid rgba(245, 158, 11, 0.18);
      border-top-color: var(--ww-gold);
      border-radius: 999px;
      animation: ww-spin 900ms linear infinite;
    }

    .ww-loading strong {
      display: block;
      font-family: "Space Grotesk", system-ui, sans-serif;
      font-size: 18px;
      line-height: 1.2;
    }

    .ww-loading span {
      display: block;
      margin-top: 6px;
      color: var(--ww-muted);
      font-size: 12px;
      line-height: 1.4;
    }

    .ww-actions {
      position: absolute;
      z-index: 7;
      right: max(16px, env(safe-area-inset-right));
      top: max(92px, calc(env(safe-area-inset-top) + 92px));
      display: flex;
      gap: 8px;
      pointer-events: auto;
    }

    .ww-menu-open .ww-actions {
      display: none;
    }

    .ww-menu-open .ww-controls {
      display: none;
    }

    .ww-icon-btn,
    .ww-settings-close {
      min-width: 42px;
      min-height: 42px;
      border: 1px solid rgba(255, 255, 255, 0.14);
      border-radius: 8px;
      background: rgba(9, 11, 16, 0.76);
      color: var(--ww-text);
      cursor: pointer;
      font: 900 18px/1 Inter, system-ui, sans-serif;
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
    }

    .ww-cog::before {
      content: "\2699";
      display: inline-block;
      font-size: 22px;
      line-height: 1;
    }

    .ww-char-btn {
      min-width: 58px;
      font-size: 13px;
    }

    .ww-icon-btn:hover,
    .ww-settings-close:hover {
      border-color: rgba(245, 158, 11, 0.7);
      color: var(--ww-gold);
    }

    .ww-settings,
    .ww-character {
      position: absolute;
      z-index: 8;
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%);
      width: min(560px, calc(100vw - 32px));
      max-height: min(760px, calc(100vh - 32px));
      overflow-y: auto;
      padding: 14px;
      border-radius: 8px;
      background: var(--ww-panel);
      border: 1px solid var(--ww-line);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      box-shadow: 0 18px 60px rgba(0, 0, 0, 0.32);
      pointer-events: auto;
    }

    .ww-settings[hidden],
    .ww-character[hidden] {
      display: none;
    }

    .ww-settings-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 12px;
    }

    .ww-settings h2,
    .ww-character h2 {
      margin: 0;
      font-family: "Space Grotesk", system-ui, sans-serif;
      font-size: 20px;
      line-height: 1;
    }

    .ww-setting {
      display: grid;
      gap: 8px;
      margin-top: 12px;
      color: var(--ww-muted);
      font-size: 13px;
      font-weight: 700;
    }

    .ww-settings-section {
      margin-top: 14px;
      padding-top: 12px;
      border-top: 1px solid rgba(255, 255, 255, 0.1);
    }

    .ww-settings-section h3 {
      margin: 0 0 8px;
      color: var(--ww-text);
      font-family: "Space Grotesk", system-ui, sans-serif;
      font-size: 15px;
      line-height: 1;
    }

    .ww-setting-help {
      margin: 6px 0 0;
      color: var(--ww-muted);
      font-size: 12px;
      line-height: 1.4;
    }

    .ww-setting input[type="range"] {
      width: 100%;
      accent-color: var(--ww-gold);
    }

    .ww-setting select {
      width: 100%;
      min-height: 40px;
      border: 1px solid rgba(255, 255, 255, 0.14);
      border-radius: 8px;
      background: rgba(255, 255, 255, 0.055);
      color: var(--ww-text);
      padding: 0 10px;
      font: 700 13px/1 Inter, system-ui, sans-serif;
    }

    .ww-setting-check {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }

    .ww-setting-check input {
      width: 20px;
      height: 20px;
      accent-color: var(--ww-gold);
    }

    .ww-setting-actions {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
      margin-top: 14px;
    }

    .ww-setting-action {
      min-height: 40px;
      border: 1px solid rgba(255, 255, 255, 0.14);
      border-radius: 8px;
      background: rgba(255, 255, 255, 0.055);
      color: var(--ww-text);
      cursor: pointer;
      font: 800 12px/1.1 Inter, system-ui, sans-serif;
    }

    .ww-setting-action:hover {
      border-color: rgba(245, 158, 11, 0.7);
      color: var(--ww-gold);
    }

    .ww-color-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
      margin-top: 12px;
    }

    .ww-character-field {
      display: grid;
      gap: 7px;
      color: var(--ww-muted);
      font-size: 13px;
      font-weight: 700;
    }

    .ww-character-field input[type="text"] {
      width: 100%;
      min-height: 40px;
      border: 1px solid rgba(255, 255, 255, 0.14);
      border-radius: 8px;
      background: rgba(255, 255, 255, 0.055);
      color: var(--ww-text);
      padding: 0 10px;
      font: 700 13px/1 Inter, system-ui, sans-serif;
    }

    .ww-character-field input[type="color"] {
      width: 100%;
      height: 40px;
      border: 1px solid rgba(255, 255, 255, 0.14);
      border-radius: 8px;
      background: rgba(255, 255, 255, 0.055);
      padding: 4px;
      cursor: pointer;
    }

    @keyframes ww-spin {
      to { transform: rotate(360deg); }
    }

    @media (max-width: 820px) {
      .ww-topbar {
        align-items: stretch;
        flex-direction: column;
      }

      .ww-stats {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .ww-stat {
        min-width: 0;
      }

      .ww-panel {
        padding: 12px;
      }

      .ww-panel h2 {
        font-size: 18px;
      }

      .ww-panel p {
        display: none;
      }

      .ww-districts {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .ww-link {
        display: none;
      }

      .ww-comms {
        left: 16px;
        right: 16px;
        bottom: 16px;
        width: auto;
      }

      .ww-chat-log {
        height: 86px;
      }

      .ww-controls {
        display: grid;
        bottom: max(222px, calc(env(safe-area-inset-bottom) + 222px));
      }

      .ww-actions {
        top: auto;
        right: max(16px, env(safe-area-inset-right));
        bottom: max(16px, env(safe-area-inset-bottom));
      }

      .ww-settings,
      .ww-character {
        width: calc(100vw - 32px);
        max-height: calc(100vh - 32px);
      }

      .ww-login-prompt {
        top: 226px;
      }
    }

    @media (max-width: 520px) {
      .ww-brand-sub {
        white-space: normal;
      }

      .ww-stat:nth-child(2) {
        display: none;
      }

      .ww-stats {
        grid-template-columns: 1fr;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .ww-loader-ring {
        animation: none;
      }
    }
  </style>
  <script type="importmap">
    {
      "imports": {
        "three": "/vendor/three/build/three.module.js",
        "three/addons/": "/vendor/three/examples/jsm/"
      }
    }
  </script>
</head>
<body>
  <main class="wageworld" aria-label="WAGE World 3D creator city">
    <canvas id="wageworld-canvas" aria-label="Interactive 3D model of WAGE World"></canvas>
    <script>
      window.WAGEWORLD_BOOTSTRAP = <%- JSON.stringify({
        isAuthenticated: !!userEmail,
        userEmail: userEmail || null
      }) %>;
    </script>

    <div class="ww-topbar">
      <section class="ww-brand" aria-label="WAGE World">
        <div class="ww-mark" aria-hidden="true">W</div>
        <div>
          <h1 class="ww-brand-title">WAGE World</h1>
          <p class="ww-brand-sub">Playable creator village</p>
        </div>
      </section>

      <section class="ww-stats" aria-label="World status">
        <div class="ww-stat">
          <span class="ww-stat-label">Focus</span>
          <span class="ww-stat-value" data-focus-label>Creator Plaza</span>
        </div>
        <div class="ww-stat">
          <span class="ww-stat-label">Status</span>
          <span class="ww-stat-value" data-focus-value>Network core</span>
        </div>
        <div class="ww-stat">
          <span class="ww-stat-label">Rewards</span>
          <span class="ww-stat-value" data-resource-value>$12,840</span>
        </div>
      </section>
    </div>

    <section class="ww-panel" aria-label="District controls">
      <h2>Walk through WAGE World</h2>
      <p>Use WASD or arrow keys to move relative to your character. Hold Shift to sprint. Right-drag with a mouse, drag on touchscreens, or use a controller stick to rotate the camera.</p>
      <div class="ww-districts">
        <button class="ww-district is-active" type="button" data-district="Spawn House">Spawn House</button>
        <button class="ww-district" type="button" data-district="Creator Plaza">Creator Plaza</button>
        <button class="ww-district" type="button" data-district="Market Row">Market Row</button>
        <button class="ww-district" type="button" data-district="Live Arena">Live Arena</button>
        <button class="ww-district" type="button" data-district="Guild Tower">Guild Tower</button>
        <button class="ww-district" type="button" data-district="Reward Works">Reward Works</button>
      </div>
    </section>

    <section class="ww-login-prompt" data-login-prompt hidden aria-label="WAGE Society login prompt">
      <h2>Log in at the computer</h2>
      <p>You are in your spawn house. Use the computer to log in before leaving for other WageWorld maps.</p>
      <a class="ww-login-btn" href="/login?next=/wageworld" data-login-link>Log in to WAGE Society</a>
    </section>

    <div class="ww-actions" aria-label="World actions">
      <button class="ww-icon-btn ww-cog" type="button" data-settings-toggle aria-controls="wageworld-settings" aria-expanded="false" title="Open settings" aria-label="Open settings"></button>
    </div>

    <section class="ww-settings" id="wageworld-settings" data-settings-menu hidden aria-label="Settings">
      <div class="ww-settings-head">
        <h2>Settings</h2>
        <button class="ww-settings-close" type="button" data-settings-close aria-label="Close settings">X</button>
      </div>
      <div class="ww-settings-section">
        <h3>Gameplay</h3>
        <label class="ww-setting">
          Walk speed
          <input type="range" min="3" max="12" step="0.25" value="7" data-setting="speed">
        </label>
        <label class="ww-setting">
          Guide animation
          <input type="range" min="0" max="2" step="0.1" value="1" data-setting="npcEnergy">
        </label>
      </div>
      <div class="ww-settings-section">
        <h3>Camera</h3>
        <label class="ww-setting">
          Mouse / touch sensitivity
          <input type="range" min="0.002" max="0.014" step="0.001" value="0.006" data-setting="cameraSensitivity">
        </label>
        <label class="ww-setting">
          Controller look sensitivity
          <input type="range" min="1" max="6" step="0.1" value="2.8" data-setting="gamepadSensitivity">
        </label>
        <label class="ww-setting">
          Camera distance
          <input type="range" min="6" max="18" step="0.5" value="10" data-setting="followDistance">
        </label>
        <label class="ww-setting">
          Camera height
          <input type="range" min="4" max="12" step="0.5" value="7" data-setting="followHeight">
        </label>
        <label class="ww-setting ww-setting-check">
          Invert camera Y
          <input type="checkbox" data-setting="invertY">
        </label>
      </div>
      <div class="ww-settings-section">
        <h3>Audio & Voice</h3>
        <label class="ww-setting">
          Microphone
          <select data-voice-input></select>
        </label>
        <label class="ww-setting">
          Speaker
          <select data-voice-output></select>
        </label>
        <label class="ww-setting">
          Master volume
          <input type="range" min="0" max="1" step="0.05" value="0.85" data-setting="masterVolume">
        </label>
        <label class="ww-setting">
          Voice volume
          <input type="range" min="0" max="1" step="0.05" value="0.9" data-setting="voiceVolume">
        </label>
        <p class="ww-setting-help">Voice chat uses proximity. You only connect to players close to you on the same map.</p>
      </div>
      <div class="ww-settings-section">
        <h3>Controller</h3>
        <label class="ww-setting ww-setting-check">
          Enable controller input
          <input type="checkbox" checked data-setting="controllerEnabled">
        </label>
        <label class="ww-setting">
          Stick deadzone
          <input type="range" min="0.05" max="0.4" step="0.01" value="0.16" data-setting="controllerDeadzone">
        </label>
        <p class="ww-setting-help">Left stick moves, right stick rotates the camera, and left-stick press or the primary face button sprints.</p>
      </div>
      <div class="ww-settings-section">
        <h3>Account & World</h3>
        <p class="ww-setting-help">Guests can explore. Logging in enables saved progress, subscriptions, private spaces, and creator tools.</p>
      </div>
      <div class="ww-setting-actions">
        <button class="ww-setting-action" type="button" data-reset-player>Reset position</button>
        <button class="ww-setting-action" type="button" data-fullscreen>Fullscreen</button>
      </div>
    </section>

    <section class="ww-character" id="wageworld-character" data-character-menu hidden aria-label="Character creator">
      <div class="ww-settings-head">
        <h2>Character</h2>
        <button class="ww-settings-close" type="button" data-character-close aria-label="Close character creator">X</button>
      </div>
      <label class="ww-character-field">
        Name
        <input type="text" maxlength="18" value="Creator" data-character="name">
      </label>
      <div class="ww-color-grid">
        <label class="ww-character-field">
          Skin
          <input type="color" value="#ffc69d" data-character="skin">
        </label>
        <label class="ww-character-field">
          Shirt
          <input type="color" value="#f59e0b" data-character="shirt">
        </label>
        <label class="ww-character-field">
          Pants
          <input type="color" value="#253047" data-character="pants">
        </label>
        <label class="ww-character-field">
          Hat
          <input type="color" value="#111318" data-character="hat">
        </label>
        <label class="ww-character-field">
          Backpack
          <input type="color" value="#22c55e" data-character="backpack">
        </label>
      </div>
      <div class="ww-setting-actions">
        <button class="ww-setting-action" type="button" data-character-reset>Reset character</button>
      </div>
    </section>

    <div class="ww-interact-prompt" data-interact-prompt hidden></div>

    <section class="ww-comms" aria-label="Proximity chat and voice">
      <div class="ww-comms-head">
        <h2 class="ww-comms-title">Nearby Chat</h2>
        <button class="ww-voice-btn" type="button" data-voice-toggle aria-pressed="false">Voice Off</button>
      </div>
      <div class="ww-chat-log" data-chat-log aria-live="polite">
        <div class="ww-chat-message">Proximity text and voice are local to nearby players.</div>
      </div>
      <form class="ww-chat-form" data-chat-form>
        <input type="text" maxlength="240" autocomplete="off" placeholder="Say something nearby..." data-chat-input>
        <button type="submit">Send</button>
      </form>
      <div class="ww-comms-status" data-comms-status>Connecting to nearby chat...</div>
    </section>

    <div class="ww-controls" aria-label="Movement controls">
      <button class="ww-move" type="button" data-move="up" aria-label="Move forward">^</button>
      <button class="ww-move" type="button" data-move="left" aria-label="Move left">&lt;</button>
      <button class="ww-move" type="button" data-move="right" aria-label="Move right">&gt;</button>
      <button class="ww-move" type="button" data-move="down" aria-label="Move backward">v</button>
    </div>

    <a class="ww-link" href="/">Back to WAGE Society</a>

    <div class="ww-loading" data-wageworld-loading role="status" aria-live="polite">
      <div class="ww-loader-ring" aria-hidden="true"></div>
      <strong>Loading WageWorld</strong>
      <span data-loading-quote>We all gotta eat.</span>
    </div>
  </main>

  <script type="module" src="/js/wageworld.js"></script>
</body>
</html>
