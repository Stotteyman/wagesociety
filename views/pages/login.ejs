<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  

<%- include('../partials/head-pwa') %>
  <title>Sign In — W.A.G.E. Society</title>
  <meta name="description" content="Sign in to your W.A.G.E. Society account. Access your creator dashboard, memberships, and referral tools.">
  <meta property="og:type" content="website">
  <meta property="og:title" content="Sign In — W.A.G.E. Society">
  <meta property="og:description" content="Sign in to your W.A.G.E. Society account. Access your creator dashboard, memberships, and referral tools.">
  <meta property="og:image" content="https://pub-629428d185ca4960a0a73c850d32294b.r2.dev/generated-images/company_142957/eb47d638-137a-4907-b6c0-3bf099c5be80.jpg">
  <meta property="og:url" content="https://wagesociety.com/login">
  <meta property="og:site_name" content="WAGE Society">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Sign In — W.A.G.E. Society">
  <meta name="twitter:description" content="Sign in to your W.A.G.E. Society account. Access your creator dashboard, memberships, and referral tools.">
  <meta name="twitter:image" content="https://pub-629428d185ca4960a0a73c850d32294b.r2.dev/generated-images/company_142957/eb47d638-137a-4907-b6c0-3bf099c5be80.jpg">
  <meta name="auth-fix" content="2026-05-26-fix">
  <meta name="version" content="custom-auth-2026-05-26">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="stylesheet" href="/css/pages.css">
</head>
<body>
  <nav class="nav">
    <div class="nav-inner">
      <a href="/" class="nav-logo">W.A.G.E<span style="color:var(--accent)">.</span></a>
    </div>
  </nav>

  <section class="auth-page">
    <!-- Portal edge glow effect -->
    <div class="auth-portal-glow" aria-hidden="true"></div>
    <div class="auth-card">

      <h1 class="auth-title">Welcome back</h1>
      <p class="auth-sub">Sign in to your W.A.G.E. Society account</p>

      <!-- Tabs -->
      <div class="custom-auth-tabs">
        <button class="auth-tab auth-tab--active" id="tab-signin" onclick="switchTab('signin')">Sign In</button>
        <button class="auth-tab" id="tab-signup" onclick="switchTab('signup')">Create Account</button>
        <button class="auth-tab" id="tab-magic" onclick="switchTab('magic')">Magic Link</button>
      </div>

      <!-- OAuth provider buttons (shown in all tabs) -->
      <div class="oauth-providers">
        <a href="/auth/google" class="oauth-btn oauth-btn--google">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
          </svg>
          Continue with Google
        </a>
        <a href="/auth/kick" class="oauth-btn oauth-btn--kick">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="#53d900" xmlns="http://www.w3.org/2000/svg">
            <circle cx="12" cy="12" r="10" fill="#53d900"/>
            <path d="M16.5 8.5L10 15.5H8.5L7 14V10L16.5 8.5Z" fill="#1a1a1a" stroke="#1a1a1a" stroke-width="0.5" stroke-linejoin="round"/>
          </svg>
          Continue with Kick
        </a>
        <a href="/auth/discord-login" class="oauth-btn oauth-btn--discord">
          <svg width="18" height="18" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03z" fill="#5865F2"/>
          </svg>
          Continue with Discord
        </a>
      </div>

      <div class="oauth-divider"><span>or</span></div>

      <!-- ── Sign In (email + password) ── -->
      <div id="panel-signin">
        <div id="signinError" class="error-msg" style="display:none;margin-bottom:14px;"></div>
        <form id="signinForm" onsubmit="doSignin(event)">
          <input type="email" id="signin-email" placeholder="Email address" required class="auth-input" autocomplete="email" />
          <input type="password" id="signin-password" placeholder="Password" required class="auth-input" autocomplete="current-password" style="margin-top:10px" />
          <button type="submit" class="btn-primary auth-submit" id="signinBtn">Sign In</button>
        </form>
        <p class="auth-alt" style="margin-top:10px">
          Forgot your password? <a href="#" onclick="switchTab('magic');return false" style="color:var(--accent)">Get a login link</a>
        </p>
      </div>

      <!-- ── Create Account ── -->
      <div id="panel-signup" style="display:none">
        <div id="signupError" class="error-msg" style="display:none;margin-bottom:14px;"></div>
        <form id="signupForm" onsubmit="doSignup(event)">
          <input type="email" id="signup-email" placeholder="Email address" required class="auth-input" autocomplete="email" />
          <input type="password" id="signup-password" placeholder="Password (min 8 characters)" required class="auth-input" autocomplete="new-password" minlength="8" style="margin-top:10px" />
          <input type="password" id="signup-confirm" placeholder="Confirm password" required class="auth-input" autocomplete="new-password" style="margin-top:10px" />
          <button type="submit" class="btn-primary auth-submit" id="signupBtn">Create Account</button>
        </form>
      </div>

      <!-- ── Magic Link ── -->
      <div id="panel-magic" style="display:none">
        <div id="magicSuccess" class="auth-success-msg" style="display:none;margin-bottom:14px;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
          <span>Check your email — link sent! It expires in 15 minutes.</span>
        </div>
        <div id="magicError" class="error-msg" style="display:none;margin-bottom:14px;"></div>
        <form id="magicForm" onsubmit="doMagicLink(event)">
          <input type="email" id="magic-email" placeholder="Email address" required class="auth-input" autocomplete="email" />
          <button type="submit" class="btn-primary auth-submit" id="magicBtn">Send Login Link</button>
        </form>
        <p class="auth-alt" style="margin-top:10px">
          Prefer a password? <a href="#" onclick="switchTab('signin');return false" style="color:var(--accent)">Sign in with email + password</a>
        </p>
      </div>

    </div>
  </section>

  <style>
    /* Auth page glassmorphism + portal effect */
    .auth-portal-glow {
      position: fixed;
      top: 0; left: 0; right: 0; bottom: 0;
      pointer-events: none;
      z-index: 0;
      background:
        radial-gradient(ellipse 80% 60% at 50% 0%, rgba(245,158,11,0.08) 0%, transparent 60%),
        radial-gradient(ellipse 60% 50% at 20% 100%, rgba(245,158,11,0.05) 0%, transparent 50%),
        radial-gradient(ellipse 60% 50% at 80% 100%, rgba(245,158,11,0.05) 0%, transparent 50%);
    }
    .auth-page { min-height: 80vh; display: flex; align-items: center; justify-content: center; padding: 4rem 3rem; position: relative; overflow: hidden; }
    .auth-card {
      width: 100%;
      max-width: 440px;
      background: var(--wage-glass-bg);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid var(--wage-border);
      border-radius: var(--wage-radius-card);
      padding: 3rem;
      position: relative;
      z-index: 1;
      box-shadow: var(--wage-glass-shadow), 0 0 80px rgba(245,158,11,0.05);
    }
    .auth-title { font-size: 2rem; font-weight: 800; letter-spacing: -0.03em; margin-bottom: 0.5rem; }
    .auth-sub { color: var(--wage-text-secondary); font-size: 0.95rem; line-height: 1.6; margin-bottom: 2rem; }
    .auth-input {
      width: 100%;
      background: var(--wage-bg-primary);
      border: 1px solid var(--wage-border);
      border-radius: var(--wage-radius-btn);
      padding: 0.875rem 1rem;
      font-family: 'Space Grotesk', system-ui, sans-serif;
      font-size: 16px;
      color: var(--wage-text-primary);
      outline: none;
      transition: border-color 0.2s, box-shadow 0.2s;
      box-sizing: border-box;
    }
    .auth-input:focus {
      border-color: var(--wage-gold);
      box-shadow: 0 0 0 3px rgba(245,158,11,0.15);
    }
    .custom-auth-tabs {
      display: flex;
      gap: 4px;
      margin-bottom: 20px;
      background: rgba(255,255,255,0.05);
      border-radius: 8px;
      padding: 4px;
    }
    .auth-tab {
      flex: 1;
      padding: 8px 12px;
      border: none;
      background: transparent;
      color: var(--text-muted, #888);
      font-family: inherit;
      font-size: 0.85rem;
      font-weight: 500;
      border-radius: 6px;
      cursor: pointer;
      transition: all 0.15s;
    }
    .auth-tab--active {
      background: var(--accent, #ff6600);
      color: #fff;
    }
    .auth-tab:not(.auth-tab--active):hover {
      background: rgba(255,255,255,0.08);
      color: var(--text, #e5e0d8);
    }
    .auth-success-msg {
      display: flex;
      align-items: center;
      gap: 10px;
      background: rgba(80,200,120,0.12);
      border: 1px solid rgba(80,200,120,0.3);
      color: #3a9a60;
      border-radius: 8px;
      padding: 12px 16px;
      font-size: 0.9rem;
    }
    .auth-alt {
      font-size: 0.82rem;
      color: var(--text-muted, #888);
      text-align: center;
    }
    .oauth-providers {
      display: flex;
      flex-direction: column;
      gap: 8px;
      margin-bottom: 16px;
    }
    .oauth-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      padding: 11px 16px;
      border-radius: 8px;
      font-family: inherit;
      font-size: 0.9rem;
      font-weight: 500;
      text-decoration: none;
      transition: opacity 0.15s, transform 0.1s;
      cursor: pointer;
      border: none;
    }
    .oauth-btn:hover { opacity: 0.85; transform: translateY(-1px); }
    .oauth-btn:active { transform: translateY(0); }
    .oauth-btn--google  { background: rgba(255,255,255,0.08); color: var(--fg); border: 1px solid var(--border); }
    .oauth-btn--kick    { background: #1a1a1a; color: #fff; border: 1px solid #333; }
    .oauth-btn--discord { background: #5865F2; color: #fff; }
    .oauth-divider {
      position: relative;
      text-align: center;
      margin-bottom: 16px;
      color: var(--text-muted, #888);
      font-size: 0.82rem;
    }
    .oauth-divider::before,
    .oauth-divider::after {
      content: '';
      position: absolute;
      top: 50%;
      width: 42%;
      height: 1px;
      background: rgba(255,255,255,0.12);
    }
    .oauth-divider::before { left: 0; }
    .oauth-divider::after  { right: 0; }
    .oauth-divider span { background: var(--bg-2); padding: 0 10px; position: relative; }
  </style>

<script>
// ── Tab switching ────────────────────────────────────────────────────────────
function switchTab(tab) {
  const panels = ['signin', 'signup', 'magic'];
  panels.forEach(t => {
    const p = document.getElementById('panel-' + t);
    const b = document.getElementById('tab-' + t);
    if (p) p.style.display = t === tab ? '' : 'none';
    if (b) b.classList.toggle('auth-tab--active', t === tab);
  });
  // Clear errors
  ['signinError', 'signupError', 'magicError', 'magicSuccess'].forEach(id => {
    var el = document.getElementById(id);
    if (el) el.style.display = 'none';
  });
}

// ── Error helpers ───────────────────────────────────────────────────────────
function showError(id, msg) {
  var el = document.getElementById(id);
  if (el) { el.textContent = msg; el.style.display = ''; }
}

function hideError(id) {
  var el = document.getElementById(id);
  if (el) el.style.display = 'none';
}

// ── Sign In ─────────────────────────────────────────────────────────────────
async function doSignin(e) {
  e.preventDefault();
  var email = document.getElementById('signin-email').value.trim();
  var password = document.getElementById('signin-password').value;
  var btn = document.getElementById('signinBtn');

  hideError('signinError');
  btn.disabled = true;
  btn.textContent = 'Signing in\u2026';

  try {
    var r = await fetch('/auth/login', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email: email, password: password }),
    });
    var data = await r.json();
    if (data.ok) {
      window.location.href = data.redirect || '/dashboard';
    } else {
      showError('signinError', data.error || 'Sign in failed. Try again.');
      btn.disabled = false;
      btn.textContent = 'Sign In';
    }
  } catch (_) {
    showError('signinError', 'Network error. Check your connection and try again.');
    btn.disabled = false;
    btn.textContent = 'Sign In';
  }
}

// ── Sign Up ─────────────────────────────────────────────────────────────────
async function doSignup(e) {
  e.preventDefault();
  var email = document.getElementById('signup-email').value.trim();
  var password = document.getElementById('signup-password').value;
  var confirm = document.getElementById('signup-confirm').value;
  var btn = document.getElementById('signupBtn');

  hideError('signupError');

  if (password !== confirm) {
    showError('signupError', 'Passwords do not match.');
    return;
  }
  if (password.length < 8) {
    showError('signupError', 'Password must be at least 8 characters.');
    return;
  }

  btn.disabled = true;
  btn.textContent = 'Creating account\u2026';

  try {
    var r = await fetch('/auth/signup', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email: email, password: password }),
    });
    var data = await r.json();
    if (data.ok) {
      window.location.href = data.redirect || '/dashboard';
    } else {
      showError('signupError', data.error || 'Account creation failed. Try again.');
      btn.disabled = false;
      btn.textContent = 'Create Account';
    }
  } catch (_) {
    showError('signupError', 'Network error. Check your connection and try again.');
    btn.disabled = false;
    btn.textContent = 'Create Account';
  }
}

// ── Magic Link ──────────────────────────────────────────────────────────────
async function doMagicLink(e) {
  e.preventDefault();
  var email = document.getElementById('magic-email').value.trim();
  var btn = document.getElementById('magicBtn');

  hideError('magicError');
  document.getElementById('magicSuccess').style.display = 'none';

  btn.disabled = true;
  btn.textContent = 'Sending\u2026';

  try {
    var r = await fetch('/auth/magic-link', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email: email }),
    });
    var data = await r.json();
    if (data.ok) {
      document.getElementById('magicSuccess').style.display = 'flex';
      document.getElementById('magicForm').reset();
      btn.textContent = 'Sent!';
    } else {
      showError('magicError', data.error || 'Failed to send link. Try again.');
      btn.disabled = false;
      btn.textContent = 'Send Login Link';
    }
  } catch (_) {
    showError('magicError', 'Network error. Check your connection and try again.');
    btn.disabled = false;
    btn.textContent = 'Send Login Link';
  }
}

// ── Show errors from URL params (e.g. link_expired after magic link) ─────────
(function() {
  var params = new URLSearchParams(window.location.search);
  var err = params.get('error');
  if (!err) return;
  var msgs = {
    link_expired: 'That link has expired or already been used.',
    no_token: 'Invalid link. Please request a new one.',
  };
  showError('signinError', msgs[err] || 'Something went wrong. Please try again.');
})();
</script>
</body>
</html>