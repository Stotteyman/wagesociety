<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <%- include('../../partials/head-pwa') %>
  <title><%= stream.stream_title || stream.channel_name || 'Stream' %> — W.A.G.E. Society</title>
  <meta name="description" content="Watch <%= stream.channel_name %> live on W.A.G.E. Society.">
  <meta property="og:title" content="<%= stream.stream_title || stream.channel_name %> — W.A.G.E. Society">
  <meta property="og:image" content="<%= stream.stream_thumbnail || '' %>">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="stylesheet" href="/css/pages.css">
  <style>
    /* Stream page layout */
    .stream-page-container {
      max-width: 100%;
      padding: 1rem;
    }
    @media (min-width: 768px) {
      .stream-page-container { padding: 2rem; }
    }
    .stream-page-back {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      color: var(--muted);
      font-size: 0.85rem;
      font-weight: 500;
      text-decoration: none;
      margin-bottom: 1.25rem;
      transition: color 0.2s;
      padding: 0.5rem 0;
    }
    .stream-page-back:hover { color: var(--fg); }
    .stream-page-back svg { width: 16px; height: 16px; }

    /* Embed + chat layout */
    .stream-page-layout {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }
    @media (min-width: 768px) {
      .stream-page-layout {
        display: grid;
        grid-template-columns: 1fr 360px;
        gap: 1.5rem;
        align-items: start;
      }
    }

    /* Stream embed wrapper */
    .stream-embed-wrapper {
      position: relative;
      width: 100%;
      aspect-ratio: 16 / 9;
      background: #000;
      border-radius: 12px;
      overflow: hidden;
      margin-bottom: 1rem;
    }
    .stream-embed-wrapper iframe,
    .stream-embed-wrapper video {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      border: none;
    }

    /* Meta section */
    .stream-meta {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      margin-bottom: 1.5rem;
    }
    @media (min-width: 768px) {
      .stream-meta {
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
      }
    }
    .stream-meta-title {
      font-size: 1.25rem;
      font-weight: 700;
      color: var(--fg);
      line-height: 1.3;
    }
    .stream-meta-actions { display: flex; gap: 0.5rem; flex-wrap: wrap; }
    .stream-meta-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.5rem 1.25rem;
      border-radius: 999px;
      font-size: 0.8rem;
      font-weight: 700;
      text-decoration: none;
      transition: all 0.2s;
      font-family: 'Space Grotesk', sans-serif;
    }
    .stream-meta-btn--primary {
      background: var(--accent);
      color: #fff;
    }
    .stream-meta-btn--primary:hover { opacity: 0.85; }
    .stream-meta-btn--secondary {
      background: var(--bg-2);
      color: var(--muted);
      border: 1px solid var(--border);
    }
    .stream-meta-btn--secondary:hover { border-color: var(--border-strong); color: var(--fg); }

    /* Stream info cards */
    .stream-info-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1rem;
      margin-bottom: 2rem;
    }
    .stream-info-card {
      background: var(--bg-2);
      border: 1px solid var(--border);
      border-radius: var(--radius-card);
      padding: 1rem 1.25rem;
    }
    .stream-info-label {
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--muted-2);
      margin-bottom: 0.4rem;
    }
    .stream-info-value {
      font-size: 1rem;
      font-weight: 700;
      color: var(--fg);
    }

    /* Chat panel */
    .stream-chat {
      background: var(--bg-2);
      border: 1px solid var(--border);
      border-radius: var(--radius-card);
      height: 400px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }
    @media (min-width: 768px) {
      .stream-chat { height: 600px; }
    }
    .stream-chat-header {
      padding: 0.875rem 1rem;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .stream-chat-title {
      font-size: 0.85rem;
      font-weight: 700;
      color: var(--fg);
    }
    .stream-chat-body {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--muted-2);
      font-size: 0.85rem;
      padding: 2rem;
      text-align: center;
    }
  </style>
</head>
<body>
  <%- include('../../partials/nav') %>

  <main class="stream-page-container">
    <!-- Back link -->
    <a href="/streams" class="stream-page-back">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <polyline points="15 18 9 12 15 6"/>
      </svg>
      All Streams
    </a>

    <div class="stream-page-layout">
      <!-- Left: embed + info -->
      <div>
        <!-- 16:9 embed -->
        <div class="stream-embed-wrapper">
          <% if (stream.platform === 'youtube') { %>
            <iframe
              src="https://www.youtube.com/embed/<%= stream.platform_channel_id %>?autoplay=1"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen>
            </iframe>
          <% } else if (stream.stream_url) { %>
            <iframe
              src="<%= stream.stream_url %>"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen>
            </iframe>
          <% } else { %>
            <div style="display:flex;align-items:center;justify-content:center;width:100%;height:100%;color:var(--muted-2);font-size:0.9rem;text-align:center;padding:2rem;">
              No embed available for this stream.
            </div>
          <% } %>
        </div>

        <!-- Meta row -->
        <div class="stream-meta">
          <div>
            <% if (stream.status === 'live') { %>
              <div class="stream-live-badge" style="position:static;display:inline-flex;margin-bottom:0.5rem;">
                <span class="live-badge-dot"></span>
                LIVE
              </div>
            <% } %>
            <h1 class="stream-meta-title"><%= stream.stream_title || stream.channel_name || 'Untitled Stream' %></h1>
          </div>
          <div class="stream-meta-actions">
            <a href="<%= stream.stream_url %>" target="_blank" rel="noopener" class="stream-meta-btn stream-meta-btn--primary">
              Watch on <%= stream.platform.charAt(0).toUpperCase() + stream.platform.slice(1) %>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/>
              </svg>
            </a>
          </div>
        </div>

        <!-- Stream info cards -->
        <div class="stream-info-grid">
          <div class="stream-info-card">
            <div class="stream-info-label">Creator</div>
            <div class="stream-info-value"><%= stream.creator_name || stream.channel_name %></div>
          </div>
          <div class="stream-info-card">
            <div class="stream-info-label">Platform</div>
            <div class="stream-info-value" style="text-transform:capitalize;"><%= stream.platform %></div>
          </div>
          <% if (stream.viewer_count > 0) { %>
          <div class="stream-info-card">
            <div class="stream-info-label">Viewers</div>
            <div class="stream-info-value"><%= new Intl.NumberFormat().format(stream.viewer_count) %></div>
          </div>
          <% } %>
          <% if (stream.started_at) { %>
          <div class="stream-info-card">
            <div class="stream-info-label">Started</div>
            <div class="stream-info-value"><%= new Date(stream.started_at).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }) %></div>
          </div>
          <% } %>
        </div>
      </div>

      <!-- Right: chat panel -->
      <div>
        <div class="stream-chat">
          <div class="stream-chat-header">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/>
            </svg>
            <span class="stream-chat-title">Live Chat</span>
          </div>
          <div class="stream-chat-body">
            Open the stream on <%= stream.platform.charAt(0).toUpperCase() + stream.platform.slice(1) %> to join the chat.
          </div>
        </div>
      </div>
    </div>
  </main>

  <%- include('../../partials/footer') %>
</body>
</html>