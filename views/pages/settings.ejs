<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Settings — W.A.G.E. Society</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="stylesheet" href="/css/pages.css">
</head>
<body>
<%- include('../partials/nav') %>

<section class="dashboard-page">
  <div class="dashboard-inner" style="max-width:700px;">
    <div class="page-header">
      <span class="section-label">Account</span>
      <h1 class="section-title">Settings</h1>
    </div>

    <div class="dash-card" style="margin-bottom:2rem;">
      <h3 class="dash-card-title">Profile</h3>
      <div id="settings-error" class="error-msg" style="display:none;margin-bottom:1rem;"></div>
      <div style="display:flex;flex-direction:column;gap:1rem;">
        <div>
          <label style="font-size:0.85rem;font-weight:600;display:block;margin-bottom:0.4rem;">Display Name</label>
          <input type="text" id="settingsDisplayName" class="auth-input" placeholder="Display name" style="width:100%;">
        </div>
        <div>
          <label style="font-size:0.85rem;font-weight:600;display:block;margin-bottom:0.4rem;">Bio</label>
          <textarea id="settingsBio" class="form-textarea" placeholder="Tell the community about yourself..." style="min-height:80px;width:100%;"></textarea>
        </div>
        <div>
          <label style="font-size:0.85rem;font-weight:600;display:block;margin-bottom:0.4rem;">Avatar URL</label>
          <input type="text" id="settingsAvatar" class="auth-input" placeholder="https://..." style="width:100%;">
        </div>
        <button class="btn-primary" id="settingsSaveBtn" onclick="saveSettings()">Save Profile</button>
      </div>
    </div>

    <div class="dash-card" style="margin-bottom:2rem;">
      <h3 class="dash-card-title">Email Alerts</h3>
      <p style="color:var(--muted);font-size:0.9rem;margin-bottom:1rem;">Manage what you receive.</p>
      <div style="display:flex;flex-direction:column;gap:0.75rem;">
        <label style="display:flex;align-items:center;gap:0.75rem;cursor:pointer;">
          <input type="checkbox" id="alertLive"> Live stream alerts
        </label>
        <label style="display:flex;align-items:center;gap:0.75rem;cursor:pointer;">
          <input type="checkbox" id="alertNewsletter"> Newsletter
        </label>
        <label style="display:flex;align-items:center;gap:0.75rem;cursor:pointer;">
          <input type="checkbox" id="alertProduct"> Product updates
        </label>
        <label style="display:flex;align-items:center;gap:0.75rem;cursor:pointer;">
          <input type="checkbox" id="alertCommunity"> Community updates
        </label>
      </div>
      <button class="btn-primary" style="margin-top:1rem;" onclick="saveAlerts()">Save Preferences</button>
    </div>

    <div class="dash-card">
      <h3 class="dash-card-title">Legal</h3>
      <div style="display:flex;flex-direction:column;gap:0.75rem;">
        <a href="/terms" class="dash-link">📄 Terms of Service</a>
        <a href="/privacy" class="dash-link">🔒 Privacy Policy</a>
      </div>
    </div>
  </div>
</section>

<script>
function loadProfile() {
  fetch('/api/auth/me').then(r=>r.json()).then(data => {
    if (!data.user) { window.location.href='/login'; return; }
    document.getElementById('settingsDisplayName').value = data.user.display_name || '';
    document.getElementById('settingsBio').value = data.user.bio || '';
    document.getElementById('settingsAvatar').value = data.user.avatar_url || '';
  }).catch(()=>{});
}
function saveSettings() {
  const btn = document.getElementById('settingsSaveBtn');
  btn.disabled = true; btn.textContent = 'Saving...';
  fetch('/api/me/profile', {
    method:'PUT',
    headers:{'Content-Type':'application/json'},
    body: JSON.stringify({
      display_name: document.getElementById('settingsDisplayName').value,
      bio: document.getElementById('settingsBio').value,
      avatar_url: document.getElementById('settingsAvatar').value,
    })
  }).then(r=>r.json()).then(data => {
    if (data.error) { const e=document.getElementById('settings-error'); e.textContent=data.error; e.style.display='block'; }
    else { btn.textContent='Saved!'; setTimeout(()=>{ btn.textContent='Save Profile'; btn.disabled=false; }, 1500); }
  }).catch(()=>{ btn.textContent='Save Profile'; btn.disabled=false; });
}
function saveAlerts() {
  fetch('/api/marketing-proof', {
    method:'POST',
    headers:{'Content-Type':'application/json'},
    body: JSON.stringify({
      liveAlerts: document.getElementById('alertLive').checked,
      newsletter: document.getElementById('alertNewsletter').checked,
      productUpdates: document.getElementById('alertProduct').checked,
      communityUpdates: document.getElementById('alertCommunity').checked,
      source: 'settings',
    })
  }).then(r=>r.json()).then(()=>{ alert('Preferences saved!'); }).catch(()=>{});
}
loadProfile();
</script>
</body>
</html>