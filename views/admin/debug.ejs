    // ── Route Health ────────────────────────────────────────────
    async function checkRoutes() {
      show('routes-results', '<div class="state-msg"><span class="spinner"></span>Pinging routes...</div>');
      try {
        const data = await apiCall('/admin/debug/api/route-health', 'POST');
        const routes = data.routes || [];
        let html = '<table class="debug-table" style="margin-top:0.75rem;"><tr><th>Route</th><th>Status</th><th>Note</th></tr>';
        let failCount = 0;
