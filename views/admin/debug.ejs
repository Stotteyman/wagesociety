    // ── OAuth Status ───────────────────────────────────────────
    async function runOAuthCheck() {
      show('oauth-results', '<div class="state-msg"><span class="spinner"></span>Checking...</div>');
      try {
        const data = await apiCall('/admin/debug/api/oauth-status', 'POST');
        let html = '<table class="debug-table" style="margin-top:0.75rem;"><tr><th>Provider</th><th>Status</th><th>Detail</th></tr>';
        const providers = [
          { key: 'google',  label: 'Google (Supabase)' },
          { key: 'discord', label: 'Discord (bot)' },
          { key: 'kick',    label: 'Kick' },
        ];
        let anyConfigured = false;
        for (const p of providers) {
          const d = data.providers?.[p.key] || {};
          const configured = d.configured;
          if (configured) anyConfigured = true;
          html += `<tr>
            <td class="mono" style="color:var(--accent)">${p.label}</td>
            <td><span class="badge ${configured ? 'badge-pass' : 'badge-muted'}">${configured ? 'Configured' : 'Not configured'}</span></td>
            <td class="mono" style="font-size:0.72rem;color:var(--muted)">${configured ? 'Active' : 'N/A'}</td>
          </tr>`;
        }
        html += '</table>';
        if (data.redirectUris && data.redirectUris.length) {
          html += '<div class="sub-section"><div class="sub-section-title">Redirect URIs</div><table class="debug-table"><tr><th>Provider</th><th>Redirect URI</th></tr>';
          for (const r of data.redirectUris) {
            html += `<tr><td class="mono" style="color:var(--accent)">${r.provider}</td><td class="mono" style="font-size:0.72rem;word-break:break-all;color:var(--muted)">${r.url || '(not set)'}</td></tr>`;
          }
          html += '</table></div>';
        }
        show('oauth-results', html);
        setSectionStatus('oauth', anyConfigured ? 'pass' : 'muted', anyConfigured ? `${providers.filter(p => data.providers?.[p.key]?.configured).length} providers` : 'none configured');
      } catch(e) {
        show('oauth-results', `<div style="color:#ef4444;font-size:0.82rem;">${e.message}</div>`);
      }
    }

    // ── Auth Sessions ─────────────────────────────────────────
    async function loadSessions() {
      show('sessions-current', '<div class="state-msg"><span class="spinner"></span>Decoding session...</div>');
      try {
        const data = await apiCall('/admin/debug/api/auth-sessions', 'POST');
        const s = data.currentSession;
        if (!s) {
          show('sessions-current', '<div class="state-msg">No active session for this request</div>');
          return;
        }
        const html = `<table class="debug-table" style="margin-top:0.5rem;"><tr><th>Field</th><th>Value</th></tr>
          <tr><td class="mono" style="color:var(--accent)">userEmail</td><td class="mono">${s.userEmail || '<span style="color:var(--muted-2)">null</span>'}</td></tr>
          <tr><td class="mono" style="color:var(--accent)">userId</td><td class="mono">${s.userId || '<span style="color:var(--muted-2)">null</span>'}</td></tr>
          <tr><td class="mono" style="color:var(--accent)">role</td><td class="mono">${s.role || '<span style="color:var(--muted-2)">null</span>'}</td></tr>
          <tr><td class="mono" style="color:var(--accent)">cookie.maxAge</td><td class="mono">${s.cookieMaxAge_ms ? (s.cookieMaxAge_ms / 1000 / 60 / 60 / 24).toFixed(0) + ' days' : '<span style="color:var(--muted-2)">N/A</span>'}</td></tr>
          <tr><td class="mono" style="color:var(--accent)">cookie.secure</td><td class="mono">${s.cookieSecure}</td></tr>
          <tr><td class="mono" style="color:var(--accent)">cookie.httpOnly</td><td class="mono">${s.cookieHttpOnly}</td></tr>
          <tr><td class="mono" style="color:var(--accent)">cookie.sameSite</td><td class="mono">${s.cookieSameSite}</td></tr>
        </table>`;
        show('sessions-current', html);
        setSectionStatus('sessions', 'pass', s.userEmail || 'no email');
      } catch(e) {
        show('sessions-current', `<div style="color:#ef4444;font-size:0.82rem;">${e.message}</div>`);
      }
    }

    async function querySessionsByEmail() {
      const email = document.getElementById('session-email')?.value?.trim();
      if (!email) { alert('Enter an email address'); return; }
      show('sessions-by-email', '<div class="state-msg"><span class="spinner"></span>Querying...</div>');
      try {
        const data = await apiCall('/admin/debug/api/auth-sessions', 'POST', { email });
        const sessions = data.userSessions;
        if (!sessions) {
          show('sessions-by-email', '<div class="state-msg">No session data returned</div>');
          return;
        }
        if (sessions.error) {
          show('sessions-by-email', `<div style="color:var(--muted);font-size:0.8rem;">${sessions.error}</div>`);
          return;
        }
        if (!Array.isArray(sessions) || sessions.length === 0) {
          show('sessions-by-email', '<div class="state-msg">No sessions found for ' + email + '</div>');
          return;
        }
        let html = '<table class="debug-table" style="margin-top:0.5rem;"><tr><th>Session ID</th><th>Expires</th></tr>';
        for (const s of sessions) {
          html += `<tr>
            <td class="mono" style="font-size:0.72rem;">${s.id}</td>
            <td class="mono" style="font-size:0.72rem;color:var(--muted-2)">${new Date(s.expire).toLocaleString()}</td>
          </tr>`;
        }
        html += '</table>';
        show('sessions-by-email', html);
      } catch(e) {
        show('sessions-by-email', `<div style="color:#ef4444;font-size:0.82rem;">${e.message}</div>`);
      }
    }

    // ── Row Edit / Create ──────────────────────────────────────
    let editingRow = null;
    let editingTable = null;
    let editingPk = null;
    let editingPkVal = null;
    let creatingTable = null;

    async function editRow(table, pkField, pkValue) {
      try {
        const data = await apiCall('/admin/debug/api/row-edit', 'POST', { table, pkField, pkValue });
        if (data.error) { alert('Error: ' + data.error); return; }
        editingRow = data.row;
        editingTable = data.table;
        editingPk = data.pkField;
        editingPkVal = data.pkValue;

        let html = `<div style="background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-sm);padding:1rem;margin-top:0.75rem;">
          <div style="font-size:0.8rem;font-weight:600;color:var(--accent);margin-bottom:0.75rem;">Editing ${table} — ${pkField}=${pkValue}</div>
          <form onsubmit="return submitEdit(event)">`;
        for (const [key, val] of Object.entries(data.row)) {
          const colInfo = data.columns[key];
          const type = colInfo?.data_type || 'text';
          const isSerial = colInfo?.column_default?.includes('nextval') || key === 'id' || key === 'created_at';
          const disabled = isSerial ? 'disabled' : '';
          html += `<div class="form-group">
            <label class="form-label" style="display:flex;justify-content:space-between;">
              <span>${key}</span>
              <span style="color:var(--muted-2);font-size:0.65rem;text-transform:none;font-weight:400;">${type}</span>
            </label>`;
          if (type === 'text' || type === 'jsonb' || type === 'json') {
            html += `<textarea class="form-textarea" name="${key}" ${disabled} style="height:60px;">${val ?? ''}</textarea>`;
          } else if (type === 'boolean') {
            html += `<select class="form-select" name="${key}" ${disabled}>
              <option value="true"  ${val === true  ? 'selected' : ''}>true</option>
              <option value="false" ${val === false ? 'selected' : ''}>false</option>
            </select>`;
          } else {
            html += `<input type="${type === 'integer' || type === 'bigint' || type === 'numeric' ? 'number' : 'text'}"
              class="form-input" name="${key}" value="${val ?? ''}" ${disabled}
              style="font-family:'Courier New',monospace;">`;
          }
          html += '</div>';
        }
        html += `<div class="btn-row" style="margin-top:1rem;">
          <button type="submit" class="btn btn-primary">Save Changes</button>
          <button type="button" class="btn btn-ghost" onclick="cancelEdit()">Cancel</button>
        </div></form></div>`;

        // Insert below the DB results
        const target = document.getElementById('db-results');
        const existing = document.getElementById('edit-form-overlay');
        if (existing) existing.remove();
        const div = document.createElement('div');
        div.id = 'edit-form-overlay';
        div.innerHTML = html;
        target.parentNode.insertBefore(div, target.nextSibling);
      } catch(e) { alert(e.message); }
    }

    async function submitEdit(event) {
      event.preventDefault();
      const form = event.target;
      const fd = new FormData(form);
      const updates = {};
      for (const [k, v] of fd.entries()) updates[k] = v === '' ? null : v;

      try {
        const data = await apiCall('/admin/debug/api/row-update', 'POST', {
          table: editingTable, pkField: editingPk, pkValue: editingPkVal, updates
        });
        if (data.error) { alert('Update failed: ' + data.error); return; }
        cancelEdit();
        loadTableRows(editingTable);
      } catch(e) { alert(e.message); }
    }

    function cancelEdit() {
      const el = document.getElementById('edit-form-overlay');
      if (el) el.remove();
      editingRow = null; editingTable = null; editingPk = null; editingPkVal = null;
    }

    async function showCreateForm() {
      const sel = document.getElementById('db-table-select');
      const table = sel ? sel.value : null;
      if (!table) { alert('Select a table first'); return; }
      creatingTable = table;

      try {
        const data = await apiCall('/admin/debug/api/row-create-form', 'POST', { table });
        if (data.error) { alert('Error: ' + data.error); return; }

        let html = `<div style="background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-sm);padding:1rem;margin-top:0.75rem;">
          <div style="font-size:0.8rem;font-weight:600;color:var(--accent);margin-bottom:0.75rem;">Create Row in ${table}</div>
          <form onsubmit="return submitCreate(event)">`;
        for (const col of data.columns) {
          const nullable = col.is_nullable === 'YES';
          html += `<div class="form-group">
            <label class="form-label" style="display:flex;justify-content:space-between;">
              <span>${col.column_name}</span>
              <span style="color:var(--muted-2);font-size:0.65rem;text-transform:none;font-weight:400;">${col.data_type}${nullable ? ' (nullable)' : ''}</span>
            </label>`;
          if (col.data_type === 'text' || col.data_type === 'jsonb') {
            html += `<textarea class="form-textarea" name="${col.column_name}" style="height:60px;font-family:'Courier New',monospace;" placeholder="${nullable ? '(empty allowed)' : ''}"></textarea>`;
          } else if (col.data_type === 'boolean') {
            html += `<select class="form-select" name="${col.column_name}">
              <option value="">— leave null —</option>
              <option value="true">true</option>
              <option value="false">false</option>
            </select>`;
          } else {
            html += `<input type="${col.data_type === 'integer' || col.data_type === 'bigint' || col.data_type === 'numeric' ? 'number' : 'text'}"
              class="form-input" name="${col.column_name}" style="font-family:'Courier New',monospace;"
              placeholder="${nullable ? '(empty allowed)' : ''}">`;
          }
          html += '</div>';
        }
        html += `<div class="btn-row" style="margin-top:1rem;">
          <button type="submit" class="btn btn-primary">Insert Row</button>
          <button type="button" class="btn btn-ghost" onclick="cancelCreate()">Cancel</button>
        </div></form></div>`;

        const existing = document.getElementById('create-form-overlay');
        if (existing) existing.remove();
        const div = document.createElement('div');
        div.id = 'create-form-overlay';
        div.innerHTML = html;
        const target = document.getElementById('db-results');
        target.parentNode.insertBefore(div, target.nextSibling);
      } catch(e) { alert(e.message); }
    }

    async function submitCreate(event) {
      event.preventDefault();
      const form = event.target;
      const fd = new FormData(form);
      const cols = [];
      const vals = [];
      let paramIdx = 1;
      for (const [k, v] of fd.entries()) {
        if (v !== '') { cols.push(k); vals.push(v === '' ? null : v); }
      }

      const sql = `INSERT INTO ${creatingTable} (${cols.map(c => `"${c}"`).join(', ')}) VALUES (${vals.map((_,i) => `$${i+1}`).join(', ')}) RETURNING *`;
      const data = await apiCall('/admin/debug/api/sql', 'POST', { sql, writeMode: true });
      if (data.error) { alert('Insert failed: ' + data.error); return; }
      cancelCreate();
      loadTableRows(creatingTable);
    }

    function cancelCreate() {
      const el = document.getElementById('create-form-overlay');
      if (el) el.remove();
      creatingTable = null;
    }

    // ── Error Logs ─────────────────────────────────────────────
    async function loadErrorLogs() {
      show('error-logs-results', '<div class="state-msg"><span class="spinner"></span>Loading...</div>');
      try {
        const data = await apiCall('/admin/debug/api/error-logs', 'POST');
        let html = '';

        // Client errors
        if (data.clientErrors && data.clientErrors.length > 0) {
          html += `<div class="sub-section"><div class="sub-section-title">Client-Side Errors (${data.clientErrors.length})</div>
            <table class="debug-table"><tr><th>Time</th><th>URL</th><th>Message</th><th>User Agent</th></tr>`;
          for (const e of data.clientErrors) {
            html += `<tr>
              <td class="mono" style="font-size:0.7rem;color:var(--muted-2)">${new Date(e.created_at).toLocaleString()}</td>
              <td class="mono" style="font-size:0.7rem;max-width:180px;word-break:break-all;">${e.url || '—'}</td>
              <td class="mono" style="font-size:0.72rem;max-width:240px;word-break:break-all;color:#ef4444;">${(e.msg || '').slice(0,80)}</td>
              <td class="mono" style="font-size:0.7rem;max-width:160px;word-break:break-all;">${(e.ua || '').slice(0,80)}</td>
            </tr>`;
          }
          html += '</table></div>';
        }

        // Server errors
        if (data.serverErrors && data.serverErrors.length > 0) {
          html += `<div class="sub-section"><div class="sub-section-title">Server-Side Errors (${data.serverErrors.length})</div>
            <table class="debug-table"><tr><th>Time</th><th>Actor</th><th>Action</th><th>Detail</th></tr>`;
          for (const e of data.serverErrors) {
            html += `<tr>
              <td class="mono" style="font-size:0.7rem;color:var(--muted-2)">${new Date(e.created_at).toLocaleString()}</td>
              <td class="mono" style="font-size:0.72rem;color:var(--accent)">${e.actor || '—'}</td>
              <td class="mono" style="font-size:0.72rem;color:#ef4444">${e.action}</td>
              <td class="mono" style="font-size:0.7rem;word-break:break-all;">${JSON.stringify(e.detail || {})}</td>
            </tr>`;
          }
          html += '</table></div>';
        }

        if (!html) {
          html = '<div class="state-msg">No errors logged. Client errors require window.onerror wiring in the app.</div>';
        }

        show('error-logs-results', html);
        const total = (data.clientErrors?.length || 0) + (data.serverErrors?.length || 0);
        setSectionStatus('errors', total > 0 ? 'fail' : 'pass', total > 0 ? `${total} errors` : 'clean');
      } catch(e) {
        show('error-logs-results', `<div style="color:#ef4444;font-size:0.82rem;">${e.message}</div>`);
      }
    }

    // ── Client Error Collection (runs on page load) ─────────────────
    window.addEventListener('error', function(e) {
      const payload = {
        ua: navigator.userAgent,
        url: window.location.href,
        msg: e.message,
        stack: e.error?.stack || '',
        line: String(e.lineno || ''),
        col: String(e.colno || ''),
      };
      // Fire-and-forget to the log endpoint
      const pw = localStorage.getItem('debug_pw') || '';
      fetch('/admin/debug/api/log-client-error', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'x-debug-password': pw },
        body: JSON.stringify(payload),
      }).catch(() => {});
    });

    // Auto-open first section so it's not blank
    toggleSection('sec-supabase');
  </script>
</body>
</html>