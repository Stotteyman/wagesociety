        html += '</div>';
        show('stripe-results', html);
        setSectionStatus('stripe', configured ? 'pass' : 'fail', configured ? 'configured' : 'not configured');
      } catch(e) {
        show('stripe-results', `<div style="color:#ef4444;font-size:0.82rem;">${e.message}</div>`);
      }
