    // ── Stripe ───────────────────────────────────────────────────
    async function loadStripeStatus() {
      show('stripe-results', '<div class="state-msg"><span class="spinner"></span>Loading...</div>');
      try {
        const data = await apiCall('/admin/debug/api/stripe-status', 'POST');
        const configured = data.stripe_payment_links_configured;
        const stats = data.donationStats;
        const links = [];
        if (data.subscriptionLinksMonthly) for (const [k,v] of Object.entries(data.subscriptionLinksMonthly)) links.push({ name: k + ' (monthly)', url: v });
        if (data.subscriptionLinksAnnual) for (const [k,v] of Object.entries(data.subscriptionLinksAnnual)) links.push({ name: k + ' (annual)', url: v });
        let html = `
          <div style="margin-top:0.75rem;">
            <div style="margin-bottom:1rem;">
              <span class="badge ${configured ? 'badge-pass' : 'badge-fail'}">${configured ? 'Payment Links Configured' : 'No Stripe Links Found'}</span>
            </div>`;
        if (stats) {
          html += `<div class="grid-3" style="margin-bottom:1rem;">
            <div style="background:var(--surface);padding:0.75rem;border-radius:var(--radius-sm);border:1px solid var(--border);text-align:center;">
              <div style="font-size:1.5rem;font-weight:700;color:var(--fg);">${stats.completed}</div>
              <div style="font-size:0.7rem;color:var(--muted)">Completed</div>
            </div>
            <div style="background:var(--surface);padding:0.75rem;border-radius:var(--radius-sm);border:1px solid var(--border);text-align:center;">
              <div style="font-size:1.5rem;font-weight:700;color:#eab308;">${stats.pending}</div>
              <div style="font-size:0.7rem;color:var(--muted)">Pending</div>
            </div>
            <div style="background:var(--surface);padding:0.75rem;border-radius:var(--radius-sm);border:1px solid var(--border);text-align:center;">
              <div style="font-size:1.5rem;font-weight:700;color:#22c55e;">$${Number(stats.total_usd).toFixed(2)}</div>
              <div style="font-size:0.7rem;color:var(--muted)">Total (USD)</div>
            </div>
          </div>`;
        }
        if (links.length > 0) {
          html += `<div class="sub-section"><div class="sub-section-title">Configured Links</div><table class="debug-table"><tr><th>Plan</th><th>Link</th></tr>`;
          for (const l of links) {
            html += `<tr><td class="mono" style="color:var(--accent)">${l.name}</td><td class="mono" style="font-size:0.72rem;"><a href="${l.url}" target="_blank" style="color:#3b82f6;">${l.url || '(not set)'}</a></td></tr>`;
          }
          html += '</table></div>';
