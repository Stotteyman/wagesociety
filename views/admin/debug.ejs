            <td class="mono" style="font-size:0.72rem;max-width:500px;word-break:break-all;color:${isMasked ? 'var(--muted-2)' : 'var(--fg)'}">${v || '<span style="color:var(--muted-2)">(not set)</span>'}</td>
          </tr>`;
        }
        html += '</table></div>';
        show('env-results', html);
        setSectionStatus('env', 'pass', `${keys.length} vars`);
      } catch(e) {
        show('env-results', `<div style="color:#ef4444;font-size:0.82rem;">${e.message}</div>`);
      }
    }

