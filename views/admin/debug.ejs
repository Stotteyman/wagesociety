            <td><span class="badge ${ok ? 'badge-pass' : 'badge-fail'}">${r.status}</span></td>
            <td class="mono" style="font-size:0.72rem;color:var(--muted)">${r.note || '—'}</td>
          </tr>`;
        }
        html += '</table>';
        show('routes-results', html);
        setSectionStatus('routes', failCount > 0 ? 'fail' : 'pass', `${routes.length} routes checked`);
