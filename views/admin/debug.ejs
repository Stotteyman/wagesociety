<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Debug Panel — WAGE Society</title>
  <link rel="stylesheet" href="/css/theme.css">
  <style>
    /* ── Debug Panel — Dark Zinc Aesthetic ───────────────────────────────── */
    .debug-wrapper { max-width: 1100px; margin: 0 auto; padding: 2rem 1.5rem 4rem; }

    .debug-header {
      display: flex; align-items: center; justify-content: space-between;
      padding: 1.5rem 0; border-bottom: 1px solid var(--border); margin-bottom: 2rem;
    }
    .debug-header h1 { font-size: 1.4rem; font-weight: 700; color: var(--accent); }
    .debug-badge {
      background: rgba(255,102,0,0.15); border: 1px solid rgba(255,102,0,0.3);
      color: var(--accent); font-size: 0.7rem; padding: 0.2rem 0.6rem; border-radius: 100px;
      letter-spacing: 0.08em; text-transform: uppercase; font-weight: 600;
    }

    .section-card {
      background: var(--bg-2); border: 1px solid var(--border); border-radius: var(--radius-card);
      margin-bottom: 1.25rem; overflow: hidden;
    }
    .section-header {
      display: flex; align-items: center; justify-content: space-between;
      padding: 1rem 1.25rem; cursor: pointer; user-select: none;
      border-bottom: 1px solid transparent;
    }
    .section-header:hover { background: rgba(255,255,255,0.03); }
    .section-card.open .section-header { border-bottom-color: var(--border); }
    .section-title {
      font-size: 0.9rem; font-weight: 600; color: var(--fg); display: flex; align-items: center; gap: 0.5rem;
    }
    .section-title .icon { font-size: 1rem; }
    .section-meta { font-size: 0.75rem; color: var(--muted-2); }
    .chevron { transition: transform 0.2s; font-size: 0.8rem; color: var(--muted-2); }
    .section-card.open .chevron { transform: rotate(180deg); }

    .section-body { padding: 1.25rem; display: none; }
    .section-card.open .section-body { display: block; }

    /* Tables */
    .debug-table { width: 100%; border-collapse: collapse; font-size: 0.8rem; }
    .debug-table th {
      text-align: left; padding: 0.5rem 0.75rem; background: var(--surface);
      color: var(--muted); font-weight: 600; border-bottom: 1px solid var(--border-strong);
    }
    .debug-table td { padding: 0.5rem 0.75rem; border-bottom: 1px solid var(--border); color: var(--fg); }
    .debug-table tr:hover td { background: rgba(255,255,255,0.02); }
    .debug-table .mono { font-family: 'Courier New', monospace; font-size: 0.75rem; }

    /* Status badges */
    .badge { display: inline-block; padding: 0.15rem 0.5rem; border-radius: 100px; font-size: 0.7rem; font-weight: 600; }
    .badge-pass  { background: rgba(34,197,94,0.15);  color: #22c55e; border: 1px solid rgba(34,197,94,0.3); }
    .badge-fail  { background: rgba(239,68,68,0.15);   color: #ef4444; border: 1px solid rgba(239,68,68,0.3); }
    .badge-warn  { background: rgba(234,179,8,0.15);   color: #eab308; border: 1px solid rgba(234,179,8,0.3); }
    .badge-ok    { background: rgba(59,130,246,0.15);  color: #3b82f6; border: 1px solid rgba(59,130,246,0.3); }
    .badge-muted { background: rgba(255,255,255,0.05); color: var(--muted); border: 1px solid var(--border); }

    /* Buttons */
    .btn-row { display: flex; gap: 0.5rem; flex-wrap: wrap; margin: 0.75rem 0; }
    .btn {
      padding: 0.45rem 0.9rem; border-radius: var(--radius-sm); font-size: 0.78rem;
      font-weight: 500; cursor: pointer; border: none; font-family: inherit;
      transition: opacity 0.15s, background 0.15s;
    }
    .btn:hover { opacity: 0.85; }
    .btn-primary { background: var(--accent); color: #fff; }
    .btn-danger  { background: rgba(239,68,68,0.15); color: #ef4444; border: 1px solid rgba(239,68,68,0.3); }
    .btn-ghost   { background: var(--surface); color: var(--muted); border: 1px solid var(--border); }
    .btn:disabled { opacity: 0.4; cursor: not-allowed; }

    /* Forms */
    .form-group { margin-bottom: 0.75rem; }
    .form-label { display: block; font-size: 0.75rem; font-weight: 600; color: var(--muted); margin-bottom: 0.3rem; text-transform: uppercase; letter-spacing: 0.05em; }
    .form-input, .form-select, .form-textarea {
      width: 100%; background: var(--surface); border: 1px solid var(--border-strong);
      color: var(--fg); border-radius: var(--radius-sm); padding: 0.5rem 0.75rem;
      font-size: 0.85rem; font-family: 'Courier New', monospace;
    }
    .form-textarea { height: 120px; resize: vertical; }
    .form-select { cursor: pointer; }
    .form-input:focus, .form-select:focus, .form-textarea:focus {
      outline: none; border-color: var(--accent);
    }

    /* Loading / empty states */
    .state-msg { padding: 1rem; text-align: center; color: var(--muted); font-size: 0.8rem; }
    .spinner { display: inline-block; width: 14px; height: 14px; border: 2px solid var(--border); border-top-color: var(--accent); border-radius: 50%; animation: spin 0.6s linear infinite; margin-right: 0.4rem; vertical-align: middle; }
    @keyframes spin { to { transform: rotate(360deg); } }

    .check-row { display: flex; gap: 0.75rem; align-items: flex-start; padding: 0.4rem 0; border-bottom: 1px solid var(--border); font-size: 0.8rem; }
    .check-row:last-child { border-bottom: none; }
    .check-name { min-width: 200px; font-family: 'Courier New', monospace; font-size: 0.75rem; color: var(--muted); padding-top: 0.15rem; }
    .check-latency { font-size: 0.7rem; color: var(--muted-2); min-width: 60px; text-align: right; padding-top: 0.2rem; }

    .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    .grid-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem; }
    @media (max-width: 700px) { .grid-2, .grid-3 { grid-template-columns: 1fr; } }

    .kv-row { display: flex; gap: 0.75rem; padding: 0.3rem 0; font-size: 0.8rem; border-bottom: 1px solid var(--border); }
    .kv-key { min-width: 280px; color: var(--accent); font-family: 'Courier New', monospace; font-size: 0.75rem; }
    .kv-val { color: var(--fg); font-family: 'Courier New', monospace; font-size: 0.75rem; word-break: break-all; }

    .sub-section { margin: 1rem 0; }
    .sub-section-title { font-size: 0.75rem; font-weight: 600; color: var(--muted); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 0.5rem; }

    .pagination { display: flex; gap: 0.3rem; align-items: center; margin-top: 0.75rem; }
    .page-btn { padding: 0.3rem 0.6rem; background: var(--surface); border: 1px solid var(--border); color: var(--muted); border-radius: var(--radius-sm); font-size: 0.75rem; cursor: pointer; }
    .page-btn:disabled { opacity: 0.35; cursor: not-allowed; }

    .response-block { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 0.75rem; font-family: 'Courier New', monospace; font-size: 0.75rem; color: var(--muted); white-space: pre-wrap; word-break: break-all; max-height: 300px; overflow-y: auto; }

    .hint { font-size: 0.75rem; color: var(--muted-2); margin-top: 0.25rem; }

    .log-entry { padding: 0.5rem 0.75rem; border-bottom: 1px solid var(--border); font-size: 0.75rem; }
    .log-entry:last-child { border-bottom: none; }
    .log-time { color: var(--muted-2); font-family: 'Courier New', monospace; }
    .log-actor { color: var(--accent); font-family: 'Courier New', monospace; }
    .log-action { color: var(--fg); font-weight: 600; }

    /* error flash */
    .error-flash { background: rgba(239,68,68,0.12); border: 1px solid rgba(239,68,68,0.3); color: #ef4444; padding: 0.75rem 1rem; border-radius: var(--radius-sm); font-size: 0.82rem; margin-bottom: 1rem; display: none; }
    .error-flash.visible { display: block; }

    .row-actions { display: flex; gap: 0.4rem; }
    .row-actions form { display: inline; }
    .row-actions button { font-size: 0.7rem; padding: 0.2rem 0.5rem; }

    .section-header .status-dot {
      width: 7px; height: 7px; border-radius: 50%;
      background: var(--muted-2); margin-right: 0.5rem; display: inline-block;
    }
    .section-header .status-dot.pass { background: #22c55e; }
    .section-header .status-dot.fail { background: #ef4444; }
  </style>
</head>
<body>
  <div class="debug-wrapper">
    <div class="debug-header">
      <h1>🔧 Internal Diagnostic Panel</h1>
      <div style="display:flex;gap:0.75rem;align-items:center;">
        <span class="debug-badge">Admin Only</span>
        <span style="font-size:0.75rem;color:var(--muted);">wagesociety.com/admin/debug</span>
      </div>
    </div>

    <% if (error) { %>
      <div class="error-flash visible"><%= error %></div>
    <% } %>

    <!-- ── Section 1: Database Health ─────────────────────────── -->
    <div class="section-card" id="sec-supabase">
      <div class="section-header" onclick="toggleSection('sec-supabase')">
        <div style="display:flex;align-items:center;gap:0.6rem;">
          <span class="status-dot" id="dot-supabase"></span>
          <span class="section-title"><span class="icon">🗄️</span> Database Health</span>
        </div>
        <div style="display:flex;align-items:center;gap:1rem;">
          <span class="section-meta" id="meta-supabase"></span>
          <span class="chevron">▾</span>
        </div>
      </div>
      <div class="section-body">
        <div class="btn-row">
          <button class="btn btn-primary" onclick="runSupabaseCheck()">Run Health Check</button>
        </div>
        <div id="supabase-results"></div>

        <div class="sub-section">
          <div class="sub-section-title">Tables</div>
          <div class="btn-row">
            <button class="btn btn-ghost" onclick="loadTables()">Load Table List</button>
          </div>
          <div id="tables-results"></div>
        </div>

        <div class="sub-section">
          <div class="sub-section-title">SQL Query Runner</div>
          <div class="form-group">
            <textarea class="form-textarea" id="sql-input" placeholder="SELECT * FROM member_profiles LIMIT 10"></textarea>
          </div>
          <div style="display:flex;gap:0.5rem;align-items:center;margin-bottom:0.75rem;">
            <label style="font-size:0.75rem;color:var(--muted);">
              <input type="checkbox" id="sql-write-mode"> Enable write (type WRITE in input above)
            </label>
          </div>
          <div class="btn-row">
            <button class="btn btn-primary" onclick="runSql()">Run Query</button>
            <button class="btn btn-ghost" onclick="document.getElementById('sql-input').value='';document.getElementById('sql-output').innerHTML='';">Clear</button>
          </div>
          <div id="sql-output" class="response-block" style="display:none;margin-top:0.75rem;"></div>
        </div>
      </div>
    </div>

    <!-- ── Section 2: Env Vars ──────────────────────────────────── -->
    <div class="section-card" id="sec-env">
      <div class="section-header" onclick="toggleSection('sec-env')">
        <div style="display:flex;align-items:center;gap:0.6rem;">
          <span class="status-dot" id="dot-env"></span>
          <span class="section-title"><span class="icon">🔑</span> Environment Variables</span>
        </div>
        <div style="display:flex;align-items:center;gap:1rem;">
          <span class="section-meta" id="meta-env"></span>
          <span class="chevron">▾</span>
        </div>
      </div>
      <div class="section-body">
        <div class="btn-row">
          <button class="btn btn-ghost" onclick="loadEnv()">Load Env Vars</button>
        </div>
        <div id="env-results"></div>
      </div>
    </div>

    <!-- ── Section 3: Server Status ─────────────────────────────── -->
    <div class="section-card" id="sec-server">
      <div class="section-header" onclick="toggleSection('sec-server')">
        <div style="display:flex;align-items:center;gap:0.6rem;">
          <span class="status-dot pass" id="dot-server"></span>
          <span class="section-title"><span class="icon">🖥️</span> Server Status</span>
        </div>
        <div style="display:flex;align-items:center;gap:1rem;">
          <span class="section-meta" id="meta-server"></span>
          <span class="chevron">▾</span>
        </div>
      </div>
      <div class="section-body">
        <div class="btn-row">
          <button class="btn btn-ghost" onclick="loadServerStatus()">Refresh Status</button>
        </div>
        <div id="server-results"></div>
      </div>
    </div>

    <!-- ── Section 4: Route Health ─────────────────────────────── -->
    <div class="section-card" id="sec-routes">
      <div class="section-header" onclick="toggleSection('sec-routes')">
        <div style="display:flex;align-items:center;gap:0.6rem;">
          <span class="status-dot" id="dot-routes"></span>
          <span class="section-title"><span class="icon">🌐</span> Route Health</span>
        </div>
        <div style="display:flex;align-items:center;gap:1rem;">
          <span class="section-meta" id="meta-routes"></span>
          <span class="chevron">▾</span>
        </div>
      </div>
      <div class="section-body">
        <div class="btn-row">
          <button class="btn btn-ghost" onclick="checkRoutes()">Ping All Routes</button>
        </div>
        <div id="routes-results"></div>
      </div>
    </div>

    <!-- ── Section 4b: OAuth Status ────────────────────────────────────── -->
    <div class="section-card" id="sec-oauth">
      <div class="section-header" onclick="toggleSection('sec-oauth')">
        <div style="display:flex;align-items:center;gap:0.6rem;">
          <span class="status-dot" id="dot-oauth"></span>
          <span class="section-title"><span class="icon">🔐</span> OAuth Status</span>
        </div>
        <div style="display:flex;align-items:center;gap:1rem;">
          <span class="section-meta" id="meta-oauth"></span>
          <span class="chevron">▾</span>
        </div>
      </div>
      <div class="section-body">
        <div class="btn-row">
          <button class="btn btn-ghost" onclick="runOAuthCheck()">Check OAuth Status</button>
        </div>
        <div id="oauth-results"></div>
      </div>
    </div>

    <!-- ── Section 4c: Auth Sessions ─────────────────────────────────── -->
    <div class="section-card" id="sec-sessions">
      <div class="section-header" onclick="toggleSection('sec-sessions')">
        <div style="display:flex;align-items:center;gap:0.6rem;">
          <span class="status-dot" id="dot-sessions"></span>
          <span class="section-title"><span class="icon">🔑</span> Auth Sessions</span>
        </div>
        <div style="display:flex;align-items:center;gap:1rem;">
          <span class="section-meta" id="meta-sessions"></span>
          <span class="chevron">▾</span>
        </div>
      </div>
      <div class="section-body">
        <div class="btn-row">
          <button class="btn btn-ghost" onclick="loadSessions()">Decode Current Session</button>
        </div>
        <div id="sessions-current" style="margin-top:0.75rem;"></div>
        <div class="sub-section" style="margin-top:1.5rem;">
          <div class="sub-section-title">Query Sessions by Email</div>
          <div class="form-group" style="display:flex;gap:0.5rem;align-items:center;">
            <input type="email" class="form-input" id="session-email" placeholder="user@example.com" style="max-width:280px;">
            <button class="btn btn-ghost" onclick="querySessionsByEmail()">Look Up</button>
          </div>
          <div id="sessions-by-email" style="margin-top:0.75rem;"></div>
        </div>
        <div style="margin-top:0.75rem;">
          <span class="badge badge-muted">TTL</span>
          <span style="font-size:0.8rem;color:var(--muted);margin-left:0.5rem;">30 days, secure, sameSite=lax, httpOnly</span>
        </div>
      </div>
    </div>

    <!-- ── Section 5: Stripe / Payments ───────────────────────── -->
    <div class="section-card" id="sec-stripe">
      <div class="section-header" onclick="toggleSection('sec-stripe')">
        <div style="display:flex;align-items:center;gap:0.6rem;">
          <span class="status-dot" id="dot-stripe"></span>
          <span class="section-title"><span class="icon">💳</span> Stripe / Payments</span>
        </div>
        <div style="display:flex;align-items:center;gap:1rem;">
          <span class="section-meta" id="meta-stripe"></span>
          <span class="chevron">▾</span>
        </div>
      </div>
      <div class="section-body">
        <div class="btn-row">
          <button class="btn btn-ghost" onclick="loadStripeStatus()">Check Stripe Status</button>
        </div>
        <div id="stripe-results"></div>
      </div>
    </div>

    <!-- ── Section 6: Database Records ─────────────────────────── -->
    <div class="section-card" id="sec-db">
      <div class="section-header" onclick="toggleSection('sec-db')">
        <div style="display:flex;align-items:center;gap:0.6rem;">
          <span class="status-dot" id="dot-db"></span>
          <span class="section-title"><span class="icon">🗄️</span> Database Records</span>
        </div>
        <div style="display:flex;align-items:center;gap:1rem;">
          <span class="section-meta" id="meta-db"></span>
          <span class="chevron">▾</span>
        </div>
      </div>
      <div class="section-body">
        <div class="btn-row">
          <button class="btn btn-ghost" onclick="loadTables()">Load Tables</button>
        </div>
        <div id="db-browser-controls" style="margin-top:1rem;"></div>
        <div id="db-results" style="margin-top:0.75rem;"></div>
      </div>
    </div>

    <!-- ── Section 7: Email Diagnostics ────────────────────────── -->
    <div class="section-card" id="sec-email">
      <div class="section-header" onclick="toggleSection('sec-email')">
        <div style="display:flex;align-items:center;gap:0.6rem;">
          <span class="status-dot" id="dot-email"></span>
          <span class="section-title"><span class="icon">📧</span> Email Diagnostics</span>
        </div>
        <div style="display:flex;align-items:center;gap:1rem;">
          <span class="section-meta" id="meta-email"></span>
          <span class="chevron">▾</span>
        </div>
      </div>
      <div class="section-body">
        <div class="form-group">
          <label class="form-label">Send Test Email To</label>
          <div style="display:flex;gap:0.5rem;">
            <input type="email" class="form-input" id="email-test-to" placeholder="you@example.com" style="flex:1;">
            <button class="btn btn-primary" onclick="testEmail()">Send</button>
          </div>
        </div>
        <div id="email-result" style="margin-top:0.75rem;"></div>
      </div>
    </div>

    <!-- ── Section 8: Admin Action Logs ────────────────────────── -->
    <div class="section-card" id="sec-logs">
      <div class="section-header" onclick="toggleSection('sec-logs')">
        <div style="display:flex;align-items:center;gap:0.6rem;">
          <span class="status-dot" id="dot-logs"></span>
          <span class="section-title"><span class="icon">📋</span> Admin Action Logs</span>
        </div>
        <div style="display:flex;align-items:center;gap:1rem;">
          <span class="section-meta" id="meta-logs"></span>
          <span class="chevron">▾</span>
        </div>
      </div>
      <div class="section-body">
        <div class="btn-row">
          <button class="btn btn-ghost" onclick="loadAdminLogs()">Load Recent Logs</button>
        </div>
        <div id="admin-logs-results"></div>
      </div>
    </div>

    <!-- ── Section 9: Webhooks ──────────────────────────────────── -->
    <div class="section-card" id="sec-webhooks">
      <div class="section-header" onclick="toggleSection('sec-webhooks')">
        <div style="display:flex;align-items:center;gap:0.6rem;">
          <span class="status-dot" id="dot-webhooks"></span>
          <span class="section-title"><span class="icon">🔔</span> Webhooks</span>
        </div>
        <div style="display:flex;align-items:center;gap:1rem;">
          <span class="section-meta" id="meta-webhooks"></span>
          <span class="chevron">▾</span>
        </div>
      </div>
      <div class="section-body">
        <div class="btn-row">
          <button class="btn btn-ghost" onclick="loadWebhooks()">Load Recent Webhooks</button>
        </div>
        <div id="webhooks-results"></div>
      </div>
    </div>

    <!-- ── Section 10: Error Logs ─────────────────────────────────── -->
    <div class="section-card" id="sec-errors">
      <div class="section-header" onclick="toggleSection('sec-errors')">
        <div style="display:flex;align-items:center;gap:0.6rem;">
          <span class="status-dot" id="dot-errors"></span>
          <span class="section-title"><span class="icon">🚨</span> Error Logs</span>
        </div>
        <div style="display:flex;align-items:center;gap:1rem;">
          <span class="section-meta" id="meta-errors"></span>
          <span class="chevron">▾</span>
        </div>
      </div>
      <div class="section-body">
        <div class="btn-row">
          <button class="btn btn-ghost" onclick="loadErrorLogs()">Load Error Logs</button>
        </div>
        <div id="error-logs-results" style="margin-top:0.75rem;"></div>
      </div>
    </div>

    <!-- ── Section 10: Cache ────────────────────────────────────── -->
    <div class="section-card" id="sec-cache">
      <div class="section-header" onclick="toggleSection('sec-cache')">
        <div style="display:flex;align-items:center;gap:0.6rem;">
          <span class="status-dot pass" id="dot-cache"></span>
          <span class="section-title"><span class="icon">⚡</span> Cache</span>
        </div>
        <div style="display:flex;align-items:center;gap:1rem;">
          <span class="section-meta" id="meta-cache">No external cache</span>
          <span class="chevron">▾</span>
        </div>
      </div>
      <div class="section-body">
        <p style="font-size:0.8rem;color:var(--muted);margin-bottom:0.75rem;">No Redis or external cache currently in use. In-memory caches would be flushed here.</p>
        <button class="btn btn-danger" onclick="flushCache()">Flush All Caches</button>
        <div id="cache-result" style="margin-top:0.75rem;"></div>
      </div>
    </div>
  </div>

  <script>
    const pw = localStorage.getItem('debug_pw') || '';
    function getHeaders() { return { 'x-debug-password': pw }; }

    function show(id, html) {
      const el = document.getElementById(id);
      if (el) el.innerHTML = html;
    }

    function setSectionStatus(id, status, meta) {
      const dot = document.getElementById('dot-' + id);
      const metaEl = document.getElementById('meta-' + id);
      if (dot) dot.className = 'status-dot ' + status;
      if (metaEl && meta) metaEl.textContent = meta;
    }

    async function apiCall(path, method, body) {
      const res = await fetch(path, {
        method,
        headers: { 'Content-Type': 'application/json', ...getHeaders() },
        body: body ? JSON.stringify(body) : undefined,
      });
      return res.json();
    }

    function toggleSection(id) {
      const card = document.getElementById(id);
      card.classList.toggle('open');
    }

    // ── Database Health ───────────────────────────────────────
    async function runSupabaseCheck() {
      show('supabase-results', '<div class="state-msg"><span class="spinner"></span>Running checks...</div>');
      try {
        const data = await apiCall('/admin/debug/api/supabase', 'POST');
        const passed = data.checks.filter(c => c.status === 'pass').length;
        const failed = data.checks.filter(c => c.status === 'fail').length;
        setSectionStatus('supabase', failed > 0 ? 'fail' : 'pass', `${passed} pass, ${failed} fail`);
        let html = '<table class="debug-table" style="margin-top:0.75rem;"><tr><th>Check</th><th>Status</th><th>Latency</th><th>Detail / Error</th></tr>';
        for (const c of data.checks) {
          const cls = c.status === 'pass' ? 'badge-pass' : c.status === 'warn' ? 'badge-warn' : 'badge-fail';
          const detail = c.error || (c.detail ? JSON.stringify(c.detail) : '');
          html += `<tr>
            <td class="mono">${c.name}</td>
            <td><span class="badge ${cls}">${c.status.toUpperCase()}</span></td>
            <td class="mono" style="color:var(--muted-2)">${c.latency_ms}ms</td>
            <td class="mono" style="font-size:0.72rem;color:var(--muted);max-width:400px;word-break:break-all;">${detail || '—'}</td>
          </tr>`;
        }
        html += '</table>';
        show('supabase-results', html);
      } catch(e) {
        show('supabase-results', `<div style="color:#ef4444;font-size:0.82rem;">Error: ${e.message}</div>`);
      }
    }

    // ── Tables ──────────────────────────────────────────────────
    async function loadTables() {
      show('tables-results', '<div class="state-msg"><span class="spinner"></span>Loading...</div>');
      try {
        const data = await apiCall('/admin/debug/api/tables', 'POST');
        if (!data.tables || data.tables.length === 0) {
          show('tables-results', '<div class="state-msg">No tables found</div>');
          return;
        }
        let html = '<table class="debug-table" style="margin-top:0.75rem;"><tr><th>Table</th><th>Rows (est)</th><th>Dead Tuples</th></tr>';
        for (const t of data.tables) {
          html += `<tr>
            <td class="mono" style="color:var(--accent)">${t.table_name}</td>
            <td class="mono">${t.row_count_estimate ?? '?'}</td>
            <td class="mono" style="color:${t.dead_tuples > 10 ? '#ef4444' : 'var(--muted-2)'}">${t.dead_tuples ?? 0}</td>
          </tr>`;
        }
        html += '</table>';
        show('tables-results', html);
        setSectionStatus('supabase', 'pass', `${data.tables.length} tables`);
        // Also populate db-browser controls
        populateDbControls(data.tables.map(t => t.table_name));
      } catch(e) {
        show('tables-results', `<div style="color:#ef4444;font-size:0.82rem;">${e.message}</div>`);
      }
    }

    function populateDbControls(tables) {
      const tables2 = tables.sort();
      const controls = `
        <div style="display:flex;gap:0.75rem;align-items:center;flex-wrap:wrap;">
          <select class="form-select" id="db-table-select" style="max-width:240px;" onchange="loadTableRows()">
            <option value="">— select table —</option>
            ${tables2.map(t => `<option value="${t}">${t}</option>`).join('')}
          </select>
          <button class="btn btn-ghost" onclick="loadTableRows()">Browse</button>
          <button class="btn btn-primary" onclick="showCreateForm()">+ Create Row</button>
        </div>`;
      document.getElementById('db-browser-controls').innerHTML = controls;
    }

    let currentTablePage = 1;
    async function loadTableRows(tableOverride) {
      const table = tableOverride || document.getElementById('db-table-select')?.value;
      if (!table) return;
      setSectionStatus('db', 'pass', `browsing: ${table}`);
      const page = currentTablePage;
      show('db-results', '<div class="state-msg"><span class="spinner"></span>Loading rows...</div>');
      try {
        const data = await apiCall('/admin/debug/api/table-rows', 'POST', { table, page, pageSize: 50 });
        if (!data.rows || data.rows.length === 0) {
          show('db-results', '<div class="state-msg">No rows</div>');
          return;
        }
        const cols = Object.keys(data.rows[0]);
        const rows = data.rows;
        let html = `<div style="margin-bottom:0.5rem;font-size:0.75rem;color:var(--muted);">${data.total} rows total — page ${data.page}</div>`;
        html += '<div style="overflow-x:auto;"><table class="debug-table"><thead><tr>';
        html += '<th>#</th>';
        for (const c of cols) html += `<th>${c}</th>`;
        html += '<th>Actions</th></tr></thead><tbody>';
        rows.forEach((row, i) => {
          const pkCol = cols[0]; // assume first col is PK
          html += '<tr>';
          html += `<td class="mono" style="color:var(--muted-2)">${(page-1)*50 + i+1}</td>`;
          for (const c of cols) {
            let val = row[c];
            if (val === null) val = '<span style="color:var(--muted-2)">null</span>';
            else if (typeof val === 'object') val = JSON.stringify(val).slice(0,80);
            else val = String(val).slice(0,120);
            html += `<td class="mono" style="font-size:0.72rem;max-width:200px;word-break:break-all;">${val}</td>`;
          }
          html += `<td class="row-actions">
            <button class="btn btn-ghost" style="font-size:0.7rem;padding:0.2rem 0.5rem;" onclick="editRow('${table}','${pkCol}','${row[pkCol]}')">Edit</button>
            <form onsubmit="return confirm('Delete this row?')" action="javascript:deleteRow('${table}','${pkCol}','${row[pkCol]}')">
              <button class="btn btn-danger" type="submit">Delete</button>
            </form>
          </td>`;
          html += '</tr>';
        });
        html += '</tbody></table></div>';

        const totalPages = Math.ceil(data.total / data.pageSize);
        let pagHtml = '<div class="pagination">';
        pagHtml += `<button class="page-btn" ${page <= 1 ? 'disabled' : ''} onclick="currentTablePage=${page-1};loadTableRows('${table}')">Prev</button>`;
        pagHtml += `<span style="font-size:0.75rem;color:var(--muted);padding:0 0.5rem;">${page} / ${totalPages}</span>`;
        pagHtml += `<button class="page-btn" ${page >= totalPages ? 'disabled' : ''} onclick="currentTablePage=${page+1};loadTableRows('${table}')">Next</button>`;
        pagHtml += '</div>';

        show('db-results', html + pagHtml);
      } catch(e) {
        show('db-results', `<div style="color:#ef4444;font-size:0.82rem;">${e.message}</div>`);
      }
    }

    async function deleteRow(table, pkField, pkValue) {
      try {
        const data = await apiCall('/admin/debug/api/row-delete', 'POST', { table, pkField, pkValue });
        if (data.deleted) {
          show('db-results', `<div style="color:#22c55e;font-size:0.82rem;margin-bottom:0.5rem;">✓ Deleted ${data.deleted.length} row(s). Refreshing...</div>`);
          setTimeout(() => loadTableRows(table), 800);
        } else {
          alert('Delete failed: ' + (data.error || 'unknown error'));
        }
      } catch(e) { alert(e.message); }
    }

    // ── SQL Runner ──────────────────────────────────────────────
    async function runSql() {
      const sql = document.getElementById('sql-input').value.trim();
      if (!sql) return;
      const writeMode = document.getElementById('sql-write-mode').checked;
      const out = document.getElementById('sql-output');
      out.style.display = 'block';
      out.innerHTML = '<span class="spinner"></span> Running...';
      try {
        const data = await apiCall('/admin/debug/api/sql', 'POST', { sql, writeMode });
        if (data.error) {
          out.innerHTML = `<span style="color:#ef4444">ERROR: ${data.error}</span>`;
        } else {
          const preview = JSON.stringify({ rows: data.rows, fields: data.fields, duration_ms: data.duration_ms }, null, 2);
          out.innerHTML = `<span style="color:#22c55e">OK — ${data.rows.length} rows in ${data.duration_ms}ms</span>\n\n${preview.slice(0, 2000)}${preview.length > 2000 ? '\n... (truncated)' : ''}`;
        }
      } catch(e) {
        out.innerHTML = `<span style="color:#ef4444">${e.message}</span>`;
      }
    }

    // ── Env ─────────────────────────────────────────────────────
    async function loadEnv() {
      show('env-results', '<div class="state-msg"><span class="spinner"></span>Loading...</div>');
