<!-- PWA: inject head tags from body (manifest must be loaded before SW) -->
<link rel="manifest" href="/manifest.json">
<meta name="theme-color" content="#f97316">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<link rel="apple-touch-icon" href="/images/apple-touch-icon.svg">

<nav class="nav">
  <div class="nav-inner">
    <a href="/" class="nav-logo">
      <img src="https://cdn.discordapp.com/icons/1160158300168527895/5a9f9fdccd5b590d4c3a0a5bb233441d.webp?size=1024" alt="WAGE Society" class="nav-logo-icon" width="28" height="28" style="border-radius:6px;" />
      WAGE SOCIETY
    </a>
    <div class="nav-links">
      <a href="/creators">Directory</a>
      <a href="/marketplace">Marketplace</a>
      <a href="/streams">Streams</a>
      <a href="/leaderboard">Leaderboard</a>
      <a href="/memberships">Pricing</a>
      <a href="/news">Blog</a>
    </div>
    <div class="nav-auth">
      <button class="nav-search-btn" id="searchOpenBtn" aria-label="Search (⌘K)">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/>
        </svg>
      </button>
      <% if (typeof session !== 'undefined' && session.userEmail) { %>
        <% if (typeof currentUserAvatar !== 'undefined' && currentUserAvatar) { %>
          <a href="/dashboard" style="width:32px;height:32px;border-radius:50%;overflow:hidden;display:inline-block;border:2px solid rgba(255,102,0,0.4);flex-shrink:0;" title="Go to Dashboard">
            <img src="<%= currentUserAvatar %>" alt="avatar" style="width:100%;height:100%;object-fit:cover;" onerror="this.parentElement.style.display='none'" />
          </a>
        <% } %>
        <a href="/dashboard" class="nav-btn nav-btn-outline">Dashboard</a>
        <form action="/logout" method="POST" style="display:inline">
          <button type="submit" class="nav-btn nav-btn-outline">Logout</button>
        </form>
      <% } else { %>
        <a href="/login" class="nav-btn nav-btn-join">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <circle cx="12" cy="7" r="4"/><path d="M5.5 21a6.5 6.5 0 0 1 13 0"/>
          </svg>
          Login &nbsp;›
        </a>
      <% } %>
    </div>
    <!-- Mobile hamburger button -->
    <button class="nav-hamburger" aria-label="Menu" onclick="document.querySelector('.nav-mobile-overlay').classList.toggle('open')">
      <span></span><span></span><span></span>
    </button>
  </div>
  <!-- Mobile menu overlay -->
  <div class="nav-mobile-overlay">
    <button class="nav-mobile-close" aria-label="Close menu" onclick="this.parentElement.classList.remove('open')">✕</button>
    <div class="nav-mobile-links">
      <a href="/creators">Directory</a>
      <a href="/marketplace">Marketplace</a>
      <a href="/streams">Streams</a>
      <a href="/leaderboard">Leaderboard</a>
      <a href="/memberships">Pricing</a>
      <a href="/news">Blog</a>
    </div>
    <div class="nav-mobile-cta">
      <% if (typeof session !== 'undefined' && session.userEmail) { %>
        <a href="/dashboard" class="nav-btn nav-btn-join" style="width:100%;text-align:center;">Dashboard</a>
      <% } else { %>
        <a href="/login" class="nav-btn nav-btn-join" style="width:100%;text-align:center;">Login ›</a>
      <% } %>
    </div>
  </div>
</nav>

<!-- Mobile bottom nav (visible only on mobile) -->
<nav class="mobile-bottom-nav" aria-label="Mobile navigation">
  <div class="mobile-bottom-nav-inner">
    <a href="/dashboard" aria-label="Dashboard">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/>
      </svg>
      Dashboard
    </a>
    <a href="/creators" aria-label="Creators">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
      </svg>
      Creators
    </a>
    <a href="/marketplace" aria-label="Marketplace">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
      </svg>
      Shop
    </a>
    <a href="/streams" aria-label="Streams">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/>
      </svg>
      Streams
    </a>
    <a href="/settings" aria-label="Profile">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>
      </svg>
      Settings
    </a>
  </div>
</nav>

<!-- PWA Service Worker Registration -->
<script>
if ('serviceWorker' in navigator) {
  window.addEventListener('load', function() {
    navigator.serviceWorker.register('/sw.js').then(function(reg) {
      // SW registered
    }).catch(function(err) {
      // SW registration failed — non-critical
    });
  });
}
</script>

<!-- Search Overlay -->
<div id="searchOverlay" class="search-overlay" aria-modal="true" role="dialog" aria-label="Site search">
  <div class="search-backdrop" id="searchBackdrop"></div>
  <div class="search-modal">
    <div class="search-header">
      <div class="search-input-wrap">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="search-icon">
          <circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/>
        </svg>
        <input
          id="searchInput"
          type="text"
          class="search-input"
          placeholder="Search members, pages, content..."
          autocomplete="off"
          autocorrect="off"
          spellcheck="false"
        />
        <kbd class="search-esc" id="searchEsc">ESC</kbd>
      </div>
    </div>
    <div id="searchResults" class="search-results"></div>
  </div>
</div>
